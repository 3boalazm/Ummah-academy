+
+/** State of both placements: the floating pill (desktop) and the row in the mobile sheet. */
+const pillState = () => {
+  const roots = [...document.querySelectorAll('[data-install]')];
+  const pick = (v) => roots.find((r) => r.dataset.installVariant === v) ?? roots[0];
