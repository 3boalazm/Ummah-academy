+
+/* ==========================================================================
+   Dark theme overrides
+   Anything above that hard-codes a light surface (frosted whites, ink-tinted
+   hairlines, white input fields) gets its dark twin here. Unlayered on
+   purpose: it has to beat the `components` layer, and `:not(.theme-night *)`
+   keeps the night sections — already dark — exactly as they are.
+   ========================================================================== */
+
+[data-theme='dark'] ::selection {
+  background: rgb(185 140 232 / 0.4);
+}
+
+[data-theme='dark'] .skip-link {
+  background: var(--accent);
+  color: #1a1026;
+}
+
+/* Aurora: the dawn wash becomes a night sky with the same three glows */
+[data-theme='dark'] .aurora {
+  background: var(--grad-dawn);
+}
+
+[data-theme='dark'] .aurora__blob--1 {
+  background: radial-gradient(closest-side, rgb(107 63 160 / 0.34), rgb(107 63 160 / 0) 72%);
+}
+
+[data-theme='dark'] .aurora__blob--2 {
+  background: radial-gradient(closest-side, rgb(29 95 168 / 0.3), rgb(29 95 168 / 0) 72%);
+}
+
+[data-theme='dark'] .aurora__blob--3 {
+  background: radial-gradient(closest-side, rgb(143 47 158 / 0.22), rgb(143 47 158 / 0) 72%);
+}
+
+[data-theme='dark'] .aurora__blob--4 {
+  background: radial-gradient(closest-side, rgb(200 123 128 / 0.11), rgb(200 123 128 / 0) 72%);
+}
+
+[data-theme='dark'] .aurora__grain {
+  opacity: 0.05;
+}
+
+/* Specular sheen: a hint of light instead of a white wash */
+[data-theme='dark'] .glass:not(.theme-night *)::after {
+  background: radial-gradient(120% 70% at 0% 0%, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0) 52%);
+}
+
+[data-theme='dark'] .eyebrow:not(.theme-night *) {
+  background: rgb(255 255 255 / 0.08);
+  box-shadow:
+    inset 0 0 0 1px rgb(255 255 255 / 0.16),
+    0 0 0 1px rgb(0 0 0 / 0.25);
+}
+
+[data-theme='dark'] .btn--glass:not(.theme-night *) {
+  background: rgb(255 255 255 / 0.09);
+  box-shadow:
+    inset 0 1px 0 rgb(255 255 255 / 0.18),
+    0 0 0 1px rgb(255 255 255 / 0.12),
+    0 10px 24px -14px rgb(0 0 0 / 0.7);
+}
+
+[data-theme='dark'] .btn--glass:not(.theme-night *):hover {
+  background: rgb(255 255 255 / 0.15);
+}
+
+/* Primary CTA: on a dark page the deep-aubergine pill would sink into the
+   background, so it takes the night-section treatment — bright, dark label. */
+[data-theme='dark'] .btn--primary:not(.theme-night *) {
+  color: #241436;
+  background:
+    radial-gradient(130% 160% at 28% -10%, rgb(255 255 255 / 0.5), rgb(255 255 255 / 0) 46%),
+    linear-gradient(160deg, #f2e7ff 0%, #d9c4f5 55%, #c3aef0 100%);
+  box-shadow:
+    inset 0 1px 0 rgb(255 255 255 / 0.85),
+    inset 0 -1px 0 rgb(90 60 130 / 0.25),
+    0 0 0 1px rgb(255 255 255 / 0.35),
+    0 12px 26px -12px rgb(0 0 0 / 0.8);
+}
+
+[data-theme='dark'] .btn--primary:not(.theme-night *):hover {
+  box-shadow:
+    inset 0 1px 0 rgb(255 255 255 / 0.9),
+    inset 0 -1px 0 rgb(90 60 130 / 0.25),
+    0 0 0 1px rgb(255 255 255 / 0.45),
+    0 18px 36px -14px rgb(185 140 232 / 0.45),
+    0 0 0 6px rgb(185 140 232 / 0.16);
+}
+
+/* Chips sit over illustrations and over the aurora: at 8% white the artwork showed through and
+   took the label with it (measured 2.9:1 on the teachers hero), so they carry their own fill. */
+[data-theme='dark'] .chip:not(.theme-night *) {
+  background: rgb(28 20 44 / 0.78);
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
+}
+
+[data-theme='dark'] .chip--accent:not(.theme-night *) {
+  color: var(--accent-ink);
+  background: rgb(58 34 92 / 0.9);
+  box-shadow: inset 0 0 0 1px rgb(206 165 255 / 0.3);
+}
+
+/* A comparison table is read line by line, so its panel takes the calm near-opaque surface in
+   dark mode rather than letting the aurora drift behind the rows (a header cell measured 3.8:1
+   over the brightest spot). */
+[data-theme='dark'] .table-wrap.glass {
+  background: var(--glass-fill-strong);
+}
+
+/* Panels that float over a pastel illustration (About's stat cards, the teachers badges, the
+   home hero cards, a profile's "verified" seal): the thin glass fill let the artwork through and
+   the text measured 1.9–2.9:1 on it. In dark mode they take the near-opaque fill instead — the
+   same treatment the sticky bar and the mobile sheet already use. */
+[data-theme='dark'] :is(.a-card, .t-badge, .hero__card, .hero__verified, .tprof__verified) {
+  background: var(--glass-fill-strong);
+}
+
+[data-theme='dark'] .icon-badge:not(.theme-night *) {
+  color: #e6d2ff;
+  background: linear-gradient(150deg, rgb(255 255 255 / 0.16), rgb(185 140 232 / 0.1));
+  box-shadow:
+    inset 0 1px 0 rgb(255 255 255 / 0.22),
+    0 0 0 1px rgb(255 255 255 / 0.12),
+    0 10px 22px -12px rgb(0 0 0 / 0.8);
+}
+
+/* Accordion marker: light plus on a dark disc (the icon is an inline data URI) */
+[data-theme='dark'] .faq summary::after {
+  background:
+    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23e8def8' stroke-width='2' stroke-linecap='round'><path d='M12 6v12M6 12h12'/></svg>")
+      center / 16px no-repeat,
+    rgb(255 255 255 / 0.12);
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
+}
+
+/* Form controls: dark fields, light caret/arrow, visible focus ring */
+[data-theme='dark'] :is(.input, .select, .textarea) {
+  border-color: rgb(255 255 255 / 0.18);
+  background: rgb(255 255 255 / 0.07);
+  box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.35);
+}
+
+[data-theme='dark'] .select {
+  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23cec5e0' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M6 9l6 6 6-6'/></svg>");
+}
+
+[data-theme='dark'] :is(.input, .select, .textarea):hover {
+  border-color: rgb(255 255 255 / 0.3);
+}
+
+[data-theme='dark'] :is(.input, .select, .textarea):focus-visible {
+  border-color: var(--accent);
+  background: rgb(255 255 255 / 0.1);
+  box-shadow: 0 0 0 4px rgb(185 140 232 / 0.28);
+}
+
+[data-theme='dark'] .field[data-invalid] :is(.input, .select, .textarea) {
+  border-color: var(--danger);
+  box-shadow: 0 0 0 4px rgb(255 157 148 / 0.16);
+}
+
+/* Chrome paints autofilled fields pale yellow with black text — unreadable here */
+[data-theme='dark'] :is(.input, .select, .textarea):-webkit-autofill {
+  -webkit-text-fill-color: var(--ink);
+  -webkit-box-shadow: 0 0 0 1000px #2a1f3d inset;
+  caret-color: var(--ink);
+}
+
+[data-theme='dark'] .choice__box {
+  background: rgb(255 255 255 / 0.07);
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.13);
+}
+
+[data-theme='dark'] .choice input:hover + .choice__box {
+  background: rgb(255 255 255 / 0.12);
+}
+
+[data-theme='dark'] .choice input:checked + .choice__box {
+  background: rgb(185 140 232 / 0.16);
+  box-shadow:
+    inset 0 0 0 2px var(--accent),
+    0 10px 24px -14px rgb(0 0 0 / 0.8);
+}
+
+[data-theme='dark'] .seg__opt span {
+  background: rgb(255 255 255 / 0.07);
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.13);
+}
+
+[data-theme='dark'] .seg__opt input:checked + span {
+  color: #fff;
+  background: var(--violet-600);
+  box-shadow: 0 8px 18px -10px rgb(0 0 0 / 0.9);
+}
+
+[data-theme='dark'] .hero-stats li {
+  background: rgb(255 255 255 / 0.08);
+  box-shadow:
+    inset 0 0 0 1px rgb(255 255 255 / 0.14),
+    0 0 0 1px rgb(0 0 0 / 0.25);
+}
+
+[data-theme='dark'] .step__num:not(.theme-night *) {
+  color: rgb(201 160 255 / 0.34);
+}
+
+[data-theme='dark'] .frame {
+  background: #241a34;
+}
+
+/* Prose: quotes, tables and rules sit on dark glass */
+[data-theme='dark'] .prose blockquote {
+  background: rgb(255 255 255 / 0.06);
+}
+
+[data-theme='dark'] .prose hr {
+  background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.2), transparent);
+}
+
+[data-theme='dark'] :is(.prose .table-wrap, .prose table) {
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
+  background: rgb(255 255 255 / 0.05);
+}
+
+[data-theme='dark'] .prose :is(th, td) {
+  border-bottom-color: rgb(255 255 255 / 0.1);
+}
+
+[data-theme='dark'] .prose th {
+  background: rgb(255 255 255 / 0.09);
+}
+
+/* Reduced transparency: the opaque fallback has to be dark too */
+@media (prefers-reduced-transparency: reduce) {
+  [data-theme='dark'] :is(.glass, .btn--glass, .eyebrow) {
+    background: #241a34;
+  }
+}
+
+@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
+  [data-theme='dark'] .glass {
+    background: rgb(28 20 42 / 0.96);
+  }
+}
