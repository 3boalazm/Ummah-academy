+    /* 5 · back online */
+    await page.setOfflineMode(false);
+    const fresh = await page.goto(base + '/', { waitUntil: 'load' }).catch(() => null);
+    checked += 1;
+    if (!fresh || !fresh.ok()) failures.push({ page: '/ (back online)', detail: 'the site did not recover after the network came back' });
