+      await page.keyboard.press('Enter');
+      if (!(await page.evaluate(() => document.querySelector('[data-langmenu]')?.open))) failures.push({ page: '/', detail: 'Enter does not open the language menu' });
+      await page.keyboard.press('Escape');
