# Optional: receive trial requests as JSON (Apps Script / Zapier / CRM)
PUBLIC_LEAD_ENDPOINT=
# Student / family portal base URL (WordPress today; move to a sub-domain before cut-over)
PUBLIC_PORTAL_URL=https://ummahacademy.net
# Analytics — leave empty to ship no analytics at all.
# Plausible: cookieless, no consent banner. Optional custom script (self-hosted proxy,
# or https://plausible.io/js/script.file-downloads.outbound-links.js for PDF/outbound tracking).
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=
# Google Tag Manager (GA4 etc.): Consent Mode v2, loads only after the visitor clicks "Allow".
# Setting this also shows the consent banner and a "Privacy choices" footer link.
PUBLIC_GTM_ID=
# Search engines (optional — DNS verification is preferred, see docs/15-search-launch-runbook.md).
# Paste only the token from the meta tag Google / Bing give you; it is added to the home page.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
# Real-user performance (Core Web Vitals) → the academy portal. Off when empty: the build ships nothing extra.
# Cookieless and anonymous: path, language, device class and five numbers. See docs/40-profiles-and-performance.md.
PUBLIC_RUM_ENDPOINT=
PUBLIC_RUM_SAMPLE=1
