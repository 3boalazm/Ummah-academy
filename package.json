{
  "name": "ummah-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ummah Academy — native website (Astro). Live 1-on-1 Qur'an, Arabic & Islamic Studies with Al-Azhar scholars.",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm run check:links && npm run check:i18n && npm run check:jsonld",
    "qa": "npm run build && npm run verify && npm run check:cards",
    "pdfs": "node scripts/build-pdfs.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs",
    "check:cards": "node scripts/check-cards.mjs",
    "qa:browser": "node qa/run.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^7.3.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "puppeteer-core": "^25.14.0"
  }
}
