---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import { portalLinks, waLink } from '@/data/site';

const features = [
  { icon: 'users-three', title: 'Unified Family Account', text: 'One login — switch between children’s profiles with a single tap.', soon: false },
  { icon: 'chart-bar', title: 'Live Progress Dashboard', text: 'Visual progress bars, milestones, and performance charts for every child.', soon: true },
  { icon: 'clipboard-text', title: 'Post-Session Reports', text: 'Detailed teacher report after every session with homework and next steps.', soon: false },
  { icon: 'film-strip', title: 'Recording Library', text: 'Every session auto-recorded. Review any class at any time.', soon: true },
  { icon: 'bell-ringing', title: 'WhatsApp Alerts', text: 'Session reminders, report notifications, and renewal alerts.', soon: false },
  { icon: 'credit-card', title: 'Unified Billing', text: 'Manage all children’s subscriptions from one dashboard.', soon: true },
];
---

<BaseLayout title="Family Portal | Manage Your Family's Classes | Ummah Academy" description="One account for the whole family: switch between children, read post-session reports, get WhatsApp alerts — with dashboards, recordings and unified billing coming soon.">
  <PageHero
    eyebrow="Family Portal"
    eyebrowAr="بوابة الأسرة"
    title='Manage Your Family’s <span class="accent">Deen</span> in One Place'
    lede="One unified account for your entire family — track progress, access recordings, receive reports, and manage billing."
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href={portalLinks.register}>Create Family Account Free <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
      <a class="btn btn--glass" href={portalLinks.login}>Sign In to Portal</a>
    </Fragment>
    <Fragment slot="visual">
      <div class="portal glass glass--strong" role="img" aria-label="Preview of the Family Portal dashboard">
        <div class="portal__head">
          <span class="portal__avatar">AR</span>
          <span><small>Ummah Academy</small><strong>Ahmad Al-Rashid</strong></span>
        </div>
        <p class="portal__label">My Children</p>
        <div class="portal__kids">
          <span class="portal__kid is-active"><b>O</b>Omar<small>Tajweed L2</small></span>
          <span class="portal__kid"><b>S</b>Sara<small>Noor Al-Bayan</small></span>
          <span class="portal__kid"><b>K</b>Khalid<small>Ummah Cubs</small></span>
        </div>
        <div class="portal__next">
          <p class="portal__label">Omar’s Next Session</p>
          <strong>Today · 10:00 AM BST</strong>
          <small>Teacher Omneya · Tajweed Level 2</small>
          <span class="btn btn--sm btn--primary portal__join"><Icon name="play" weight="fill" /> Join Session Room</span>
        </div>
        <div class="portal__progress">
          <span>Omar’s Progress</span><strong>65%</strong>
          <span class="portal__bar"><i style="width:65%"></i></span>
        </div>
        <ul role="list" class="portal__alerts">
          <li><Icon name="bell" weight="fill" /> Sara’s report is ready</li>
          <li><Icon name="calendar" weight="fill" /> Khalid’s session tomorrow 11 AM</li>
          <li><Icon name="credit-card" weight="fill" /> Subscription renews in 14 days</li>
        </ul>
      </div>
    </Fragment>
  </PageHero>

  <section class="section" aria-labelledby="pf-title">
    <div class="container">
      <SectionHead
        id="pf-title"
        eyebrow="Smart Features"
        eyebrowAr="مميزات ذكية"
        title='Everything a Parent Needs in <span class="accent">One Place</span>'
        sub="كل ما يحتاجه الوالد في مكان واحد"
        lede="Built for Muslim parents who want visibility, control, and peace of mind."
      />
      <ol role="list" class="grid grid-3 pf">
        {
          features.map((f, i) => (
            <li class="card glass" data-reveal style={`--reveal-delay:${i * 0.05}s`}>
              <div class="pf__top">
                <span class="icon-badge">
                  <Icon name={f.icon} />
                </span>
                <span class="pf__num">0{i + 1}</span>
              </div>
              <h3>
                {f.title} {f.soon && <span class="chip chip--accent">Coming soon</span>}
              </h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaPanel
    eyebrow="For Muslim families worldwide · للعائلات المسلمة حول العالم"
    title='Create Your Free <span class="accent">Family Account</span> Today'
    lede="Start with 2 free trials for each child. No payment required."
    primary={{ label: 'Create Family Account Free', href: portalLinks.register }}
    secondary={{ label: 'Ask on WhatsApp', href: waLink() }}
    ticks={[]}
  />
</BaseLayout>

<style>
  .portal {
    --radius: 30px;
    display: grid;
    gap: 14px;
    padding: 22px;
    max-width: 440px;
    margin-inline: auto;
  }

  .portal__head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .portal__head small {
    display: block;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .portal__avatar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #fff;
    font-weight: 650;
    font-size: 0.85rem;
    background: var(--grad-accent);
  }

  .portal__label {
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .portal__kids {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .portal__kid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 10px 6px;
    border-radius: 16px;
    font-weight: 600;
    font-size: 0.9rem;
    background: rgb(255 255 255 / 0.6);
    box-shadow: inset 0 0 0 1px rgb(46 29 70 / 0.06);
  }

  .portal__kid.is-active {
    box-shadow: inset 0 0 0 2px var(--violet-600);
    background: #fff;
  }

  .portal__kid b {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 0.8rem;
    color: var(--accent-ink);
    background: var(--blush-100);
  }

  .portal__kid small {
    font-weight: 450;
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .portal__next {
    display: grid;
    gap: 2px;
    padding: 16px;
    border-radius: 18px;
    background:
      radial-gradient(120% 100% at 100% 0%, rgb(175 204 234 / 0.6), transparent 60%),
      rgb(255 255 255 / 0.7);
  }

  .portal__next small {
    color: var(--ink-3);
  }

  .portal__join {
    margin-top: 10px;
    width: fit-content;
    pointer-events: none;
  }

  .portal__progress {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px;
    font-size: 0.88rem;
  }

  .portal__bar {
    grid-column: 1 / -1;
    height: 7px;
    border-radius: 99px;
    background: rgb(46 29 70 / 0.08);
    overflow: hidden;
  }

  .portal__bar i {
    display: block;
    height: 100%;
    background: var(--grad-accent);
  }

  .portal__alerts {
    display: grid;
    gap: 8px;
    font-size: 0.86rem;
    color: var(--ink-2);
  }

  .portal__alerts li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .portal__alerts :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--accent-ink);
  }

  .pf {
    list-style: none;
    padding: 0;
  }

  .pf__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pf__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 2rem;
    color: rgb(91 58 142 / 0.3);
  }

  .pf h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
</style>
