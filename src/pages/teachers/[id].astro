---
import TeacherProfile from '@/views/TeacherProfile.astro';
import { TEACHERS } from '@/data/people';
import { BILINGUAL_ROUTES } from '@/i18n';

export function getStaticPaths() {
  return TEACHERS.map((t) => {
    // Profiles must be registered as bilingual so hreflang + the language switch work.
    if (!(BILINGUAL_ROUTES as readonly string[]).includes(`/teachers/${t.id}/`)) throw new Error(`Add /teachers/${t.id}/ to BILINGUAL_ROUTES in src/i18n/index.ts`);
    return { params: { id: t.id } };
  });
}
const { id } = Astro.params;
---

<TeacherProfile id={id} lang="en" />
