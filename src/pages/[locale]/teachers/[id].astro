---
import TeacherProfile from '@/views/TeacherProfile.astro';
import { TEACHERS } from '@/data/people';
import { PREFIXED, TRANSLATED_ROUTES } from '@/i18n';

export function getStaticPaths() {
  return PREFIXED.flatMap((locale) =>
    TEACHERS.map((t) => {
      // Profiles must be registered as translated routes so hreflang + the language menu work.
      if (!(TRANSLATED_ROUTES as readonly string[]).includes(`/teachers/${t.id}/`)) throw new Error(`Add /teachers/${t.id}/ to TRANSLATED_ROUTES in src/i18n/index.ts`);
      return { params: { locale, id: t.id } };
    }),
  );
}
const { locale, id } = Astro.params;
---

<TeacherProfile id={id} lang={locale} />
