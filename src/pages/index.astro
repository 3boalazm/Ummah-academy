---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/SectionHead.astro';
import TrackCard from '@/components/TrackCard.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import ClassroomMockup from '@/components/ClassroomMockup.astro';
import Faq from '@/components/Faq.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import heroArt from '@/assets/art/hero-arch.jpg';
import { TRACKS } from '@/data/tracks';
import { TESTIMONIALS, HALL_OF_FAME } from '@/data/people';
import { waLink } from '@/data/site';

const why = [
  {
    icon: 'mosque',
    title: 'Azhari Excellence',
    ar: 'التميز الأزهري',
    text: 'All teachers are Al-Azhar University graduates with Ijazah certificates — a chain of knowledge connected directly to the Prophet ﷺ, ensuring authentic, verified transmission of Quranic sciences.',
    proof: 'Verified via Ijazah & Sanad check + a live teaching demo — see <a href="/teachers/#process">our vetting process</a>',
  },
  {
    icon: 'target',
    title: 'Itqan Methodology',
    ar: 'منهجية الإتقان',
    text: 'We focus on “Itqan” (perfection) and “Tadabbur” (deep contemplation) — not rote recitation. Every session is structured for lasting mastery through thematic verse grouping and precision correction.',
    proof: 'See <a href="/the-itqan-method-explained-how-thematic-memorization-makes-hifz-easier/">how the Itqan method actually works</a>',
  },
  {
    icon: 'shield-check',
    title: 'Safe Environment',
    ar: 'بيئة آمنة',
    text: 'Specialized female teachers for women and children in a fully private, faith-conscious setting. Complete parental oversight with session recordings, progress reports, and Family Portal access.',
    proof: 'Every session recorded, with progress reports in your Family Portal',
  },
  {
    icon: 'globe-hemisphere-west',
    title: '24/7 Flexibility',
    ar: 'مرونة على مدار الساعة',
    text: 'We serve Muslims across all timezones — UK, USA, Canada, Australia, and beyond. Choose your own schedule; we operate around the clock to accommodate every timezone and family routine.',
    proof: 'Real students in 50+ countries — see <a href="#stories">their stories</a>',
  },
];

const stats = [
  { num: '50+', label: 'Countries Reached', sub: 'Across 5 continents', ar: 'في ٥ قارات' },
  { num: '100+', label: 'Azhari Scholars', sub: 'Ijazah certified', ar: 'حاملين إجازة' },
  { num: '1,000+', label: 'Active Students', sub: 'Currently enrolled', ar: 'طالب مسجل حالياً' },
  { num: '400+', label: 'Monthly Hours', sub: 'Live sessions delivered', ar: 'ساعة تدريس شهرياً' },
  { num: '95%', label: 'Satisfaction Rate', sub: 'Verified parent reviews', ar: 'نسبة رضا أولياء الأمور' },
];

const classroom = [
  { icon: 'chalkboard-teacher', title: 'Interactive Smart Board', ar: 'سبورة ذكية تفاعلية', text: 'Real-time annotation and writing alongside the teacher — essential for Arabic letter practice and Tajweed marking.' },
  { icon: 'game-controller', title: 'Gamified Learning for Kids', ar: 'تعليم بالألعاب للأطفال', text: 'Children’s sessions include educational games, quizzes, and reward systems that make Quran learning genuinely fun.' },
  { icon: 'bell-ringing', title: 'Smart WhatsApp Reminders', ar: 'تذكيرات واتساب ذكية', text: 'Automatic reminders 15 minutes before each session and daily Hifz revision prompts sent to your WhatsApp.' },
];

const impact = [
  { num: '95%', label: 'Student Retention', sub: 'Continue after first paid month', ar: 'يستمرون بعد الشهر الأول' },
  { num: '85%', label: 'Parent Satisfaction', sub: 'Notable behavioral improvements', ar: 'تحسن سلوكي ملحوظ' },
  { num: '400+', label: 'Teaching Hours', sub: 'Live sessions delivered monthly', ar: 'ساعة تدريس مباشر شهرياً' },
  { num: '12+', label: 'Ijazahs Granted', sub: 'Full chain to Prophet ﷺ', ar: 'إجازة بسند متصل' },
];

const steps = [
  { icon: 'note-pencil', title: 'Register in 60s', ar: 'سجّل في ٦٠ ثانية', text: 'Fill a short form — your name, WhatsApp number, and the course you’re interested in. That’s it. No lengthy signups.' },
  { icon: 'graduation-cap', title: 'Free Assessment', ar: 'تقييم مجاني', text: 'A certified teacher evaluates your current level and creates a personalized study plan tailored to your specific goals.' },
  { icon: 'calendar-dots', title: 'Schedule Sessions', ar: 'حدد مواعيدك', text: 'Choose your preferred session times. We work around your timezone and daily routine. Available 24/7 for full flexibility.' },
  { icon: 'rocket-launch', title: 'Start & Track Growth', ar: 'ابدأ وتابع تقدمك', text: 'Begin live 1-on-1 classes. Receive detailed progress reports, access recordings, and earn certificates per level.' },
];

const compare = [
  ['Teaching Staff', 'Al-Azhar graduates with Ijazah — chain traced to Prophet ﷺ', 'Volunteers or uncertified teachers'],
  ['Session Format', '100% live 1-on-1 — complete focus & instant correction', 'Pre-recorded videos or large group classes'],
  ['Memorization Method', 'Itqan method — thematic grouping for deep Tadabbur', 'Quantity over quality — display memorization'],
  ['Arabic Teaching', 'Quranic Arabic linked to Al-Ajrumiyyah texts', 'General Arabic disconnected from religious texts'],
  ['Progress Tracking', 'Post-session reports + monthly summaries', 'No systematic follow-up'],
  ['Timezone Coverage', '24/7 scheduling for all global timezones', 'Fixed times that don’t fit Western schedules'],
  ['Certification', 'Official certificates + Ijazah with documented chain', 'No formal certification'],
  ['Non-Arabic Speakers', 'Bilingual teachers (Arabic + English)', 'Arabic-only explanations'],
];

const trust = [
  { icon: 'mosque', title: 'Al-Azhar University', text: 'All teachers are verified graduates', ar: 'جميع المعلمين خريجي الأزهر' },
  { icon: 'scroll', title: 'Ijazah Chain', text: 'Connected to Prophet Muhammad ﷺ', ar: 'سند متصل' },
  { icon: 'globe-hemisphere-east', title: 'ICESCO Aligned', text: 'International Islamic education standards' },
  { icon: 'lock-key', title: 'GDPR Compliant', text: 'Family-safe, privacy-first platform' },
];

const faqs = [
  {
    q: 'Are sessions live or pre-recorded?',
    qAr: 'هل الحصص مباشرة أم مسجلة؟',
    a: '100% live — every session is a personal 1-on-1 interaction with your certified teacher. No pre-recorded content whatsoever. This is essential for correctly fixing Makhraj (letter articulation points) in real time.',
    aAr: 'كل الحصص مباشرة ١٠٠٪ — تفاعل شخصي مع المعلم المعتمد. ضروري لتصحيح المخارج بشكل فوري.',
  },
  {
    q: 'Do you have female teachers for women & girls?',
    qAr: 'هل يوجد معلمات إناث للنساء والبنات؟',
    a: 'Yes. We have a dedicated team of certified female Azhari scholars specializing in teaching women and children, ensuring complete privacy and a fully faith-conscious environment with full parental oversight.',
    aAr: 'نعم — لدينا فريق متخصص من المعلمات الأزهريات المعتمدات لتعليم النساء والأطفال في بيئة إيمانية آمنة.',
  },
  {
    q: 'Do you issue completion certificates?',
    qAr: 'هل تصدرون شهادات إتمام؟',
    a: 'Yes — every student receives an official completion certificate from Ummah Academy upon finishing each level. Advanced students can pursue a formal Ijazah with a documented chain of transmission to the Prophet ﷺ.',
    aAr: 'نعم — كل طالب يحصل على شهادة رسمية عند إتمام كل مستوى. الطلاب المتقدمون يمكنهم الحصول على إجازة بسند متصل إلى النبي ﷺ.',
  },
  {
    q: 'What payment methods are accepted?',
    qAr: 'ما هي طرق الدفع المتاحة؟',
    a: 'We accept Visa, Mastercard, PayPal, bank transfers, Western Union, and MoneyGram — ensuring students in every country can pay easily and securely in their preferred method.',
    aAr: 'نقبل فيزا، ماستركارد، باي بال، تحويلات بنكية، ويسترن يونيون، وموني جرام — لنضمن سهولة الدفع من أي دولة.',
  },
  {
    q: 'What age do you start accepting children?',
    qAr: 'من أي عمر تقبلون الأطفال؟',
    a: 'We accept children from 5 years old through our Ummah Cubs program. Sessions are 30 minutes to match their attention span, using gamified visual teaching methods that make learning genuinely enjoyable.',
    aAr: 'نقبل الأطفال من عمر ٥ سنوات عبر برنامج أشبال الأمة. الحصص ٣٠ دقيقة بأسلوب تفاعلي ممتع يناسب انتباههم.',
  },
  {
    q: 'What if I don’t speak any Arabic?',
    qAr: 'ماذا لو لم أكن أتحدث العربية؟',
    a: 'No problem at all. Our teachers are fully bilingual (Arabic & English) and specialize in teaching non-Arabic speakers. Many of our highest-achieving students started with zero Arabic knowledge.',
    aAr: 'لا مشكلة إطلاقاً — معلمونا ثنائيو اللغة ومتخصصون في تعليم غير الناطقين بالعربية. كثير من أفضل طلابنا بدأوا من الصفر.',
  },
];

const trackAnchor: Record<string, string> = { quran: '#quran', arabic: '#arabic', kids: '#kids', islamic: '#islamic' };
---

<BaseLayout
  title="Quran & Arabic Classes Online | Free Trial | Ummah Academy"
  description="Live 1-on-1 Quran, Tajweed, Arabic & Islamic Studies classes with Al-Azhar certified teachers. Kids & adults, every timezone. Start with 2 free trial sessions."
>
  <!-- 01 · Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy" data-reveal>
        <span class="eyebrow">Islamic Education · Reimagined</span>
        <h1 class="hero__title">Learn Islam. Live It. <span class="accent">Grow With It.</span></h1>
        <p class="lead hero__lede">Authentic, structured Islamic education designed for Muslims wherever they are.</p>
        <div class="cluster hero__actions">
          <a class="btn btn--lg btn--primary" href="/courses/">
            Explore Courses <Icon name="arrow-right" weight="bold" class="icon-arrow" />
          </a>
          <a class="btn btn--lg btn--glass" href="/placement-test/">
            <Icon name="compass" weight="duotone" /> Take the Placement Test
          </a>
        </div>
        <ul role="list" class="hero__tagline">
          <li><Icon name="seal-check" weight="fill" /> Qualified Teachers</li>
          <li><Icon name="stack" weight="fill" /> Structured Learning</li>
          <li><Icon name="globe-simple" weight="fill" /> Learn Anywhere</li>
        </ul>
      </div>

      <div class="hero__visual" data-reveal style="--reveal-delay:.15s">
        <span class="hero__iqra quranic" aria-hidden="true">اقْرَأْ</span>
        <div class="frame frame--arch hero__frame">
          <Image src={heroArt} alt="" widths={[420, 640, 900]} sizes="(min-width: 960px) 460px, 86vw" loading="eager" fetchpriority="high" />
        </div>

        <div class="hero__card hero__card--progress glass">
          <span class="icon-badge"><Icon name="book-open-text" /></span>
          <div class="hero__card-body">
            <p class="hero__card-title">Quran &amp; Tajwid</p>
            <p class="hero__card-meta">Module 03 · Lesson 12</p>
            <div class="progress" role="img" aria-label="Progress 68%">
              <span style="width:68%"></span>
            </div>
            <p class="hero__card-meta"><span>Progress</span><strong>68%</strong></p>
          </div>
        </div>

        <div class="hero__card hero__card--live glass">
          <p class="hero__live"><span class="pulse"></span> Next Live Session</p>
          <p class="hero__card-title">Fiqh of Salah</p>
          <p class="hero__card-meta">Ustadh Ibrahim · 7:00 PM GMT</p>
          <p class="hero__countdown"><Icon name="clock" weight="bold" /> Live in 2h 14m</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · Why Ummah Academy -->
  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <SectionHead
        id="why-title"
        eyebrow="Why Ummah Academy"
        eyebrowAr="لماذا أكاديمية الأمة"
        title='Authentic Scholarship. <span class="accent">Modern Flexibility.</span>'
        sub="علم أصيل من الأزهر الشريف · مرونة عصرية بلا حدود"
        lede="We unite the 1,000-year tradition of Al-Azhar with flexible, personalized 1-on-1 live teaching — built for Muslims living in the West."
      />
      <div class="grid grid-2 why">
        {
          why.map((w, i) => (
            <article class="card glass why__card" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
              <div class="why__top">
                <span class="icon-badge">
                  <Icon name={w.icon} />
                </span>
                <span class="why__num">0{i + 1}</span>
              </div>
              <h3>
                {w.title} <span class="why__ar" lang="ar">{w.ar}</span>
              </h3>
              <p>{w.text}</p>
              <p class="why__proof">
                <Icon name="check-circle" weight="fill" />
                <span set:html={w.proof} />
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 03 · Stats strip -->
  <section class="section section--tight" aria-label="Ummah Academy in numbers">
    <div class="container">
      <div class="glass stats" data-reveal>
        {
          stats.map((s) => (
            <div class="stat">
              <p class="stat__num">{s.num}</p>
              <p class="stat__label">
                <strong>{s.label}</strong>
                <br />
                {s.sub}
              </p>
              <p class="stat__ar" lang="ar">{s.ar}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 04 · Inside our classroom -->
  <section class="section" aria-labelledby="classroom-title">
    <div class="container split">
      <div class="classroom-visual" data-reveal>
        <p class="classroom-visual__tag"><Icon name="play-circle" weight="fill" /> Live session preview — <span lang="ar">معاينة الجلسة</span></p>
        <ClassroomMockup />
        <p class="muted classroom-visual__cap">See how our live sessions work</p>
      </div>
      <div>
        <SectionHead
          id="classroom-title"
          align="start"
          eyebrow="Inside Our Classroom"
          eyebrowAr="داخل الفصل"
          title='Experience the Live <span class="accent">1-on-1 Difference</span>'
          sub="اختبر الفرق في التعليم الفردي المباشر"
          lede="Before committing, parents and students often want to see our teaching environment. Our sessions use professional interactive tools — the moment you join, you’ll feel the difference from pre-recorded platforms."
        />
        <ul role="list" class="feature-list">
          {
            classroom.map((f, i) => (
              <li class="feature" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
                <span class="icon-badge">
                  <Icon name={f.icon} />
                </span>
                <div>
                  <h3>
                    {f.title} <span class="why__ar" lang="ar">{f.ar}</span>
                  </h3>
                  <p>{f.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <a class="btn btn--primary mt-m" href="/contact/#book">
          Book a Free Session <span lang="ar" class="arabic">— احجز جلسة مجانية</span>
          <Icon name="arrow-right" weight="bold" class="icon-arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- 05 · Impact numbers -->
  <section class="section" aria-labelledby="impact-title">
    <div class="night-panel theme-night impact">
      <div class="stars"></div>
      <div class="container">
        <SectionHead
          id="impact-title"
          eyebrow="Our Impact in Numbers"
          eyebrowAr="تأثيرنا بالأرقام"
          title='Numbers That Reflect <span class="accent">Real Quality</span>'
          sub="أرقام تعكس جودة حقيقية"
          lede="Every metric reflects a genuine commitment to excellence in Islamic education across the globe."
        />
        <div class="grid grid-4">
          {
            impact.map((s, i) => (
              <div class="glass impact__card" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
                <p class="stat__num">{s.num}</p>
                <p class="impact__label">{s.label}</p>
                <p class="stat__label">{s.sub}</p>
                <p class="stat__ar" lang="ar">{s.ar}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 06 · 4 steps -->
  <section class="section" aria-labelledby="steps-title">
    <div class="container">
      <SectionHead
        id="steps-title"
        eyebrow="Simple Process"
        eyebrowAr="خطوات بسيطة"
        title='Start Your Journey in <span class="accent">4 Simple Steps</span>'
        sub="ابدأ رحلتك في ٤ خطوات بسيطة"
        lede="From signing up to your first live session — every obstacle removed so you begin immediately."
      />
      <ol role="list" class="steps">
        {
          steps.map((s, i) => (
            <li class="glass step" data-reveal style={`--reveal-delay:${i * 0.07}s`}>
              <span class="step__num">0{i + 1}</span>
              <span class="icon-badge">
                <Icon name={s.icon} />
              </span>
              <h3>{s.title}</h3>
              <p class="step__ar" lang="ar">{s.ar}</p>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 07 · Tracks -->
  <section class="section" aria-labelledby="tracks-title">
    <div class="container">
      <SectionHead
        id="tracks-title"
        eyebrow="Our Learning Tracks"
        eyebrowAr="مساراتنا التعليمية"
        title='4 Comprehensive Paths to <span class="accent">Islamic Knowledge</span>'
        sub="٤ مسارات شاملة للعلم الشرعي"
        lede="From your first letter to Ijazah certification — we cover every stage of your journey in Quran, Arabic, and Islamic sciences."
      />
      <div class="grid grid-4 tracks">
        {TRACKS.map((t, i) => <TrackCard track={t} href={`/courses/${trackAnchor[t.id]}`} delay={i * 0.06} />)}
      </div>
    </div>
  </section>

  <!-- 08 · Placement test -->
  <section class="section" aria-labelledby="test-title">
    <div class="container">
      <div class="glass placement" data-reveal>
        <div class="placement__copy">
          <span class="eyebrow">Free Level Assessment <span class="eyebrow__ar" lang="ar">— تقييم مستوى مجاني</span></span>
          <h2 id="test-title">Not Sure Which <span class="accent">Level You’re At?</span></h2>
          <p class="section-head__sub" lang="ar" dir="rtl">مش متأكد من مستواك؟ خد اختبار تحديد المستوى المجاني</p>
          <p class="lead">
            Our certified teachers designed a quick 5-minute placement test to pinpoint exactly which course and level is right
            for you — whether you’re a complete beginner or want to assess your current Tajweed or Arabic proficiency.
          </p>
          <ol role="list" class="placement__steps">
            <li><span>1</span> Choose your track: Quran, Arabic, or Islamic Studies — <span lang="ar" class="arabic">اختر مسارك</span></li>
            <li><span>2</span> Answer 8–10 quick interactive questions in 5 minutes</li>
            <li><span>3</span> Receive instant result: your level, strengths &amp; gaps</li>
            <li><span>4</span> Get full personalized study plan via WhatsApp — free</li>
          </ol>
          <div class="cluster">
            <a class="btn btn--glass" href="/placement-test/?track=quran">Take Quran Test <span lang="ar" class="arabic">— اختبار القرآن</span></a>
            <a class="btn btn--glass" href="/placement-test/?track=arabic">Take Arabic Test <span lang="ar" class="arabic">— اختبار العربية</span></a>
            <a class="btn btn--glass" href="/placement-test/?track=kids">Take Kids Test <span lang="ar" class="arabic">— اختبار الأطفال</span></a>
          </div>
        </div>
        <div class="placement__card glass glass--strong">
          <span class="icon-badge"><Icon name="clipboard-text" /></span>
          <p class="placement__card-title">Level Test — Free</p>
          <p class="muted">5 minutes · Designed by Azhari scholars · Instant result · No commitment</p>
          <a class="btn btn--primary btn--block" href="/placement-test/">Start the Test Now <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
          <div class="cluster placement__chips">
            <span class="chip"><Icon name="book-open-text" /> Quran Track</span>
            <span class="chip"><Icon name="pen-nib" /> Arabic Track</span>
            <span class="chip"><Icon name="star" /> Kids Track</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 · Comparison -->
  <section class="section" aria-labelledby="compare-title">
    <div class="container">
      <SectionHead
        id="compare-title"
        eyebrow="The Real Difference"
        eyebrowAr="الفرق الحقيقي"
        title='Ummah Academy vs. <span class="accent">Traditional Platforms</span>'
        sub="أكاديمية الأمة مقارنة بالمنصات التقليدية"
        lede="A direct comparison of our Itqan-based methodology against generic online platforms and traditional alternatives."
      />
      <div class="glass table-wrap compare" data-reveal>
        <table class="table">
          <caption class="sr-only">Ummah Academy compared with generic platforms</caption>
          <thead>
            <tr>
              <th scope="col">Learning Aspect</th>
              <th scope="col" class="compare__us">Ummah Academy</th>
              <th scope="col">Generic Platforms</th>
            </tr>
          </thead>
          <tbody>
            {
              compare.map(([aspect, us, them]) => (
                <tr>
                  <th scope="row">{aspect}</th>
                  <td class="compare__us">
                    <Icon name="check-circle" weight="fill" class="compare__yes" />
                    {us}
                  </td>
                  <td class="compare__them">
                    <Icon name="x-circle" weight="duotone" class="compare__no" />
                    {them}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 10 · Testimonials -->
  <section class="section" id="stories" aria-labelledby="stories-title">
    <div class="container">
      <SectionHead
        id="stories-title"
        eyebrow="Global Impact"
        eyebrowAr="تأثير عالمي"
        title='What Our <span class="accent">Students</span> Say'
        sub="ماذا يقول طلابنا عنا"
        lede="Real families from 50+ countries sharing their journey with Ummah Academy."
      />
    </div>
    <div class="stories" data-reveal>
      <ul role="list" class="stories__track">
        {
          TESTIMONIALS.map((t) => (
            <li>
              <TestimonialCard t={t} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 11 · Hall of fame -->
  <section class="section" aria-labelledby="fame-title">
    <div class="container">
      <SectionHead
        id="fame-title"
        eyebrow="Hall of Fame"
        eyebrowAr="قاعة الشرف"
        title='Our Star Students &amp; <span class="accent">Graduates</span>'
        sub="نحتفي بطلابنا المتميزين وخريجينا"
        lede="Celebrating students who completed memorization milestones, earned Ijazahs, or achieved major academic breakthroughs. May Allah bless their journey."
      />
      <ul role="list" class="fame">
        {
          HALL_OF_FAME.map((h, i) => (
            <li class="glass fame__card" data-reveal style={`--reveal-delay:${i * 0.05}s`}>
              <span class="fame__avatar" aria-hidden="true">
                {h.initials}
              </span>
              <strong>{h.name}</strong>
              <span class="chip chip--accent">
                <Icon name="medal" /> {h.achievement}
              </span>
              <span class="muted">{h.country}</span>
            </li>
          ))
        }
