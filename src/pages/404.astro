---
/**
 * One static 404 serves every missing path on Vercel, so it speaks every language.
 * Default (and without JS): English + Arabic. On /ar/ /de/ /fr/ /it/ paths an inline
 * script shows that language first, next to English.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { waLink } from '@/data/site';
import { LANGS, LOCALE, PREFIXED, lp, type Lang } from '@/i18n';

const T: Record<Lang, { eyebrow: string; title: string; lede: string; home: string; links: [string, string, string, string]; wa: string }> = {
  en: { eyebrow: 'Page not found', title: 'We couldn’t find that page', lede: 'It may have moved or no longer exists. These are the pages families visit most:', home: 'Back to Home', links: ['All courses', 'Pricing', 'Placement test', 'Blog'], wa: 'Message us on WhatsApp' },
  ar: { eyebrow: 'الصفحة غير موجودة', title: 'لم نعثر على هذه الصفحة', lede: 'ربما نُقلت أو لم تعد موجودة. هذه أكثر الصفحات التي تزورها الأسر:', home: 'العودة إلى الرئيسية', links: ['كل الدورات', 'الأسعار', 'اختبار تحديد المستوى', 'المدونة'], wa: 'راسلنا عبر واتساب' },
  de: { eyebrow: 'Seite nicht gefunden', title: 'Diese Seite konnten wir nicht finden', lede: 'Vielleicht wurde sie verschoben oder existiert nicht mehr. Diese Seiten besuchen Familien am häufigsten:', home: 'Zur Startseite', links: ['Alle Kurse', 'Preise', 'Einstufungstest', 'Blog'], wa: 'Per WhatsApp schreiben' },
  fr: { eyebrow: 'Page introuvable', title: 'Nous n’avons pas trouvé cette page', lede: 'Elle a peut-être été déplacée ou n’existe plus. Voici les pages que les familles consultent le plus :', home: 'Retour à l’accueil', links: ['Tous les cours', 'Tarifs', 'Test de niveau', 'Blog'], wa: 'Écrire sur WhatsApp' },
  it: { eyebrow: 'Pagina non trovata', title: 'Non abbiamo trovato questa pagina', lede: 'Potrebbe essere stata spostata o non esistere più. Ecco le pagine che le famiglie visitano di più:', home: 'Torna alla home', links: ['Tutti i corsi', 'Prezzi', 'Test di livello', 'Blog'], wa: 'Scrivici su WhatsApp' },
};
const ROUTES = [
  ['/courses/', 'books'],
  ['/pricing/', 'tag'],
  ['/placement-test/', 'compass'],
  ['/blog/', 'article'],
] as const;
const panels = LANGS.map((lang) => ({
  lang,
  dir: LOCALE[lang].dir,
  ...T[lang],
  home: { href: lp(lang, '/'), label: T[lang].home },
  links: ROUTES.map(([href, icon], i) => ({ href: lp(lang, href), label: T[lang].links[i], icon })),
}));
const detect = `var m=location.pathname.match(/^\\/(${PREFIXED.join('|')})(\\/|$)/);if(m)document.documentElement.classList.add('nf-'+m[1]);`;
---

<BaseLayout title="Page not found · الصفحة غير موجودة | Ummah Academy" description="The page you're looking for may have moved." noindex>
  <script is:inline slot="head" set:html={detect} />
  <section class="section">
    <div class="container nf">
      <p class="nf__code quranic" aria-hidden="true">٤٠٤</p>
      <div class="nf__panels">
        {
          panels.map((p) => (
            <div class:list={['nf__panel', 'glass', `nf__panel--${p.lang}`]} lang={p.lang} dir={p.dir}>
              <span class="eyebrow">{p.eyebrow}</span>
              <h1 class="nf__title">{p.title}</h1>
              <p class="nf__lede">{p.lede}</p>
              <ul role="list" class="nf__links">
                {p.links.map((l) => (
                  <li>
                    <a class="btn btn--sm btn--glass" href={l.href}>
                      <Icon name={l.icon} /> {l.label}
                    </a>
                  </li>
                ))}
              </ul>
              <div class="cluster nf__cta">
                <a class="btn btn--primary" href={p.home.href}>{p.home.label}</a>
                <a class="btn btn--glass" href={waLink()} target="_blank" rel="noopener">
                  <Icon name="whatsapp-logo" weight="fill" class="icon-wa" /> {p.wa}
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding-block: 24px;
  }

  .nf__code {
    font-size: clamp(5.5rem, 16vw, 10rem);
    line-height: 1;
    background: var(--grad-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .nf__panels {
    display: grid;
    gap: 16px;
    width: 100%;
    max-width: 1040px;
  }

  @media (min-width: 900px) {
    .nf__panels {
      grid-template-columns: 1fr 1fr;
    }
  }

  .nf__panel {
    --radius: var(--r-xl);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: clamp(22px, 3vw, 36px);
  }

  /* default: English + Arabic; on a /de/ /fr/ /it/ path: that language first, then English */
  .nf__panel--de,
  .nf__panel--fr,
  .nf__panel--it {
    display: none;
  }

  :global(html.nf-ar) .nf__panel--ar,
  :global(html.nf-de) .nf__panel--de,
  :global(html.nf-fr) .nf__panel--fr,
  :global(html.nf-it) .nf__panel--it {
    display: flex;
    order: -1;
  }

  :global(html.nf-de) .nf__panel--ar,
  :global(html.nf-fr) .nf__panel--ar,
  :global(html.nf-it) .nf__panel--ar {
    display: none;
  }

  .nf__title {
    font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.4rem);
  }

  .nf__panel--ar .nf__title {
    letter-spacing: 0;
    line-height: 1.35;
    font-weight: 700;
  }

  .nf__lede {
    color: var(--ink-2);
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .nf__cta {
    margin-top: auto;
    padding-top: 6px;
  }
</style>
