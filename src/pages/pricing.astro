---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import PlanCard from '@/components/PlanCard.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import Icon from '@/components/Icon.astro';
import { PLANS, INCLUDED, PAYMENT_METHODS } from '@/data/pricing';

const trackA = PLANS.filter((p) => p.track === 'A');
const trackB = PLANS.filter((p) => p.track === 'B');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Ummah Academy plans',
  itemListElement: PLANS.map((p) => ({
    '@type': 'Offer',
    name: `${p.name} — ${p.minutes}-minute sessions, ${p.perWeek}/week`,
    price: p.price,
    priceCurrency: 'USD',
    category: 'subscription',
  })),
};
---

<BaseLayout
  title="Quran Classes Pricing | Ummah Academy"
  description="Transparent monthly plans from $40 to $128 for live 1-on-1 Quran, Arabic and Islamic Studies classes. Every plan starts with 2 free trial sessions."
  jsonLd={ld}
>
  <PageHero
    align="center"
    eyebrow="Flexible Pricing"
    eyebrowAr="أسعار مرنة"
    title='Simple &amp; <span class="accent">Transparent</span> Pricing Plans'
    sub="خطط واضحة وبسيطة للجميع"
    lede="7 flexible plans for every budget. All include 2 free trials, progress reports, and certificates — no hidden fees."
  >
    <ul role="list" class="cluster ticks">
      <li class="chip"><Icon name="check-circle" weight="fill" /> 2 Free Trials</li>
      <li class="chip"><Icon name="check-circle" weight="fill" /> No Credit Card</li>
      <li class="chip"><Icon name="check-circle" weight="fill" /> Cancel Anytime</li>
    </ul>
  </PageHero>

  <section class="section section--tight" aria-labelledby="track-a">
    <div class="container">
      <SectionHead
        id="track-a"
        eyebrow="Mastery Track"
        eyebrowAr="مسار الإتقان"
        title="Track A — 60-Minute Sessions"
        lede="Perfect for adults pursuing serious Tajweed study, Hifz, and Islamic sciences."
      />
      <div class="grid grid-3">
        {trackA.map((p, i) => <PlanCard plan={p} delay={i * 0.06} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="track-b">
    <div class="container">
      <SectionHead
        id="track-b"
        eyebrow="Cubs & Foundation"
        eyebrowAr="مسار الأشبال"
        title="Track B — 30-Minute Sessions"
        lede="For children and shorter focused sessions matching children’s attention spans."
      />
      <div class="grid grid-4">
        {trackB.map((p, i) => <PlanCard plan={p} delay={i * 0.06} cta="Start free" />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="included">
    <div class="container">
      <SectionHead
        id="included"
        eyebrow="Always Included"
        eyebrowAr="مع كل الخطط"
        title='Every Plan <span class="accent">Includes</span>'
        lede="No hidden extras. All features included at no additional cost."
      />
      <FeatureGrid items={INCLUDED.map((f) => ({ icon: f.icon, title: f.title, text: f.desc }))} cols={4} />
    </div>
  </section>

  <section class="section" aria-labelledby="payments">
    <div class="container">
      <SectionHead
        id="payments"
        eyebrow="Payment Methods"
        eyebrowAr="طرق الدفع"
        title='Pay Your Way — <span class="accent">From Anywhere</span>'
        lede="We serve 50+ countries. Multiple secure payment options available."
      />
      <ul role="list" class="grid grid-3 pay">
        {
          PAYMENT_METHODS.map((m) => (
            <li class="glass pay__item" data-reveal>
              <span class="icon-badge">
                <Icon name={m.icon} />
              </span>
              <span>
                <strong>{m.title}</strong>
                <small>{m.desc}</small>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container--narrow seo-copy" data-reveal>
      <span class="eyebrow">Pricing</span>
      <h2>Quran Classes Pricing</h2>
      <p>
        Our pricing includes flexible plans for Quran, Arabic, and Islamic Studies classes, so families of any size and budget
        can find the right fit. Every plan starts with 2 free trial sessions before you commit.
      </p>
      <p>
        Whether you need a single weekly session for one student or a family plan covering multiple children across different
        subjects, our pricing is designed to scale with your needs, with no long-term contract required to get started.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .ticks {
    justify-content: center;
  }

  .ticks :global(svg) {
    color: var(--success);
  }

  .pay__item {
    --radius: 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
  }

  .pay__item strong {
    display: block;
    font-weight: 600;
  }

  .pay__item small {
    color: var(--ink-3);
    font-size: 0.86rem;
  }

</style>
