---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import { waLink } from '@/data/site';

/* The live library linked to PDFs on WordPress. Those files must be copied into
   /public/downloads/ before launch (see docs/06-launch-checklist.md). Until then
   each item routes to a WhatsApp request so no link is ever broken. */
const books = [
  { icon: 'book-open-text', title: 'Noor Al-Bayan', text: 'The most trusted foundation book for teaching Arabic reading from scratch.', lang: 'Arabic · English' },
  { icon: 'text-aa', title: 'Al-Ajrumiyyah', text: 'The classical 13th-century Arabic grammar primer for all Nahw students.', lang: 'Arabic · Annotated' },
  { icon: 'music-notes-simple', title: 'Al-Jazariyyah', text: 'The essential Tajweed poem — foundational text for all three Tajweed levels.', lang: 'Arabic · With Vowels' },
  { icon: 'moon-stars', title: 'Adhkar for Kids', text: 'Illustrated daily Islamic etiquette and adhkar guide for children.', lang: 'Arabic · English' },
];
const sheets = [
  { icon: 'pencil-line', title: 'Arabic Letter Tracing', text: 'Dot-to-dot tracing sheets for all 28 letters in all forms.' },
  { icon: 'list-checks', title: 'Tajweed Rules Summary', text: 'One-page colour-coded reference of all major Tajweed rules.' },
  { icon: 'calendar-check', title: 'Daily Wird Tracker', text: '30-day Quran recitation and Hifz tracking chart.' },
  { icon: 'brackets-curly', title: 'Nahw Exercises', text: 'Fill-in-the-blank grammar exercises with answer key.' },
  { icon: 'star', title: 'Ummah Cubs Activity Pack', text: '5 Pillars, Prophets, and colouring pages for children.' },
  { icon: 'brain', title: 'Hifz Schedule Template', text: 'Customizable weekly memorization plan template.' },
];
const request = (t: string) => waLink(`Assalamu alaikum, please send me the free resource: ${t}`);
---

<BaseLayout title="Free Islamic Resources | Ummah Academy" description="Free e-books, worksheets and children's resources for Quran, Tajweed, Arabic and Islamic Studies — the same texts our Al-Azhar teachers use.">
  <PageHero align="center" eyebrow="Free Resources" eyebrowAr="مصادر مجانية" title='The <span class="accent">Free</span> Islamic Library' sub="المكتبة الإسلامية المجانية" lede="Free e-books, audio recitations, worksheets, and children’s resources — all completely free." />

  <section class="section section--tight" aria-labelledby="books">
    <div class="container">
      <SectionHead id="books" eyebrow="Foundation Texts" eyebrowAr="كتب أساسية" title='Free E-Books &amp; <span class="accent">Learning Materials</span>' lede="Download the same texts our Al-Azhar teachers use. Free, no signup required." />
      <div class="grid grid-4">
        {
          books.map((b, i) => (
            <article class="card glass res" data-reveal style={`--reveal-delay:${i * 0.05}s`}>
              <div class="res__top">
                <span class="icon-badge">
                  <Icon name={b.icon} />
                </span>
                <span class="cluster" style="--cluster:4px">
                  <span class="chip">PDF</span>
                  <span class="chip chip--accent">Free</span>
                </span>
              </div>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
              <p class="res__lang">
                <Icon name="globe-simple" weight="bold" /> {b.lang}
              </p>
              <a class="btn btn--sm btn--glass" href={request(b.title)} target="_blank" rel="noopener">
                <Icon name="download-simple" weight="bold" /> Get it free
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="sheets">
    <div class="container">
      <SectionHead id="sheets" eyebrow="Worksheets" eyebrowAr="أوراق عمل" title='Interactive <span class="accent">Practice Sheets</span>' lede="Printable worksheets for Arabic practice, Tajweed exercises, and Islamic studies revision." />
      <div class="grid grid-3">
        {
          sheets.map((s, i) => (
            <article class="card glass res" data-reveal style={`--reveal-delay:${i * 0.05}s`}>
              <span class="icon-badge">
                <Icon name={s.icon} />
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <a class="btn btn--link" href={request(s.title)} target="_blank" rel="noopener">
                Get the PDF →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container--narrow seo-copy" data-reveal>
      <span class="eyebrow">Resources</span>
      <h2>Free Islamic Resources</h2>
      <p>
        Our free Islamic resources library includes e-books, audio recitations, and worksheets to support your Quran, Arabic, and
        Islamic Studies learning journey, available to everyone whether or not you are currently enrolled in a class.
      </p>
      <p>
        Browse recitation audio to practice listening and repetition, printable worksheets for children learning Arabic letters and
        Islamic Studies basics, and short e-books covering Tajweed rules and core beliefs, all free to download and use at your own
        pace.
      </p>
    </div>
  </section>

  <CtaPanel eyebrow="Next step · الخطوة التالية" title='Free Resources Are Just <span class="accent">the Beginning</span>' lede="Pair these resources with live 1-on-1 sessions from our Al-Azhar teachers." primary={{ label: 'Book 2 Free Live Sessions', href: '/contact/#book' }} />
</BaseLayout>

<style>
  .res__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .res__lang {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
  }

  .res__lang :global(svg) {
    width: 14px;
    height: 14px;
  }

  .res .btn {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
