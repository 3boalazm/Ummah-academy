---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { TESTS } from '@/data/placement';
import { SITE } from '@/data/site';

const levels = [
  { key: 'Beginner', ar: 'مبتدئ', icon: 'plant' },
  { key: 'Intermediate', ar: 'متوسط', icon: 'tree' },
  { key: 'Advanced', ar: 'متقدم', icon: 'tree-evergreen' },
];
---

<BaseLayout
  title="Free Placement Test — Find Your Level | Ummah Academy"
  description="Find your Quran, Arabic, kids or Islamic Studies level in about 3 minutes. Instant result with strengths, focus areas and a recommended starting course."
>
  <PageHero
    align="center"
    eyebrow="Free Level Assessment"
    eyebrowAr="تقييم مستوى مجاني"
    title='Find Your Learning Level in <span class="accent">3 Minutes</span>'
    lede="Answer a few quick questions and get an instant, personalized reading level — plus a study plan sent straight to your WhatsApp."
    compact
  >
    <ol role="list" class="pt-steps" aria-label="How the test works">
      <li><span>1</span> Choose your track</li>
      <li><span>2</span> Answer a few quick questions</li>
      <li><span>3</span> Get your level + skill breakdown</li>
      <li><span>4</span> Get your study plan on WhatsApp</li>
    </ol>
  </PageHero>

  <section class="section section--tight">
    <div class="container--narrow">
      <div class="glass glass--strong pt" data-pt data-wa={SITE.whatsapp.number} data-ask-level="true" data-gate="true">
        <!-- Step: track -->
        <div class="pt__step" data-step="track">
          <h2 class="pt__title"><span lang="ar" class="arabic">اختر مسارك</span> — Choose your track to begin</h2>
          <div class="choices pt__tracks" role="radiogroup" aria-label="Track">
            {
              TESTS.map((t) => (
                <label class="choice">
                  <input type="radio" name="pt-track" value={t.key} />
                  <span class="choice__box">
                    <Icon name={t.icon} />
                    <span>
                      {t.label}
                      <small lang="ar">{t.labelAr}</small>
                    </span>
                  </span>
                </label>
              ))
            }
          </div>
        </div>

        <!-- Step: self-assessed level -->
        <div class="pt__step" data-step="level" hidden>
          <h2 class="pt__title"><span lang="ar" class="arabic">اختر مستواك</span> — Choose your level</h2>
          <div class="choices" role="radiogroup" aria-label="Your level">
            {
              levels.map((l) => (
                <label class="choice">
                  <input type="radio" name="pt-level" value={l.key} />
                  <span class="choice__box">
                    <Icon name={l.icon} />
                    <span>
                      {l.key}
                      <small lang="ar">{l.ar}</small>
                    </span>
                  </span>
                </label>
              ))
            }
          </div>
          <div class="pt__nav"><button class="btn btn--glass" type="button" data-back><Icon name="arrow-left" weight="bold" /> Back</button></div>
        </div>

        <!-- Step: questions -->
        <div class="pt__step" data-step="quiz" hidden>
          <div class="pt__meta">
            <span class="chip chip--accent" data-q-track></span>
            <span class="pt__count" data-q-count>1 / 8</span>
          </div>
          <div class="pt__bar"><span data-q-bar></span></div>
          <fieldset class="pt__q">
            <legend class="pt__prompt" data-q-prompt></legend>
            <div class="choices pt__options" data-q-options></div>
          </fieldset>
          <div class="pt__nav">
            <button class="btn btn--glass" type="button" data-back><Icon name="arrow-left" weight="bold" /> Back</button>
            <button class="btn btn--primary" type="button" data-next disabled>Next <Icon name="arrow-right" weight="bold" class="icon-arrow" /></button>
          </div>
        </div>

        <!-- Step: details gate -->
        <form class="pt__step" data-step="gate" hidden novalidate>
          <h2 class="pt__title">One last step — enter your WhatsApp number to see your full result and personalized study plan</h2>
          <div class="pt__gate">
            <div class="field">
              <label for="pt-freq">Sessions per week?</label>
              <select class="select" id="pt-freq" name="freq">
                <option>1 session/week</option><option selected>2 sessions/week</option><option>3 sessions/week</option><option>4+ sessions/week</option>
              </select>
            </div>
            <div class="field">
              <label for="pt-start">When would you like to start?</label>
              <select class="select" id="pt-start" name="start">
                <option>Ready to start now</option><option>In a few days</option><option>In a few weeks</option><option>In 1–3 months</option><option>Not sure yet</option>
              </select>
            </div>
            <div class="field">
              <label for="pt-wa">WhatsApp number</label>
              <input class="input" id="pt-wa" name="wa" type="tel" inputmode="tel" autocomplete="tel" placeholder="+44 7700 900123" />
              <p class="error">Please enter your WhatsApp number so we can send your result.</p>
            </div>
          </div>
          <div class="pt__nav">
            <button class="btn btn--glass" type="button" data-back><Icon name="arrow-left" weight="bold" /> Back</button>
            <button class="btn btn--primary" type="submit">Show my result <Icon name="arrow-right" weight="bold" class="icon-arrow" /></button>
          </div>
        </form>

        <!-- Step: result -->
        <div class="pt__step pt__result" data-step="result" hidden aria-live="polite">
          <span class="pt__level" data-r-level></span>
          <h2 class="pt__headline" data-r-headline></h2>
          <p class="pt__score" data-r-score></p>
          <div class="pt__cols">
            <div class="pt__col">
              <h3><Icon name="sparkle" weight="fill" /> Strengths</h3>
              <ul class="checklist" data-r-strengths></ul>
            </div>
            <div class="pt__col">
              <h3><Icon name="target" weight="fill" /> Focus areas</h3>
              <ul class="pt__focus" data-r-focus></ul>
            </div>
          </div>
          <div class="glass pt__rec">
            <p class="pt__rec-kicker">Recommended starting point</p>
            <p class="pt__rec-title" data-r-course></p>
            <p class="muted" data-r-why></p>
            <div class="cluster">
              <a class="btn btn--primary" href="/contact/#book" data-r-book>Book my 2 free sessions <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
              <a class="btn btn--glass" href="/courses/" data-r-link>See course</a>
            </div>
          </div>
          <div class="pt__share">
            <p>Get your personalized study plan on WhatsApp</p>
            <a class="btn btn--glass" href="#" target="_blank" rel="noopener" data-r-wa><Icon name="whatsapp-logo" weight="fill" class="icon-wa" /> Send my result on WhatsApp</a>
            <p class="muted pt__voice">Optional: send a short voice note of your recitation in the same chat for a teacher to review.</p>
          </div>
          <button class="btn btn--link" type="button" data-restart>Retake the test / try another track</button>
        </div>
      </div>
      <p class="pt__disclaimer muted">This quick check gives a starting recommendation. Your teacher confirms your exact level in your first free session.</p>
    </div>
  </section>

  <script type="application/json" id="pt-data" set:html={JSON.stringify(TESTS)} />
</BaseLayout>

<script>
  import { initPlacement } from '@/scripts/placement';
  initPlacement();
</script>

<style>
  .pt-steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .pt-steps li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 8px 8px;
    border-radius: var(--r-pill);
    font-size: 0.88rem;
    color: var(--ink-2);
    background: rgb(255 255 255 / 0.55);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.85), 0 0 0 1px rgb(46 29 70 / 0.06);
  }

  .pt-steps span {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    font-size: 0.78rem;
    font-weight: 650;
    color: #fff;
    background: var(--grad-accent);
  }

  .pt {
    --radius: var(--r-xl);
    padding: clamp(22px, 4vw, 48px);
    min-height: 380px;
  }

  .pt__step {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .pt__step[hidden] {
    display: none;
  }

  .pt__title {
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.7rem);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .pt__tracks {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .pt__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pt__count {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .pt__bar {
    height: 6px;
    border-radius: 99px;
    background: rgb(46 29 70 / 0.08);
    overflow: hidden;
    margin-top: -10px;
  }

  .pt__bar span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--grad-accent);
    transition: width 0.5s var(--ease-out);
  }

  .pt__q {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 18px;
  }

  .pt__prompt {
    padding: 0;
    font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.8rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 18px;
  }

  .pt__options {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .pt__options {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pt__options :global(.choice__box) {
    font-size: 1.02rem;
    min-height: 60px;
  }

  .pt__options :global(.ar-opt) {
    font-family: var(--font-quran);
    font-size: 1.45rem;
    line-height: 1.6;
  }

  .pt__nav {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .pt__gate {
    display: grid;
    gap: 14px;
  }

  .pt__result {
    align-items: flex-start;
  }

  .pt__level {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--r-pill);
    font-weight: 650;
    color: #fff;
    background: var(--grad-accent);
  }

  .pt__headline {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem);
  }

  .pt__score {
    color: var(--ink-2);
    margin-top: -10px;
  }

  .pt__cols {
    display: grid;
    gap: 16px;
    width: 100%;
  }

  @media (min-width: 640px) {
    .pt__cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pt__col h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    margin-bottom: 12px;
  }

  .pt__col h3 :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--accent-ink);
  }

  .pt__focus {
    display: grid;
    gap: 8px;
    padding-inline-start: 1.1em;
    color: var(--ink-2);
  }

  .pt__rec {
    --radius: 24px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
  }

  .pt__rec-kicker {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .pt__rec-title {
    font-size: 1.5rem;
    font-weight: 620;
    letter-spacing: -0.03em;
  }

  .pt__share {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .pt__share > p:first-child {
    font-weight: 560;
  }

  .pt__voice {
    font-size: 0.86rem;
  }

  .pt__disclaimer {
    text-align: center;
    font-size: 0.88rem;
    margin-top: 16px;
  }
</style>
