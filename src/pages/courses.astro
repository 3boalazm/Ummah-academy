---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import CourseCard from '@/components/CourseCard.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import Icon from '@/components/Icon.astro';
import { TRACKS } from '@/data/tracks';
import { trialLink } from '@/data/site';

const chooser = [
  ['Quran Recitation & Tajweed', '/quran-recitation-course/', 'Anyone wanting to recite the Quran correctly', '✓ Yes', 'Correct pronunciation and Tajweed rules'],
  ['Hifz & Ijazah', '/quran-memorization-hifz/', 'Students aiming to memorize Quran with a documented Ijazah', 'Basic Tajweed helps first', 'Memorization with a real, verified Sanad'],
  ['Arabic Language', '/online-arabic-classes/', 'Anyone wanting to read and understand Quranic Arabic', '✓ Yes', 'Quranic reading, grammar, and comprehension'],
  ['Ummah Cubs (Kids)', '/ummah-cubs-kids-islamic-studies/', 'Children ages 5–14', '✓ Yes', 'Quran, Arabic, and Islamic studies through games'],
  ['Islamic Studies', '/online-islamic-studies-classes/', 'Adults wanting Aqeedah, Fiqh, Tafsir, or Seerah', '✓ Yes', 'Broader Islamic knowledge beyond the Quran text'],
];

const titles: Record<string, string> = {
  quran: 'Quran &amp; <span class="accent">Tajweed</span> Track',
  arabic: 'Arabic <span class="accent">Language</span> Track',
  kids: 'Ummah Cubs <span class="accent">Kids</span> Program',
  islamic: 'Islamic <span class="accent">Studies</span> Track',
};

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ummah Academy courses',
  itemListElement: TRACKS.flatMap((t) => t.courses).map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Course',
      name: c.title,
      description: c.desc,
      provider: { '@type': 'EducationalOrganization', name: 'Ummah Academy', sameAs: 'https://ummahacademy.net' },
      offers: { '@type': 'Offer', price: c.from, priceCurrency: 'USD', category: 'subscription' },
    },
  })),
};
---

<BaseLayout
  title="Online Quran Courses | Tajweed, Hifz & Arabic | Ummah Academy"
  description="Four complete tracks — Quran & Tajweed, Arabic, Ummah Cubs for kids and Islamic Studies — taught live 1-on-1 by Al-Azhar certified teachers. From $40/month."
  jsonLd={ld}
>
  <PageHero
    align="center"
    eyebrow="All Learning Tracks"
    eyebrowAr="جميع المسارات"
    title='Comprehensive <span class="accent">Quran &amp; Islamic</span> Courses for Every Level'
    sub="دورات إسلامية شاملة لكل المستويات"
    lede="From your first Quran letter to earning an Ijazah — four complete tracks designed by Al-Azhar certified scholars."
  />

  <section class="section section--tight" aria-labelledby="chooser-title">
    <div class="container">
      <SectionHead
        id="chooser-title"
        eyebrow="Not Sure Where to Start?"
        title="Which Program Is Right for Me?"
        lede="A quick comparison before you dive into each track below — or take the free Placement Test for a personal recommendation."
      >
        <a class="btn btn--sm btn--glass" href="/placement-test/"><Icon name="compass" /> Take the Placement Test</a>
      </SectionHead>
      <div class="glass table-wrap chooser" data-reveal>
        <table class="table">
          <caption class="sr-only">Program comparison</caption>
          <thead>
            <tr><th scope="col">Program</th><th scope="col">Best For</th><th scope="col">Beginner Friendly</th><th scope="col">Main Goal</th></tr>
          </thead>
          <tbody>
            {
              chooser.map(([name, href, best, beginner, goal]) => (
                <tr>
                  <th scope="row">
                    <a href={href}>{name}</a>
                  </th>
                  <td>{best}</td>
                  <td>{beginner}</td>
                  <td>{goal}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <nav class="track-nav" aria-label="Jump to a track">
    <div class="track-nav__inner glass">
      {
        TRACKS.map((t) => (
          <a href={`#${t.id}`} class="track-nav__link">
            <Icon name={t.icon} /> {t.title}
          </a>
        ))
      }
    </div>
  </nav>

  {
    TRACKS.map((t, idx) => (
      <section class="section track" id={t.id} aria-labelledby={`${t.id}-title`}>
        <div class="container">
          <div class:list={['split', 'track__intro', { 'split--reverse': idx % 2 === 1 }]}>
            <div class="track__copy" data-reveal>
              <span class="eyebrow">
                Track {idx + 1} of 4 <span class="eyebrow__ar" lang="ar">— {t.titleAr}</span>
              </span>
              <h2 id={`${t.id}-title`} set:html={titles[t.id]} />
              <p class="lead">{t.intro}</p>
              <ul class="checklist">
                {t.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
              <div class="cluster">
                <a class="btn btn--primary" href={trialLink({ course: t.trial })}>
                  {t.ctaLabel} <Icon name="arrow-right" weight="bold" class="icon-arrow" />
                </a>
                <a class="btn btn--glass" href={t.href}>
                  Track details
                </a>
              </div>
              {t.id === 'kids' && (
                <a class="btn btn--link" href="/placement-test/?track=kids">
                  Not sure yet? Take the free Kids Placement Test →
                </a>
              )}
            </div>
            <div class="frame track__art" data-reveal style="--reveal-delay:.1s">
              <Image src={t.image} alt="" widths={[480, 720, 960]} sizes="(min-width: 960px) 520px, 92vw" />
            </div>
          </div>
          <div class:list={['grid', t.courses.length === 4 ? 'grid-4' : 'grid-3', 'track__courses']}>
            {t.courses.map((c, i) => (
              <CourseCard course={c} delay={i * 0.05} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section--tight">
    <div class="container--narrow seo-copy" data-reveal>
      <span class="eyebrow">Our Courses</span>
      <h2>Online Quran Courses at Ummah Academy</h2>
      <p>
        Our online Quran courses cover Quran recitation with proper Tajweed, Hifz (memorization), Quranic Arabic, and Islamic
        Studies for both kids and adults. Every course is taught 1-on-1, live, by a certified Al-Azhar teacher matched to your
        level and goals.
      </p>
      <p>
        Our Quran and Tajweed track builds correct recitation from the ground up, our Hifz track supports structured,
        teacher-guided memorization with regular revision, our Arabic track focuses on the Quranic Arabic needed to understand
        scripture directly, and our Islamic Studies track, including our Ummah Cubs program for children, covers core beliefs,
        worship, and character in an age-appropriate way. Every course starts with 2 free trial classes.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="glass test-cta" data-reveal>
        <div>
          <span class="eyebrow">Not sure where to start? <span class="eyebrow__ar" lang="ar">— مش متأكد تبدأ منين؟</span></span>
          <h2>Take Our Free <span class="accent">Placement Test</span> First</h2>
          <p class="lead">Answer 8 quick questions and our teachers will tell you exactly which course and level is right for you.</p>
        </div>
        <div class="cluster">
          <a class="btn btn--lg btn--primary" href="/placement-test/">Take Free Placement Test <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
          <a class="btn btn--lg btn--glass" href="/pricing/">View Pricing Plans</a>
        </div>
      </div>
    </div>
  </section>

  <RelatedPosts
    slugs={[
      'how-to-learn-quran-online-a-complete-beginners-guide-2026',
      '7-signs-youve-found-the-right-online-quran-teacher',
      'how-long-does-it-take-to-memorize-the-quran-a-realistic-timeline',
    ]}
  />
</BaseLayout>

<style>
  .chooser {
    --radius: 30px;
    padding: 8px;
  }

  .chooser th a {
    color: var(--accent-ink);
    text-decoration: none;
  }

  .chooser th a:hover {
    text-decoration: underline;
  }

  .chooser td {
    color: var(--ink-2);
  }

  .track-nav {
    position: sticky;
    top: calc(var(--header-h) + 4px);
    z-index: 20;
    display: flex;
    justify-content: center;
    padding-inline: var(--gutter);
    margin-top: 24px;
  }

  .track-nav__inner {
    --radius: var(--r-pill);
    display: flex;
    gap: 4px;
    padding: 6px;
    overflow-x: auto;
    max-width: 100%;
    scrollbar-width: none;
  }

  .track-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: var(--r-pill);
    font-size: 0.92rem;
    font-weight: 540;
    white-space: nowrap;
    text-decoration: none;
    color: var(--ink-2);
  }

  .track-nav__link :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--accent-ink);
  }

  .track-nav__link:hover {
    background: rgb(255 255 255 / 0.8);
    color: var(--ink);
  }

  .track {
    scroll-margin-top: 150px;
  }

  .track__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .track__copy h2 {
    font-size: var(--fs-h2);
  }

  .track__art {
    aspect-ratio: 5 / 4;
  }

  .track__courses {
    margin-top: clamp(32px, 4vw, 56px);
  }

  .test-cta {
    --radius: var(--r-xl);
    display: grid;
    gap: 24px;
    padding: clamp(28px, 4.5vw, 56px);
    align-items: center;
  }

  @media (min-width: 960px) {
    .test-cta {
      grid-template-columns: 1.3fr auto;
    }
  }

  .test-cta > div:first-child {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .test-cta h2 {
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.8rem);
  }
</style>
