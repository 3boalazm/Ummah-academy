---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { SITE, waLink } from '@/data/site';
---

<BaseLayout title="Almost there — confirm your free trial | Ummah Academy" description="Confirm your free trial request on WhatsApp." noindex>
  <section class="section">
    <div class="container--narrow">
      <div class="glass glass--strong ty" data-ty>
        <span class="ty__icon"><Icon name="paper-plane-tilt" weight="duotone" /></span>
        <h1 data-ty-title>Your request is ready — send it on WhatsApp to confirm</h1>
        <p class="lead" data-ty-lede>
          Tap the button below to send your details to our admissions team. Your trial is booked once we confirm your teacher and
          time with you on WhatsApp.
        </p>
        <a class="btn btn--lg btn--primary" href={waLink()} target="_blank" rel="noopener" data-ty-wa>
          <Icon name="whatsapp-logo" weight="fill" /> Send on WhatsApp
        </a>
        <details class="ty__preview" data-ty-preview hidden>
          <summary>Preview the message</summary>
          <pre data-ty-msg></pre>
          <button class="btn btn--sm btn--glass" type="button" data-ty-copy><Icon name="copy" /> Copy message</button>
        </details>
        <ol role="list" class="ty__steps">
          <li><span>1</span> We confirm your teacher and a time that suits your timezone.</li>
          <li><span>2</span> You receive a session link (Zoom or Google Meet) and a reminder 15 minutes before.</li>
          <li><span>3</span> You attend 2 free live sessions — then decide, with no obligation.</li>
        </ol>
        <p class="muted ty__alt">
          No WhatsApp? Email us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </p>
      </div>
      <div class="ty__next">
        <a class="btn btn--glass" href="/placement-test/"><Icon name="compass" /> Take the placement test while you wait</a>
        <a class="btn btn--glass" href="/blog/"><Icon name="book-open" /> Read our guides</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { LEAD_KEY } from '@/scripts/trial-form';
  import { track } from '@/scripts/analytics';
  const raw = sessionStorage.getItem(LEAD_KEY);
  const root = document.querySelector('[data-ty]');
  if (raw && root) {
    try {
      const { lead, received, message } = JSON.parse(raw) as { lead: { firstName: string }; received: boolean; message: string };
      const wa = root.querySelector<HTMLAnchorElement>('[data-ty-wa]');
      const number = wa?.href.match(/wa\.me\/(\d+)/)?.[1];
      if (wa && number) wa.href = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
      const title = root.querySelector('[data-ty-title]');
      const lede = root.querySelector('[data-ty-lede]');
      if (received) {
        if (title) title.textContent = `Thank you, ${lead.firstName} — we’ve received your request`;
        if (lede) lede.textContent = 'Our admissions team will WhatsApp you shortly to confirm your teacher and time. Want it even faster? Send the summary below on WhatsApp.';
      } else if (title) {
        title.textContent = `Almost there, ${lead.firstName} — send your request on WhatsApp`;
      }
      const preview = root.querySelector<HTMLDetailsElement>('[data-ty-preview]');
      const pre = root.querySelector('[data-ty-msg]');
      if (preview && pre) {
        pre.textContent = message;
        preview.hidden = false;
      }
      root.querySelector('[data-ty-copy]')?.addEventListener('click', async (e) => {
        await navigator.clipboard?.writeText(message);
        (e.currentTarget as HTMLButtonElement).textContent = 'Copied ✓';
      });
      wa?.addEventListener('click', () => track('trial_whatsapp_handoff', { received }));
    } catch {
      /* ignore */
    }
  }
</script>

<style>
  .ty {
    --radius: var(--r-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding: clamp(28px, 5vw, 60px);
  }

  .ty__icon {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 24px;
    color: var(--accent-ink);
    background: linear-gradient(150deg, #fff, var(--blush-100));
    box-shadow: var(--shadow-glass);
  }

  .ty__icon :global(svg) {
    width: 38px;
    height: 38px;
  }

  .ty h1 {
    font-size: clamp(1.8rem, 1.3rem + 2vw, 2.8rem);
  }

  .ty__preview {
    width: 100%;
    text-align: start;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.6);
    box-shadow: inset 0 0 0 1px rgb(46 29 70 / 0.08);
    padding: 12px 16px;
  }

  .ty__preview summary {
    cursor: pointer;
    font-weight: 560;
  }

  .ty__preview pre {
    white-space: pre-wrap;
    font-family: inherit;
    font-size: 0.92rem;
    color: var(--ink-2);
  }

  .ty__steps {
    display: grid;
    gap: 12px;
    text-align: start;
    width: 100%;
    max-width: 520px;
  }

  .ty__steps li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    color: var(--ink-2);
  }

  .ty__steps span {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 650;
    background: var(--grad-accent);
  }

  .ty__alt a {
    color: var(--accent-ink);
  }

  .ty__next {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
  }
</style>
