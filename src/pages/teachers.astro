---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import TeacherCard from '@/components/TeacherCard.astro';
import Steps from '@/components/Steps.astro';
import SanadChain from '@/components/SanadChain.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import art from '@/assets/art/track-islamic.jpg';
import { TEACHERS } from '@/data/people';
import { waLink } from '@/data/site';

const stats = [
  { n: '100%', l: 'Al-Azhar Certified' },
  { n: '25+', l: 'Years Combined Teaching' },
  { n: '3', l: 'Ijazah-Holding Scholars' },
  { n: '100%', l: 'Personally Vetted' },
];
const principles = [
  { title: 'One Student at a Time', text: 'Lessons move at the student’s own pace — never rushed toward a curriculum deadline that isn’t theirs.' },
  { title: 'Precision Before Speed', text: 'Correct Tajweed comes first; fluency and confidence follow naturally once the foundation is right.' },
  { title: 'Built on Approved Curricula', text: 'Noor Al-Bayan, Al-Qaida Al-Nooraniyyah, and Al-Ajrumiyyah — proven texts, not improvised lesson plans.' },
];
const process = [
  { icon: 'files', title: 'Application Review', text: 'Academic credentials and Al-Azhar affiliation are verified before any interview is scheduled.' },
  { icon: 'scroll', title: 'Ijazah & Sanad Verification', text: 'Each teacher’s chain of transmission is checked directly, not taken on their word.' },
  { icon: 'chalkboard-teacher', title: 'Live Teaching Demonstration', text: 'Knowledge alone isn’t enough — candidates teach a real trial lesson before being approved.' },
  { icon: 'chart-line-up', title: 'Ongoing Evaluation', text: 'Standards don’t stop at hiring — teaching quality is reviewed continuously, not just once.' },
];
---

<BaseLayout
  title="Al-Azhar Certified Online Quran Teachers | Ummah Academy"
  description="Meet our Al-Azhar graduate, Ijazah-holding teachers — personally vetted through a four-stage process for scholarship and the warmth it takes to teach the Qur'an well."
>
  <PageHero
    crumbs={[{ label: 'Teachers' }]}
    eyebrow="Our Faculty"
    title='Al-Azhar Certified Online Quran Teachers — <span class="accent">Scholars Who’ve Walked This Path</span>'
    lede="Every teacher at Ummah Academy is a personally vetted Al-Azhar graduate and Ijazah holder — chosen not only for scholarship, but for the patience and warmth it takes to teach the Qur’an well."
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href="#faculty">Meet Our Teachers <Icon name="arrow-down" weight="bold" /></a>
      <a class="btn btn--glass" href="#process">How We Select Them</a>
    </Fragment>
    <ul role="list" class="hero-stats">
      {stats.map((s) => <li><strong>{s.n}</strong><span>{s.l}</span></li>)}
    </ul>
    <Fragment slot="visual">
      <div class="t-visual">
        <div class="frame frame--arch t-visual__frame">
          <Image src={art} alt="" widths={[420, 640]} sizes="(min-width: 960px) 420px, 80vw" loading="eager" />
        </div>
        <span class="glass t-badge t-badge--a"><Icon name="seal-check" weight="fill" /> <span><small>Verified</small>Ijazah Certified</span></span>
        <span class="glass t-badge t-badge--b"><Icon name="graduation-cap" weight="fill" /> <span><small>Al-Azhar</small>Faculty Graduate</span></span>
      </div>
    </Fragment>
  </PageHero>

  <section class="section" aria-labelledby="apart-title">
    <div class="container">
      <SectionHead
        id="apart-title"
        eyebrow="What Sets Them Apart"
        title='Not just teachers. <span class="accent">Verified scholars.</span>'
        lede="Anyone can teach a Zoom call. Few can trace their knowledge back through an unbroken chain to the Prophet ﷺ himself."
      />
      <div class="apart">
        <article class="glass apart__main" data-reveal>
          <span class="chip chip--accent">Chain of Transmission</span>
          <h3>A verified Sanad, not just a certificate</h3>
          <p>
            Every teacher holds an Ijazah — formal authorization to teach Qur’anic recitation, carrying a documented chain of
            transmission back through their own teachers. It’s the same standard of scholarly rigor Al-Azhar has upheld for a
            thousand years, brought to a laptop screen.
          </p>
          <SanadChain />
          <p class="muted apart__note">This is what “Ijazah” means: not a diploma from a classroom, but a verified place in that chain.</p>
        </article>
        <div class="apart__side">
          <article class="card glass" data-reveal style="--reveal-delay:.06s">
            <span class="icon-badge"><Icon name="buildings" /></span>
            <h3>Al-Azhar University Trained</h3>
            <p>Graduates of Al-Azhar’s Faculties of Sharia, Arabic Language, and Islamic Studies — the oldest continuously operating seat of Islamic scholarship in the world.</p>
          </article>
          <article class="card glass" data-reveal style="--reveal-delay:.12s">
            <span class="icon-badge"><Icon name="heart" /></span>
            <h3>Chosen for Patience, Too</h3>
            <p>Scholarship earns the interview; the ability to teach a nervous seven-year-old or a first-time adult reader with warmth is what earns the seat.</p>
          </article>
        </div>
      </div>

      <figure class="quote" data-reveal>
        <blockquote>“Seeking knowledge is a pursuit towards Allah — and as knowledge grows, faith increases.”</blockquote>
        <figcaption>Ustadha Omneya Ali, Head of Tajweed Department</figcaption>
      </figure>

      <ol role="list" class="grid grid-3 principles">
        {
          principles.map((p, i) => (
            <li class="principle" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
              <span class="principle__num">0{i + 1}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="faculty" aria-labelledby="faculty-title">
    <div class="container">
      <SectionHead id="faculty-title" eyebrow="Our Faculty" title='Meet the scholars behind <span class="accent">every lesson</span>' />
      <div class="stack" style="--stack: 20px">
        {TEACHERS.map((t, i) => <TeacherCard teacher={t} delay={i * 0.05} />)}
      </div>
    </div>
  </section>

  <section class="section" id="process" aria-labelledby="process-title">
    <div class="container">
      <SectionHead
        id="process-title"
        eyebrow="Quality Assurance"
        title='How a teacher earns a place at <span class="accent">Ummah Academy</span>'
        lede="A deliberately narrow path — most applicants don’t make it through."
      />
      <Steps items={process} />
      <p class="result" data-reveal>
        <strong>The result?</strong> Every teacher you meet on this page has passed the same four-stage standard — no exceptions.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container--narrow seo-copy" data-reveal>
      <span class="eyebrow">Our Teachers</span>
      <h2>Al-Azhar Certified Online Quran Teachers</h2>
      <p>
        Our Al-Azhar certified online Quran teachers are personally vetted for both their Islamic scholarship and their teaching
        ability, so every family can trust who is teaching their children.
      </p>
      <p>
        Every teacher on our platform holds a genuine ijazah, a documented chain of transmission back through generations of
        scholars, in addition to real classroom teaching experience with students of different ages and levels. We personally
        interview and evaluate each teacher before they join the platform.
      </p>
    </div>
  </section>

  <CtaPanel
    eyebrow="Learn from a scholar"
    title='Ready to learn from a <span class="accent">certified scholar?</span>'
    lede="Book a free trial lesson and get matched with the right teacher for your goals."
    primary={{ label: 'Book a Free Trial Lesson', href: '/contact/#book' }}
    secondary={{ label: 'Talk to Us on WhatsApp', href: waLink() }}
    ticks={['2 free sessions', 'No credit card', 'No commitment']}
  />
</BaseLayout>

<style>
  .t-visual {
    position: relative;
    width: min(100%, 420px);
    margin-inline: auto;
    padding: 20px 30px;
  }

  .t-visual__frame {
    aspect-ratio: 4 / 5;
  }

  .t-badge {
    --radius: 18px;
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    font-weight: 600;
    font-size: 0.95rem;
    animation: float-y 7s ease-in-out infinite;
  }

  .t-badge small {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .t-badge :global(svg) {
    width: 26px;
    height: 26px;
    color: var(--accent-ink);
  }

  .t-badge--a {
    top: 14%;
    left: -4%;
  }

  .t-badge--b {
    bottom: 12%;
    right: -4%;
    animation-delay: -3s;
  }

  .apart {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 960px) {
    .apart {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .apart__main {
    --radius: var(--r-xl);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: clamp(26px, 3.5vw, 44px);
  }

  .apart__main h3 {
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
  }

  .apart__main > p {
    color: var(--ink-2);
  }

  .apart__main :global(.sanad) {
    width: 100%;
    margin-block: 18px 6px;
  }

  .apart__note {
    font-size: 0.92rem;
  }

  .apart__side {
    display: grid;
    gap: 16px;
  }

  .quote {
    margin: clamp(48px, 6vw, 80px) auto;
    max-width: 860px;
    text-align: center;
  }

  .quote blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.7rem, 1.2rem + 2vw, 2.8rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .quote figcaption {
    margin-top: 18px;
    color: var(--ink-3);
    font-size: 0.95rem;
  }

  .principles {
    list-style: none;
    padding: 0;
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 6px 4px;
    border-top: 1px solid var(--line-strong);
    padding-top: 22px;
  }

  .principle__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.8rem;
    color: var(--accent-ink);
    line-height: 1;
  }

  .principle h3 {
    font-size: 1.2rem;
  }

  .principle p {
    color: var(--ink-2);
  }

  .result {
    margin-top: 28px;
    text-align: center;
    color: var(--ink-2);
  }
</style>
