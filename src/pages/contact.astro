---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import TrialForm from '@/components/TrialForm.astro';
import Faq from '@/components/Faq.astro';
import Steps from '@/components/Steps.astro';
import Icon from '@/components/Icon.astro';
import { SITE, waLink } from '@/data/site';

const includes = [
  { title: '2 Live 1‑on‑1 Sessions', text: 'A personalized experience with your teacher — not a recording, not a group call.' },
  { title: 'Matched Teacher', text: 'Paired to your learning goal, age group and schedule before your first session.' },
  { title: 'No Payment, No Commitment', text: 'Two full sessions, completely free — no card required, no obligation to continue.' },
];
const next = [
  { icon: 'user-circle', title: 'Tell us about you', text: 'Complete the short form below.' },
  { icon: 'whatsapp-logo', title: 'Meet your teacher', text: 'We’ll reach out on WhatsApp to confirm the details.' },
  { icon: 'video-camera', title: 'Start your trial', text: 'Attend your 2 free live sessions.' },
];
const faqs = [
  { q: 'How quickly will you respond?', a: 'We usually reply via WhatsApp within 5 minutes — always within 2 hours, across all timezones.' },
  { q: 'Are the 2 free sessions truly free?', a: 'Yes — completely free, no credit card, no commitment. Just your name and WhatsApp.' },
  { q: 'Can I request a specific teacher?', a: 'Yes — mention their name in the “Add more details” section. We’ll do our best to match you.' },
  { q: 'What if I don’t speak Arabic?', a: 'Many of our students start with zero Arabic. Teachers are fully bilingual.' },
  { q: 'What platform for sessions?', a: 'Zoom or Google Meet — with interactive whiteboard tools for Tajweed marking.' },
  { q: 'My child is 5 — too young?', a: 'Not at all! Ummah Cubs accepts from age 5 with 30-min gamified sessions.' },
];
---

<BaseLayout title="Contact Ummah Academy | Book a Free Trial Class" description="Book 2 free live 1-on-1 trial sessions with a qualified Al-Azhar teacher. Takes under a minute — we confirm your teacher and time on WhatsApp.">
  <PageHero
    align="center"
    eyebrow="Free Trial"
    eyebrowAr="تجربة مجانية"
    title='Start Your <span class="accent">Islamic</span> Journey Today'
    lede="2 free live sessions with a qualified teacher."
  >
    <Fragment slot="actions">
      <a class="btn btn--lg btn--primary" href="#book">Start My Free Trial <Icon name="arrow-down" weight="bold" /></a>
    </Fragment>
    <p class="muted">No payment · No commitment</p>
  </PageHero>

  <section class="section section--tight" aria-labelledby="includes-title">
    <div class="container">
      <SectionHead id="includes-title" eyebrow="Your Free Trial Includes" title='Everything you need to <span class="accent">decide with confidence</span>' />
      <ol role="list" class="grid grid-3 includes">
        {
          includes.map((it, i) => (
            <li class="card glass" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
              <span class="includes__num">0{i + 1}</span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="next-title">
    <div class="container">
      <SectionHead id="next-title" eyebrow="What Happens Next" title="Three steps to your first session" />
      <Steps items={next} />
      <div class="contact-extra">
        <figure class="glass contact-quote" data-reveal>
          <blockquote>“Your teacher will guide you from your first session — at your pace, in your language.”</blockquote>
          <figcaption>Ummah Academy</figcaption>
        </figure>
        <div class="glass contact-why" data-reveal style="--reveal-delay:.06s">
          <h3>Why start with a trial?</h3>
          <ul class="checklist">
            <li><strong>Personalized.</strong> Learn at your own level, not a fixed curriculum.</li>
            <li><strong>Live &amp; interactive.</strong> Real-time guidance from your teacher, not a recording.</li>
            <li><strong>Flexible.</strong> Choose a schedule that works across any timezone.</li>
          </ul>
          <p class="contact-direct">
            Prefer to reach us directly?
            <a href={waLink()} target="_blank" rel="noopener"><Icon name="whatsapp-logo" weight="fill" class="icon-wa" /> {SITE.whatsapp.display}</a>
            <a href={`mailto:${SITE.email}`}><Icon name="envelope-simple" /> {SITE.email}</a>
          </p>
          <p class="muted contact-lock"><Icon name="lock-simple" weight="fill" /> Your details are only used to arrange your trial sessions.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="book" aria-labelledby="book-title">
    <div class="container--narrow">
      <SectionHead
        id="book-title"
        eyebrow="Book Your Trial"
        eyebrowAr="احجز تجربتك"
        title='Start Your Islamic <span class="accent">Learning Journey</span>'
        lede="Book your 2 free live sessions — we’ll WhatsApp you within 5 minutes to confirm your teacher and session time."
      />
      <TrialForm />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container--narrow seo-copy" data-reveal>
      <span class="eyebrow">Contact Us</span>
      <h2>Contact Ummah Academy</h2>
      <p>
        Contact Ummah Academy to book two free trial classes with a qualified, certified teacher, or to ask any question about our
        online Quran, Arabic, and Islamic Studies programs. Our team typically replies within a day by WhatsApp or email.
      </p>
      <p>
        Whether you are looking for a Quran and Tajweed teacher for yourself, an Arabic tutor, or an Islamic Studies class for your
        children, our form above lets you tell us your goals and preferences, including teacher gender preference and preferred
        schedule, so we can match you with the right teacher from the start.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="families-title">
    <div class="container">
      <SectionHead id="families-title" eyebrow="Why Families Choose Ummah Academy" title="Trusted by families in 50+ countries" />
      <div class="grid grid-3">
        <article class="card glass" data-reveal><span class="icon-badge"><Icon name="mosque" /></span><h3>Al-Azhar–trained teachers</h3><p>Every teacher is trained in the Al-Azhar tradition of Quran and Tajweed instruction.</p></article>
        <article class="card glass" data-reveal style="--reveal-delay:.06s"><span class="icon-badge"><Icon name="user-focus" /></span><h3>Live, 1‑on‑1 format</h3><p>No group calls, no pre-recorded content — every session is with your own teacher.</p></article>
        <article class="card glass" data-reveal style="--reveal-delay:.12s"><span class="icon-badge"><Icon name="clock-countdown" /></span><h3>Global, flexible scheduling</h3><p>Students join from every timezone; sessions are scheduled around you.</p></article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cfaq-title">
    <div class="container--narrow">
      <SectionHead id="cfaq-title" eyebrow="Questions" eyebrowAr="أسئلة شائعة" title='Frequently Asked <span class="accent">Questions</span>' />
      <Faq items={faqs} />
      <div class="glass prefer-wa" data-reveal>
        <p><strong>Prefer WhatsApp?</strong> Our team replies fast, in English or Arabic.</p>
        <a class="btn btn--glass" href={waLink()} target="_blank" rel="noopener"><Icon name="whatsapp-logo" weight="fill" class="icon-wa" /> Chat with our team</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .includes {
    list-style: none;
    padding: 0;
  }

  .includes__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--accent-ink);
  }

  .contact-extra {
    display: grid;
    gap: 16px;
    margin-top: 16px;
  }

  @media (min-width: 900px) {
    .contact-extra {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  .contact-quote {
    --radius: 26px;
    margin: 0;
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }

  .contact-quote blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    line-height: 1.25;
  }

  .contact-quote figcaption {
    color: var(--ink-3);
    font-size: 0.9rem;
  }

  .contact-why {
    --radius: 26px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 30px;
  }

  .contact-why h3 {
    font-size: 1.3rem;
  }

  .contact-direct {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }

  .contact-direct a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 560;
    text-decoration: none;
  }

  .contact-direct a:hover {
    text-decoration: underline;
  }

  .contact-direct :global(svg),
  .contact-lock :global(svg) {
    width: 18px;
    height: 18px;
  }

  .contact-lock {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
  }

  .prefer-wa {
    --radius: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 20px;
    padding: 20px 24px;
  }
</style>
