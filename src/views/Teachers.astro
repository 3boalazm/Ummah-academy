---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import TeacherCard from '@/components/TeacherCard.astro';
import Steps from '@/components/Steps.astro';
import SanadChain from '@/components/SanadChain.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import art from '@/assets/art/track-islamic.jpg';
import { getTeachers } from '@/data/people';
import { ui, lp, type Lang } from '@/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';
const t = ui(lang);
const teachers = getTeachers(lang);
const C = ar
  ? {
      meta: { title: 'معلمونا — علماء من الأزهر بإجازة موثّقة | أكاديمية الأمة', desc: 'تعرّف على معلمينا من خريجي الأزهر حاملي الإجازة، وكيف نختارهم عبر أربع مراحل تحقق تشمل السند وحصة تدريسية مباشرة.' },
      crumb: 'المعلمون',
      eyebrow: 'معلمونا',
      title: 'علماء <span class="accent">ساروا في هذا الطريق.</span>',
      lede: 'كل معلم لدينا خريج من الأزهر يحمل إجازة موثّقة — اخترناه للعلم، ولما يتطلبه تعليم القرآن من صبر ودفء أيضًا.',
      how: 'كيف نختار المعلمين',
      chips: ['خريجو الأزهر', 'إجازة وسند موثّقان', 'معلمات متاحات', 'العربية والإنجليزية'],
      badgeA: ['موثّقة', 'إجازة بسند'],
      badgeB: ['الأزهر', 'خريجو الكليات'],
      sanadKicker: 'السند',
      sanadTitle: 'ماذا تعني «الإجازة» حقًا؟',
      sanadText: 'الإجازة إذنٌ رسمي بتعليم تلاوة القرآن، يحمل سلسلة موثّقة من المعلمين — كل معلم أخذ عن شيخه — حتى النبي ﷺ. إنها ليست شهادة حضور، بل مكان مُتحقَّق منه في هذه السلسلة.',
      sanadNote: 'نتحقق من سند كل معلم مباشرة، ولا نكتفي بقوله.',
      leadsTitle: 'تعرّف على رؤساء الأقسام',
      leadsLede: 'العلماء الذين يقودون برامج التجويد والعربية وأشبال الأمة.',
      processTitle: 'كيف يحصل المعلم على مكانه عندنا',
      processLede: 'طريق ضيق عن قصد — وأغلب المتقدمين لا يجتازونه.',
      process: [
        { icon: 'files', title: 'مراجعة الطلب', text: 'نتحقق من المؤهلات والانتساب للأزهر قبل تحديد أي مقابلة.' },
        { icon: 'scroll', title: 'التحقق من الإجازة والسند', text: 'نراجع سلسلة السند مباشرة، لا نأخذها بالكلام.' },
        { icon: 'chalkboard-teacher', title: 'حصة تدريسية مباشرة', text: 'العلم وحده لا يكفي — يقدم المتقدم حصة حقيقية قبل اعتماده.' },
        { icon: 'chart-line-up', title: 'تقييم مستمر', text: 'لا تتوقف المعايير عند التعيين — تُراجع جودة التدريس باستمرار.' },
      ],
      result: 'النتيجة: كل معلم ستقابله اجتاز المعايير الأربعة نفسها — بلا استثناء.',
      principlesTitle: 'كيف ندرّس',
      principles: [
        ['طالب واحد في كل مرة', 'تسير الدروس بسرعة الطالب، لا وفق موعد منهج لا يخصه.'],
        ['الإتقان قبل السرعة', 'التجويد الصحيح أولًا، والطلاقة والثقة تأتيان بعد أن يستقيم الأساس.'],
        ['مناهج معتمدة', 'نور البيان والقاعدة النورانية والآجرومية — متون مجرّبة لا خطط مرتجلة.'],
      ],
      quote: '«طلب العلم سيرٌ إلى الله — وكلما ازداد العلم ازداد الإيمان.»',
      quoteBy: 'الأستاذة أمنية علي، رئيسة قسم التجويد',
      ctaTitle: 'تعلّم على يد <span class="accent">عالِم معتمد.</span>',
      ctaLede: 'احجز حصتين مجانيتين، ونختار لك المعلم المناسب لهدفك.',
    }
  : {
      meta: { title: 'Al-Azhar Certified Online Quran Teachers | Ummah Academy', desc: 'Meet our Al-Azhar graduate, Ijazah-holding teachers and see how we choose them: a four-stage process including Sanad verification and a live teaching demo.' },
      crumb: 'Teachers',
      eyebrow: 'Our teachers',
      title: 'Scholars who’ve <span class="accent">walked this path.</span>',
      lede: 'Every teacher is an Al-Azhar graduate with a verified Ijazah — chosen not only for scholarship, but for the patience and warmth it takes to teach the Qur’an well.',
      how: 'How we choose teachers',
      chips: ['Al-Azhar graduates', 'Ijazah & Sanad verified', 'Female teachers available', 'Arabic & English'],
      badgeA: ['Verified', 'Ijazah with Sanad'],
      badgeB: ['Al-Azhar', 'Faculty graduates'],
      sanadKicker: 'The Sanad',
      sanadTitle: 'What “Ijazah” really means',
      sanadText: 'An Ijazah is formal authorisation to teach Qur’anic recitation, carrying a documented chain of teachers — each taught by the one before — back to the Prophet ﷺ. Not a certificate of attendance: a verified place in that chain.',
      sanadNote: 'We check every teacher’s chain directly — never on their word alone.',
      leadsTitle: 'Meet our department leads',
      leadsLede: 'The scholars who lead our Tajweed, Arabic and Ummah Cubs programmes.',
      processTitle: 'How a teacher earns a place here',
      processLede: 'A deliberately narrow path — most applicants don’t make it through.',
      process: [
        { icon: 'files', title: 'Application review', text: 'Credentials and Al-Azhar affiliation are verified before any interview.' },
        { icon: 'scroll', title: 'Ijazah & Sanad verification', text: 'Each teacher’s chain of transmission is checked directly, not taken on trust.' },
        { icon: 'chalkboard-teacher', title: 'Live teaching demonstration', text: 'Knowledge isn’t enough — candidates teach a real lesson before approval.' },
        { icon: 'chart-line-up', title: 'Ongoing evaluation', text: 'Standards don’t stop at hiring — teaching quality is reviewed continuously.' },
      ],
      result: 'The result: every teacher you meet has passed the same four-stage standard — no exceptions.',
      principlesTitle: 'How we teach',
      principles: [
        ['One student at a time', 'Lessons move at the student’s pace, never rushed toward a deadline that isn’t theirs.'],
        ['Precision before speed', 'Correct Tajweed first; fluency and confidence follow once the foundation is right.'],
        ['Approved curricula', 'Noor Al-Bayan, Al-Qaida Al-Nooraniyyah and Al-Ajrumiyyah — proven texts, not improvised plans.'],
      ],
      quote: '“Seeking knowledge is a pursuit towards Allah — and as knowledge grows, faith increases.”',
      quoteBy: 'Ustadha Omneya Ali, Head of Tajweed',
      ctaTitle: 'Learn from a <span class="accent">certified scholar.</span>',
      ctaLede: 'Book two free sessions and we’ll match you with the right teacher for your goal.',
    };
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang}>
  <PageHero crumbs={[{ label: C.crumb }]} eyebrow={C.eyebrow} title={C.title} lede={C.lede} lang={lang}>
    <Fragment slot="actions">
      <a class="btn btn--primary" href={lp(lang, '/contact/') + '#book'}>{t.book2} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
      <a class="btn btn--glass" href="#process">{C.how}</a>
    </Fragment>
    <ul role="list" class="cluster">{C.chips.map((c) => <li class="chip"><Icon name="check-circle" weight="fill" /> {c}</li>)}</ul>
    <Fragment slot="visual">
      <div class="t-visual">
        <div class="frame frame--arch t-visual__frame">
          <Image src={art} alt="" widths={[420, 640]} sizes="(min-width: 960px) 420px, 80vw" loading="eager" />
        </div>
        <span class="glass t-badge t-badge--a"><Icon name="seal-check" weight="fill" /> <span><small>{C.badgeA[0]}</small>{C.badgeA[1]}</span></span>
        <span class="glass t-badge t-badge--b"><Icon name="graduation-cap" weight="fill" /> <span><small>{C.badgeB[0]}</small>{C.badgeB[1]}</span></span>
      </div>
    </Fragment>
  </PageHero>

  <section class="section section--tight" aria-labelledby="sanad-title">
    <div class="night-panel theme-night sanad-panel">
      <div class="stars"></div>
      <div class="container sanad-panel__inner">
        <div class="stack" style="--stack:16px" data-reveal>
          <span class="eyebrow" style="align-self:flex-start">{C.sanadKicker}</span>
          <h2 id="sanad-title">{C.sanadTitle}</h2>
          <p class="lead">{C.sanadText}</p>
          <p class="sanad-panel__note"><Icon name="seal-check" weight="fill" /> {C.sanadNote}</p>
        </div>
        <div class="glass sanad-panel__chain" data-reveal style="--reveal-delay:.1s">
          <SanadChain dark lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="faculty" aria-labelledby="leads-title">
    <div class="container">
      <div class="t-head" data-reveal>
        <h2 id="leads-title">{C.leadsTitle}</h2>
        <p class="lead">{C.leadsLede}</p>
      </div>
      <div class="stack" style="--stack: 20px">
        {teachers.map((tt, i) => <TeacherCard teacher={tt} lang={lang} delay={i * 0.05} />)}
      </div>
    </div>
  </section>

  <section class="section" id="process" aria-labelledby="process-title">
    <div class="container">
      <div class="t-head" data-reveal>
        <h2 id="process-title">{C.processTitle}</h2>
        <p class="lead">{C.processLede}</p>
      </div>
      <Steps items={C.process} />
      <p class="result" data-reveal>{C.result}</p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="principles-title">
    <div class="container">
      <figure class="quote" data-reveal>
        <blockquote>{C.quote}</blockquote>
        <figcaption>{C.quoteBy}</figcaption>
      </figure>
      <h2 id="principles-title" class="sr-only">{C.principlesTitle}</h2>
      <ol role="list" class="grid grid-3 principles">
        {
          C.principles.map(([h, p], i) => (
            <li class="principle" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
              <span class="principle__num">{ar ? ['١', '٢', '٣'][i] : `0${i + 1}`}</span>
              <h3>{h}</h3>
              <p>{p}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaPanel lang={lang} title={C.ctaTitle} lede={C.ctaLede} />
</BaseLayout>

<style>
  .t-visual {
    position: relative;
    width: min(100%, 420px);
    margin-inline: auto;
    padding: 20px 30px;
  }

  .t-visual__frame {
    aspect-ratio: 4 / 5;
  }

  .t-badge {
    --radius: 18px;
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    font-weight: 600;
    font-size: 0.95rem;
    animation: float-y 7s ease-in-out infinite;
  }

  .t-badge small {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  :global([dir='rtl']) .t-badge small {
    letter-spacing: 0;
    font-size: 0.8rem;
  }

  .t-badge :global(svg) {
    width: 26px;
    height: 26px;
    color: var(--accent-ink);
  }

  .t-badge--a {
    top: 14%;
    inset-inline-start: -4%;
  }

  .t-badge--b {
    bottom: 12%;
    inset-inline-end: -4%;
    animation-delay: -3s;
  }

  .sanad-panel {
    position: relative;
    padding-block: clamp(56px, 8vw, 104px);
  }

  .sanad-panel__inner {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .sanad-panel__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sanad-panel h2 {
    font-size: var(--fs-h2);
  }

  .sanad-panel__note {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--ink-2);
    font-weight: 560;
  }

  .sanad-panel__note :global(svg) {
    width: 20px;
    height: 20px;
    color: #e3c8ff;
  }

  .sanad-panel__chain {
    --radius: 30px;
    padding: clamp(28px, 4vw, 44px) clamp(16px, 3vw, 28px);
  }

  .t-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: clamp(24px, 3vw, 40px);
    max-width: 760px;
  }

  .t-head h2 {
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.8rem);
  }

  .result {
    margin-top: 28px;
    color: var(--ink-2);
    font-weight: 540;
  }

  .quote {
    margin: 0 auto clamp(40px, 5vw, 64px);
    max-width: 860px;
    text-align: center;
  }

  .quote blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.7rem, 1.2rem + 2vw, 2.8rem);
    line-height: 1.2;
  }

  :global([dir='rtl']) .quote blockquote {
    font-family: var(--font-quran);
    font-style: normal;
    line-height: 1.6;
  }

  .quote figcaption {
    margin-top: 18px;
    color: var(--ink-3);
  }

  .principles {
    list-style: none;
    padding: 0;
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 22px;
    border-top: 1px solid var(--line-strong);
  }

  .principle__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.8rem;
    color: var(--accent-ink);
    line-height: 1;
  }

  :global([dir='rtl']) .principle__num {
    font-family: var(--font-arabic);
    font-style: normal;
    font-weight: 700;
  }

  .principle h3 {
    font-size: 1.2rem;
  }

  .principle p {
    color: var(--ink-2);
  }
</style>
