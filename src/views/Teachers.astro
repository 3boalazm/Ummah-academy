---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import TeacherCard from '@/components/TeacherCard.astro';
import Steps from '@/components/Steps.astro';
import SanadChain from '@/components/SanadChain.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import art from '@/assets/art/track-islamic.jpg';
import { getTeachers } from '@/data/people';
import { lp, type Lang } from '@/i18n';
import { copy, ui } from '@/locales';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';
const t = ui(lang);
const teachers = getTeachers(lang);
const COPY = copy(lang).teachers;
const C = COPY.C;
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang}>
  <PageHero crumbs={[{ label: C.crumb }]} eyebrow={C.eyebrow} title={C.title} lede={C.lede} lang={lang}>
    <Fragment slot="actions">
      <a class="btn btn--primary" href={lp(lang, '/contact/') + '#book'}>{t.book2} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
      <a class="btn btn--glass" href="#process">{C.how}</a>
    </Fragment>
    <ul role="list" class="cluster">{C.chips.map((c) => <li class="chip"><Icon name="check-circle" weight="fill" /> {c}</li>)}</ul>
    <Fragment slot="visual">
      <div class="t-visual">
        <div class="frame frame--arch t-visual__frame">
          <Image src={art} alt="" widths={[420, 640]} sizes="(min-width: 960px) 420px, 80vw" loading="eager" />
        </div>
        <span class="glass t-badge t-badge--a"><Icon name="seal-check" weight="fill" /> <span><small>{C.badgeA[0]}</small>{C.badgeA[1]}</span></span>
        <span class="glass t-badge t-badge--b"><Icon name="graduation-cap" weight="fill" /> <span><small>{C.badgeB[0]}</small>{C.badgeB[1]}</span></span>
      </div>
    </Fragment>
  </PageHero>

  <section class="section section--tight" aria-labelledby="sanad-title">
    <div class="night-panel theme-night sanad-panel">
      <div class="stars"></div>
      <div class="container sanad-panel__inner">
        <div class="stack" style="--stack:16px" data-reveal>
          <span class="eyebrow" style="align-self:flex-start">{C.sanadKicker}</span>
          <h2 id="sanad-title">{C.sanadTitle}</h2>
          <p class="lead">{C.sanadText}</p>
          <p class="sanad-panel__note"><Icon name="seal-check" weight="fill" /> {C.sanadNote}</p>
        </div>
        <div class="glass sanad-panel__chain" data-reveal style="--reveal-delay:.1s">
          <SanadChain dark lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="faculty" aria-labelledby="leads-title">
    <div class="container">
      <div class="t-head" data-reveal>
        <h2 id="leads-title">{C.leadsTitle}</h2>
        <p class="lead">{C.leadsLede}</p>
      </div>
      <div class="stack" style="--stack: 20px">
        {teachers.map((tt, i) => <TeacherCard teacher={tt} lang={lang} delay={i * 0.05} />)}
      </div>
    </div>
  </section>

  <section class="section" id="process" aria-labelledby="process-title">
    <div class="container">
      <div class="t-head" data-reveal>
        <h2 id="process-title">{C.processTitle}</h2>
        <p class="lead">{C.processLede}</p>
      </div>
      <Steps items={C.process} />
      <p class="result" data-reveal>{C.result}</p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="principles-title">
    <div class="container">
      <figure class="quote" data-reveal>
        <blockquote>{C.quote}</blockquote>
        <figcaption>{C.quoteBy}</figcaption>
      </figure>
      <h2 id="principles-title" class="sr-only">{C.principlesTitle}</h2>
      <ol role="list" class="grid grid-3 principles">
        {
          C.principles.map(([h, p], i) => (
            <li class="principle" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
              <span class="principle__num">{ar ? ['١', '٢', '٣'][i] : `0${i + 1}`}</span>
              <h3>{h}</h3>
              <p>{p}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaPanel lang={lang} title={C.ctaTitle} lede={C.ctaLede} />
</BaseLayout>

<style>
  .t-visual {
    position: relative;
    width: min(100%, 420px);
    margin-inline: auto;
    padding: 20px 30px;
  }

  .t-visual__frame {
    aspect-ratio: 4 / 5;
  }

  .t-badge {
    --radius: 18px;
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    font-weight: 600;
    font-size: 0.95rem;
    animation: float-y 7s ease-in-out infinite;
  }

  .t-badge small {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  :global([dir='rtl']) .t-badge small {
    letter-spacing: 0;
    font-size: 0.8rem;
  }

  .t-badge :global(svg) {
    width: 26px;
    height: 26px;
    color: var(--accent-ink);
  }

  .t-badge--a {
    top: 14%;
    inset-inline-start: -4%;
  }

  .t-badge--b {
    bottom: 12%;
    inset-inline-end: -4%;
    animation-delay: -3s;
  }

  .sanad-panel {
    position: relative;
    padding-block: clamp(56px, 8vw, 104px);
  }

  .sanad-panel__inner {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .sanad-panel__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sanad-panel h2 {
    font-size: var(--fs-h2);
  }

  .sanad-panel__note {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--ink-2);
    font-weight: 560;
  }

  .sanad-panel__note :global(svg) {
    width: 20px;
    height: 20px;
    color: #e3c8ff;
  }

  .sanad-panel__chain {
    --radius: 30px;
    padding: clamp(28px, 4vw, 44px) clamp(16px, 3vw, 28px);
  }

  .t-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: clamp(24px, 3vw, 40px);
    max-width: 760px;
  }

  .t-head h2 {
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.8rem);
  }

  .result {
    margin-top: 28px;
    color: var(--ink-2);
    font-weight: 540;
  }

  .quote {
    margin: 0 auto clamp(40px, 5vw, 64px);
    max-width: 860px;
    text-align: center;
  }

  .quote blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.7rem, 1.2rem + 2vw, 2.8rem);
    line-height: 1.2;
  }

  :global([dir='rtl']) .quote blockquote {
    font-family: var(--font-quran);
    font-style: normal;
    line-height: 1.6;
  }

  .quote figcaption {
    margin-top: 18px;
    color: var(--ink-3);
  }

  .principles {
    list-style: none;
    padding: 0;
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 22px;
    border-top: 1px solid var(--line-strong);
  }

  .principle__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.8rem;
    color: var(--accent-ink);
    line-height: 1;
  }

  :global([dir='rtl']) .principle__num {
    font-family: var(--font-arabic);
    font-style: normal;
    font-weight: 700;
  }

  .principle h3 {
    font-size: 1.2rem;
  }

  .principle p {
    color: var(--ink-2);
  }
</style>
