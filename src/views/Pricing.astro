---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Faq from '@/components/Faq.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import { getPlans, getIncluded, perSession, paymentMethods } from '@/data/pricing';
import { trialLink } from '@/data/site';
import Money from '@/components/Money.astro';
import { num, type Lang } from '@/i18n';
import { copy, ui } from '@/locales';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = ui(lang);
const plans = getPlans(lang);
const included = getIncluded(lang);
const COPY = copy(lang).pricing;
const C = COPY.C;

const groups = [
  { minutes: 30 as const, title: C.g30, sub: C.g30s, list: plans.filter((p) => p.minutes === 30) },
  { minutes: 60 as const, title: C.g60, sub: C.g60s, list: plans.filter((p) => p.minutes === 60) },
];
// Plan tiles: tinted tones in rotation; the badged plan of each row is the deep featured tile.
const PLAN_TONES = ['lavender', 'sky', 'mauve'];
const ROW_TONES = ['lavender', 'sky', 'mauve', 'rose'];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: C.ldName,
  itemListElement: plans.map((p) => ({ '@type': 'Offer', name: `${p.name} — ${p.minutes} min × ${p.perWeek}/week`, price: p.price, priceCurrency: 'USD', category: 'subscription' })),
};
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang} jsonLd={ld}>
  <PageHero align="center" eyebrow={C.eyebrow} title={C.title} lede={C.lede} compact lang={lang}>
    <ul role="list" class="cluster ticks">{C.chips.map((c) => <li class="chip"><Icon name="check-circle" weight="fill" /> {c}</li>)}</ul>
  </PageHero>

  <!-- Plan finder: a dashboard panel — tinted choice tiles, a segmented pill bar, and a result card of stat tiles -->
  <section class="section section--tight" aria-labelledby="finder-title">
    <div class="container">
      <div class="finder" data-finder data-reveal>
        <div class="finder__controls">
          <h2 id="finder-title">{C.finderTitle}</h2>
          <fieldset class="finder__q">
            <legend><span class="finder__step" aria-hidden="true">{num(lang, '01')}</span> {C.q1}</legend>
            <div class="finder__len">
              {
                C.len.map(([v, l, s], i) => (
                  <label class:list={['choice', 'finder__lenopt', i ? 'tone--sky' : 'tone--lavender']}>
                    <input type="radio" name="len" value={v} checked={i === 0} />
                    <span class="choice__box">
                      <Icon name={v === '30' ? 'timer' : 'hourglass-medium'} />
                      <span>
                        {l}
                        <small>{s}</small>
                      </span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="finder__q">
            <legend><span class="finder__step" aria-hidden="true">{num(lang, '02')}</span> {C.q2}</legend>
            {
              groups.map((g) => (
                <div class="seg finder__freq" data-freq={g.minutes} hidden={g.minutes === 60}>
                  {g.list.map((p) => (
                    <label class="seg__opt">
                      <input type="radio" name={`freq-${g.minutes}`} value={p.id} checked={g.minutes === 30 ? p.id === 'consistent' : p.id === 'gold'} />
                      <span>{C.perWeek(p.perWeek)}</span>
                    </label>
                  ))}
                </div>
              ))
            }
          </fieldset>
        </div>
        <div class="finder__result" aria-live="polite">
          {
            plans.map((p) => (
              <article class="finder__plan" data-plan={p.id} hidden={p.id !== 'consistent'}>
                <div class="finder__head">
                  <p class="status finder__kicker">{C.result}</p>
                  <p class="finder__name">
                    {p.name} {p.badge && <span class="finder__badge">{p.badge}</span>}
                  </p>
                </div>
                <div class="finder__tiles">
                  <p class="finder__price tone tone--lavender">
                    <span class="finder__amount">
                      <Money usd={p.price} lang={lang} />
                    </span>
                    <small>{t.perMonth}</small>
                  </p>
                  <p class="finder__meta tone tone--sky">
                    <Icon name="calendar-blank" weight="bold" />
                    <span>
                      {p.sessionsLabel} · {num(lang, p.minutes)} {t.min}
                    </span>
                  </p>
                  <p class="finder__unit tone tone--mauve">
                    <Icon name="timer" weight="bold" />
                    <span>
                      {t.approx}<Money usd={perSession(p)} lang={lang} /> {C.perSession}
                    </span>
                  </p>
                </div>
                <p class="finder__best">{p.bestFor}</p>
                <a class="btn btn--primary btn--block" href={trialLink({ plan: p.canonical }, lang)} data-track="plan-finder">
                  {C.start} <Icon name="arrow-right" weight="bold" class="icon-arrow" />
                </a>
                <a class="finder__compare" href="#plans">
                  {C.compare} <Icon name="arrow-down" weight="bold" />
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- All plans: a row of plan tiles per session length, the badged plan as the deep featured tile -->
  <section class="section" id="plans" aria-label={C.allPlans}>
    <div class="container stack" style="--stack: clamp(40px, 6vw, 72px)">
      {
        groups.map((g) => (
          <div>
            <div class="plans-head" data-reveal>
              <div class="plans-head__title">
                <span class="status">
                  {num(lang, g.minutes)} {t.min}
                </span>
                <h2>{g.title}</h2>
              </div>
              <p class="lead">{g.sub}</p>
            </div>
            <div class="plans-row">
              {g.list.map((p, i) => (
                <article
                  class:list={['plan', 'tone', p.badge ? ['tone--deep', 'tone--grad-plum', 'plan--featured'] : `tone--${PLAN_TONES[i % PLAN_TONES.length]}`]}
                  data-reveal
                  style={`--reveal-delay:${i * 0.06}s`}
                >
                  <div class="plan__top">
                    <h3 class="plan__name">{p.name}</h3>
                    {p.badge && <span class="status plan__badge">{p.badge}</span>}
                  </div>
                  <p class="plan__price">
                    <span class="plan__amount">
                      <Money usd={p.price} lang={lang} />
                    </span>
                    <small>{t.perMonth}</small>
                  </p>
                  <p class="plan__unit">
                    {t.approx}<Money usd={perSession(p)} lang={lang} /> {C.perSession}
                  </p>
                  <p class="plan__meta">
                    <Icon name="calendar-blank" weight="bold" /> {p.sessionsLabel}
                  </p>
                  <p class="plan__best">{p.bestFor}</p>
                  <a class:list={['btn', 'btn--block', p.badge ? 'btn--primary' : 'btn--glass']} href={trialLink({ plan: p.canonical }, lang)}>
                    {C.choose} <Icon name="arrow-right" weight="bold" class="icon-arrow" />
                  </a>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Every plan includes: tinted rows, with the payment methods card beside the heading -->
  <section class="section section--tight" aria-labelledby="incl-title">
    <div class="container incl">
      <div class="incl__head" data-reveal>
        <h2 id="incl-title" class="block-title">{C.incl}</h2>
        <div class="pay">
          <span class="pay__icon" aria-hidden="true"><Icon name="credit-card" /></span>
          <p class="pay__title">{C.pay}</p>
          <p class="pay__note">{C.payNote}</p>
          <ul role="list" class="pay__chips">{paymentMethods(lang).map((m) => <li class="status status--ghost">{m}</li>)}</ul>
        </div>
      </div>
      <ul role="list" class="incl__rows">
        {
          included.map((f, i) => (
            <li class:list={['incl__row', 'tone', `tone--${ROW_TONES[i % ROW_TONES.length]}`]} data-reveal style={`--reveal-delay:${Math.min(i, 6) * 0.04}s`}>
              <span class="incl__icon" aria-hidden="true">
                <Icon name={f.icon} />
              </span>
              <span class="incl__text">
                <strong>{f.title}</strong>
                <span set:html={f.desc} />
              </span>
              <Icon name="check-circle" weight="fill" class="incl__check" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="pfaq-title">
    <div class="container faq-split">
      <div class="faq-split__head" data-reveal>
        <h2 id="pfaq-title" class="block-title">{C.faqTitle}</h2>
      </div>
      <Faq items={C.faq} />
    </div>
  </section>

  <CtaPanel lang={lang} title={C.ctaTitle} lede={C.ctaLede} />
</BaseLayout>

<script>
  import { track } from '@/scripts/analytics';
  const box = document.querySelector<HTMLElement>('[data-finder]');
  if (box) {
    const update = () => {
      const len = box.querySelector<HTMLInputElement>('input[name="len"]:checked')?.value || '30';
      box.querySelectorAll<HTMLElement>('[data-freq]').forEach((f) => (f.hidden = f.dataset.freq !== len));
      const id = box.querySelector<HTMLInputElement>(`input[name="freq-${len}"]:checked`)?.value;
      box.querySelectorAll<HTMLElement>('[data-plan]').forEach((p) => (p.hidden = p.dataset.plan !== id));
      return { len, id };
    };
    box.addEventListener('change', () => {
      const { len, id } = update();
      track('plan_finder_change', { minutes: len, plan: id });
    });
    update();
  }
</script>

<style>
  .ticks {
    justify-content: center;
  }

  .ticks :global(svg) {
    color: var(--success);
  }

  /* ── Plan finder: dashboard panel ─────────────────────────── */
  .finder {
    display: grid;
    gap: clamp(14px, 2vw, 20px);
    padding: clamp(14px, 2.4vw, 22px);
    border-radius: clamp(28px, 3vw, 40px);
    background: var(--surface);
  }

  @media (min-width: 900px) {
    .finder {
      grid-template-columns: 1.15fr 1fr;
      align-items: stretch;
    }
  }

  .finder__controls {
    display: flex;
    flex-direction: column;
    gap: 26px;
    min-width: 0;
    padding: clamp(18px, 2.6vw, 30px);
    border-radius: 28px;
    background: var(--card);
    border: 1px solid var(--card-line);
  }

  .finder__controls h2 {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) .finder__controls h2 {
    line-height: 1.4;
  }

  .finder__q {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    min-width: 0;
  }

  .finder__q legend {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0;
    margin-bottom: 12px;
    font-weight: 600;
  }

  .finder__step {
    display: inline-grid;
    place-items: center;
    flex: none;
    min-width: 34px;
    height: 34px;
    padding-inline: 6px;
    border-radius: var(--r-pill);
    font-size: 0.8rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    color: var(--accent-ink);
    background: var(--tint-lavender);
  }

  .finder__len {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr 1fr;
  }

  @media (max-width: 480px) {
    .finder__len {
      grid-template-columns: 1fr;
    }
  }

  /* tinted choice tiles (the tone class on the label carries --tone-bg / --tone-dot) */
  .finder__lenopt .choice__box {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
    padding: 18px;
    border-radius: 22px;
    background: var(--tone-bg);
    box-shadow: none;
    overflow-wrap: anywhere;
  }

  .finder__lenopt .choice__box :global(svg) {
    box-sizing: content-box;
    width: 22px;
    height: 22px;
    padding: 10px;
    border-radius: 50%;
    color: var(--tone-dot);
    background: var(--card);
  }

  .finder__lenopt input:hover + .choice__box {
    background: var(--tone-bg);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .finder__lenopt input:checked + .choice__box {
    background: var(--tone-bg);
    box-shadow:
      inset 0 0 0 2px var(--accent),
      0 14px 28px -20px rgb(44 28 68 / 0.6);
  }

  /* segmented pill bar */
  .finder__freq {
    display: inline-flex;
    flex-wrap: wrap;
    align-self: flex-start;
    gap: 4px;
    max-width: 100%;
    padding: 5px;
    border-radius: 26px;
    background: var(--tint-mist);
    border: 1px solid var(--card-line);
  }

  .finder__freq .seg__opt span {
    min-height: 42px;
    padding: 0 18px;
    background: transparent;
    box-shadow: none;
    font-variant-numeric: tabular-nums;
  }

  .finder__freq .seg__opt input:hover + span {
    background: var(--card);
  }

  .finder__freq .seg__opt input:checked + span {
    color: #fff;
    background: var(--brand-ink);
    box-shadow: 0 10px 20px -12px rgb(44 28 68 / 0.8);
  }

  :global([data-theme='dark']) .finder__freq .seg__opt input:checked + span {
    color: var(--brand-ink);
    background: #efe7f8;
  }

  /* result card */
  .finder__result {
    display: flex;
    min-width: 0;
  }

  .finder__plan {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: clamp(18px, 2.6vw, 28px);
    border-radius: 28px;
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--card-line);
    box-shadow: var(--shadow-soft);
  }

  .finder__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .finder__kicker {
    background: var(--tint-lavender);
    border-color: transparent;
  }

  .finder__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  :global([dir='rtl']) .finder__name {
    letter-spacing: 0;
  }

  .finder__badge,
  .plan__badge {
    font-size: 0.76rem;
    white-space: normal;
  }

  .finder__badge {
    padding: 4px 11px;
    border-radius: var(--r-pill);
    font-weight: 650;
    letter-spacing: 0;
    color: #fff;
    background: var(--grad-plum);
  }

  .finder__tiles {
    display: grid;
    gap: 10px;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }

  .finder__tiles > p {
    min-width: 0;
    margin: 0;
    padding: 16px;
    border-radius: 22px;
  }

  .finder__price {
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
  }

  .finder__amount,
  .plan__amount {
    display: block;
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .finder__amount {
    font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem);
  }

  :global([dir='rtl']) .finder__amount,
  :global([dir='rtl']) .plan__amount {
    letter-spacing: 0;
  }

  .finder__price small {
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .finder__meta,
  .finder__unit {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 560;
    line-height: 1.35;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  .finder__meta :global(svg),
  .finder__unit :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--tone-dot);
  }

  @media (max-width: 400px) {
    .finder__tiles {
      grid-template-columns: 1fr;
    }

    .finder__price {
      grid-row: auto;
    }
  }

  .finder__best {
    color: var(--ink-2);
    margin-block: 2px 6px;
  }

  .finder__plan .btn {
    margin-top: auto;
  }

  .finder__compare {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    align-self: center;
    font-size: 0.88rem;
    font-weight: 560;
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
  }

  .finder__compare :global(svg) {
    width: 14px;
    height: 14px;
  }

  /* ── Plan rows ────────────────────────────────────────────── */
  .plans-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 24px;
    margin-bottom: 22px;
  }

  .plans-head__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
  }

  .plans-head h2 {
    font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.6rem);
    line-height: 1.08;
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) .plans-head h2 {
    line-height: 1.4;
  }

  .plans-head .lead {
    font-size: 1rem;
    max-width: 46ch;
  }

  .plans-row {
    display: grid;
    gap: 14px;
    align-items: stretch;
  }

  @media (min-width: 760px) {
    .plans-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: clamp(20px, 2.4vw, 28px);
    border-radius: 30px;
  }

  .plan--featured {
    box-shadow: var(--shadow-lift);
  }

  @media (min-width: 760px) {
    .plan--featured {
      margin-block: -10px;
      padding-block: calc(clamp(20px, 2.4vw, 28px) + 10px);
    }
  }

  .plan__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .plan__name {
    font-size: 1.35rem;
    overflow-wrap: anywhere;
  }

  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    margin-top: 10px;
  }

  .plan__amount {
    font-size: clamp(2.8rem, 2.1rem + 2.4vw, 4rem);
  }

  .plan__price small {
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .plan__unit {
    font-size: 0.88rem;
    color: var(--ink-2);
    margin-top: -2px;
  }

  .plan__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--line-strong);
    font-weight: 560;
    color: var(--ink);
  }

  .plan--featured .plan__meta {
    border-top-color: rgb(255 255 255 / 0.2);
  }

  .plan__meta :global(svg) {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--tone-dot);
  }

  .plan__best {
    color: var(--ink-2);
    margin-block: 2px 14px;
  }

  .plan .btn {
    margin-top: auto;
  }

  .block-title {
    font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.6rem);
    line-height: 1.08;
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) .block-title {
    line-height: 1.4;
  }

  /* ── Included: tinted rows ────────────────────────────────── */
  .incl {
    display: grid;
    gap: 22px;
    align-items: start;
  }

  @media (min-width: 960px) {
    .incl {
      grid-template-columns: 0.8fr 1.6fr;
    }

    .incl__head {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }

  .incl__head {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  .incl__rows {
    display: grid;
    gap: 10px;
  }

  @media (min-width: 640px) {
    .incl__rows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .incl__row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
    padding: 16px 18px;
    border-radius: 22px;
  }

  .incl__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: var(--tone-dot);
    background: var(--card);
  }

  :global([data-theme='dark']) .incl__icon {
    background: rgb(255 255 255 / 0.08);
  }

  .incl__icon :global(svg) {
    width: 21px;
    height: 21px;
  }

  .incl__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
    font-size: 0.92rem;
    color: var(--ink-2);
  }

  .incl__text strong {
    font-size: 1rem;
    font-weight: 620;
    color: var(--ink);
  }

  .incl__row :global(.incl__check) {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    color: var(--success);
  }

  .pay {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 20px;
    border-radius: 24px;
    background: var(--card);
    border: 1px solid var(--card-line);
  }

  .pay__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: 4px;
    border-radius: 50%;
    color: var(--accent-ink);
    background: var(--tint-lavender);
  }

  .pay__icon :global(svg) {
    width: 21px;
    height: 21px;
  }

  .pay__title {
    font-weight: 620;
    font-size: 1.1rem;
  }

  .pay__note {
    font-size: 0.92rem;
    color: var(--ink-2);
  }

