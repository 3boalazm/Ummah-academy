---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { getTestimonials } from '@/data/reviews';
import { trialLink, waLink } from '@/data/site';
import { type Lang } from '@/i18n';
import { copy, ui } from '@/locales';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = ui(lang);
const C = copy(lang).reviews.C;
const stories = getTestimonials(lang);
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang}>
  <PageHero eyebrow={C.eyebrow} title={C.title} lede={C.lede} crumbs={[{ label: C.crumb }]} compact lang={lang} />
  <section class="section section--tight">
    <div class="container">
      <ul role="list" class="grid grid-2">
        {stories.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${i * 0.04}s`}>
            <TestimonialCard t={s} lang={lang} />
          </li>
        ))}
      </ul>
      {C.note && <p class="muted reviews-note">{C.note}</p>}
    </div>
  </section>
  <CtaPanel lang={lang} eyebrow={t.ctaEyebrow} title={t.book2} lede="" primary={{ label: t.book2, href: trialLink({}, lang) }} secondary={{ label: t.whatsapp, href: waLink() }} ticks={t.ctaTicks} />
</BaseLayout>

<style>
  .reviews-note {
    margin-top: 24px;
  }
</style>
