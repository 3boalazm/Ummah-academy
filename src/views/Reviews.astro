---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { getTestimonials } from '@/data/reviews';
import { trialLink, waLink } from '@/data/site';
import { type Lang } from '@/i18n';
import { copy, ui } from '@/locales';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = ui(lang);
const C = copy(lang).reviews.C;
const stories = getTestimonials(lang);
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang}>
  <PageHero eyebrow={C.eyebrow} title={C.title} lede={C.lede} crumbs={[{ label: C.crumb }]} compact lang={lang} />
  <section class="section section--tight">
    <div class="container">
      <!-- A wall of event-style story cards: pastel tones by programme, with a deep anchor card or two -->
      <ul role="list" class="story-wall">
        {stories.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${Math.min(i, 8) * 0.04}s`}>
            <TestimonialCard t={s} lang={lang} tone={i === 0 ? 'grad-plum' : i === 5 ? 'ink' : undefined} />
          </li>
        ))}
      </ul>
      {C.note && <p class="muted reviews-note">{C.note}</p>}
    </div>
  </section>
  <CtaPanel lang={lang} eyebrow={t.ctaEyebrow} title={t.book2} lede="" primary={{ label: t.book2, href: trialLink({}, lang) }} secondary={{ label: t.whatsapp, href: waLink() }} ticks={t.ctaTicks} />
</BaseLayout>

<style>
  /* masonry wall: cards keep their natural height and stack in columns */
  .story-wall {
    columns: 3 300px;
    column-gap: clamp(14px, 1.6vw, 20px);
  }

  .story-wall > li {
    break-inside: avoid;
    margin-bottom: clamp(14px, 1.6vw, 20px);
  }

  .story-wall > li :global(.tcard) {
    height: auto;
  }

  .reviews-note {
    margin-top: 24px;
  }
</style>
