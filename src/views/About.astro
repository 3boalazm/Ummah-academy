---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import art from '@/assets/art/teacher-welcome.webp';
import { lp, num, type Lang } from '@/i18n';
import { copy, ui } from '@/locales';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = ui(lang);
const COPY = copy(lang).about;
const C = COPY.C;

const pad = (n: number) => num(lang, String(n).padStart(2, '0'));
const TONES = ['lavender', 'sky', 'mauve', 'rose'];
const STAT_TONES = ['sky', 'mauve', 'lavender', 'rose'];
const STAT_ICONS = ['globe-hemisphere-west', 'users-three', 'chalkboard-teacher', 'certificate'];
// Values: each card closes with an underlined link to where the value is explained.
const VALUE_LINKS = ['#method-title', lp(lang, '/courses/'), '#ummah-title'];
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang}>
  <PageHero eyebrow={C.eyebrow} title={C.title} lede={C.lede} lang={lang}>
    <Fragment slot="actions">
      <a class="btn btn--primary" href={lp(lang, '/contact/') + '#book'}>{t.book2} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
      <a class="btn btn--glass" href={lp(lang, '/teachers/')}>{t.nav.teachers}</a>
    </Fragment>
    <Fragment slot="visual">
      <div class="a-visual">
        <div class="frame frame--arch a-visual__frame">
          <Image src={art} alt="" widths={[420, 640]} sizes="(min-width: 960px) 420px, 80vw" loading="eager" />
        </div>
        <div class="glass a-card a-card--a"><small>{C.cardA[0]}</small><strong>{C.cardA[1]}</strong></div>
        <div class="glass a-card a-card--b"><strong class="a-card__big">{C.cardB[0]}</strong><small>{C.cardB[1]}</small></div>
      </div>
    </Fragment>
  </PageHero>

  <!-- Mission: a large statement, then a bento of the name, the figures and Al-Azhar -->
  <section class="section" aria-labelledby="vision-title">
    <div class="container">
      <div class="mission" data-reveal>
        <span class="eyebrow">{C.visionKicker}</span>
        <h2 id="vision-title" class="mission__title" set:html={C.visionTitle} />
        <p class="lead mission__lede">{C.vision}</p>
      </div>

      <div class="ab">
        <article class="ab__deep tone tone--deep tone--grad-plum" aria-labelledby="ummah-title" data-reveal>
          <span class="status">{C.meaningKicker}</span>
          <div class="ab__deep-copy">
            <h2 id="ummah-title">{C.meaningTitle}</h2>
            <p>{C.meaning}</p>
          </div>
          <span class="ab__word quranic" aria-hidden="true">أُمَّة</span>
        </article>

        {
          C.stats.map(([n, l], i) => (
            <div class:list={['stat-tile', 'tone', `tone--${STAT_TONES[i % 4]}`, 'ab__stat', `ab__stat--${i + 1}`]} data-reveal style={`--reveal-delay:${0.04 + i * 0.04}s`}>
              <Icon name={STAT_ICONS[i % 4]} weight="duotone" class="ab__stat-icon" />
              <span>
                <span class="stat-tile__num">{n}</span>
                <span class="stat-tile__label">{l}</span>
              </span>
            </div>
          ))
        }

        <a class="ab__feat tone tone--sky" href={lp(lang, '/teachers/')} data-reveal style="--reveal-delay:.1s">
          <ul role="list" class="ab__tags">
            {C.azharList.map((x, i) => <li class:list={['ab__tag', { 'ab__tag--on': i === 0 }]}>{x}</li>)}
          </ul>
          <span class="ab__feat-body">
            <span class="ab__feat-copy">
              <h2 id="azhar-title">{C.azharTitle}</h2>
              <span class="ab__feat-text">{C.azhar}</span>
            </span>
            <span class="ab__feat-arrow" aria-hidden="true"><Icon name="arrow-up-right" weight="light" /></span>
          </span>
        </a>

        <article class="ab__cert" data-reveal style="--reveal-delay:.14s">
          <span class="icon-badge"><Icon name="certificate" /></span>
          <h3>{C.certTitle}</h3>
          <p>{C.cert}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Values: pastel cards with status pills and underlined links -->
  <section class="section section--tight" aria-label={C.visionKicker}>
    <div class="container">
      <ul role="list" class="vals">
        {
          C.values.map((v, i) => (
            <li class:list={['val', 'tone', `tone--${TONES[i % 4]}`]} data-reveal style={`--reveal-delay:${i * 0.06}s`}>
              <span class="val__shape val__shape--a" aria-hidden="true"></span>
              <span class="val__shape val__shape--b" aria-hidden="true"></span>
              <span class="status">{pad(i + 1)}</span>
              <span class="val__icon" aria-hidden="true"><Icon name={v.icon} weight="duotone" /></span>
              <h3>{v.title}</h3>
              <p set:html={v.text} />
              <a class="link-arrow val__link" href={VALUE_LINKS[i] ?? lp(lang, '/courses/')}>
                {t.learnMore} <Icon name="arrow-right" weight="bold" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Story: numbered cards on a dotted path -->
  <section class="section" aria-labelledby="journey-title">
    <div class="container">
      <div class="head" data-reveal>
        <h2 id="journey-title" class="block-title">{C.journeyTitle}</h2>
      </div>
      <ol role="list" class="path" aria-label={C.journeyTitle}>
        {
          C.journey.map(([y, tag, text], i) => (
            <li class:list={['num-card', 'tone', `tone--${TONES[i % 4]}`, 'path__card', { 'path__card--now': i === C.journey.length - 1 }]} data-reveal style={`--reveal-delay:${i * 0.06}s`}>
              <span class="path__dot" aria-hidden="true"></span>
              <span class="num-card__num path__year">{y}</span>
              <span class="status">{tag}</span>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="diff-title">
    <div class="container">
      <h2 id="diff-title" class="block-title" data-reveal>{C.diffTitle}</h2>
      <div class="table-wrap diff" data-reveal>
        <table class="table">
          <thead>
            <tr>{C.diffCols.map((c, i) => <th scope="col" class:list={{ diff__us: i === 1 }}>{c || <span class="sr-only">{C.aspect}</span>}</th>)}</tr>
          </thead>
          <tbody>
            {
              C.diff.map(([a, us, them]) => (
                <tr>
                  <th scope="row">{a}</th>
                  <td class="diff__us">
                    <Icon name="check-circle" weight="fill" class="diff__yes" /> {us}
                  </td>
                  <td>{them}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Method: numbered cards, the first one featured -->
  <section class="section" aria-labelledby="method-title">
    <div class="container">
      <h2 id="method-title" class="block-title" data-reveal>{C.methodTitle}</h2>
      <ol role="list" class="mt">
        {
          C.method.map((m, i) => (
            <li class:list={['num-card', 'mt__card', i === 0 ? 'tone tone--dawn mt__card--feat' : `tone tone--${TONES[i % 4]}`]} data-reveal style={`--reveal-delay:${i * 0.05}s`}>
              <span class="mt__top">
                <span class="num-card__num">{pad(i + 1)}.</span>
                <span class="mt__icon" aria-hidden="true"><Icon name={m.icon} weight="duotone" /></span>
              </span>
              <h3>{m.title}</h3>
              <p set:html={m.text} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaPanel lang={lang} title={C.ctaTitle} lede={C.ctaLede} />
</BaseLayout>

<style>
  .block-title {
    font-size: clamp(1.9rem, 1.3rem + 2.2vw, 3rem);
    line-height: 1.08;
    margin-bottom: clamp(22px, 3vw, 36px);
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) .block-title {
    line-height: 1.4;
  }

  /* ── Hero visual ─────────────────────────────────────────── */
  .a-visual {
    position: relative;
    width: min(100%, 420px);
    margin-inline: auto;
    padding: 20px 30px 40px;
  }

  .a-visual__frame {
    aspect-ratio: 4 / 5;
  }

  .a-card {
    --radius: 20px;
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 18px;
    max-width: 230px;
    border-radius: 20px;
    box-shadow: var(--shadow-soft);
    animation: float-y 8s ease-in-out infinite;
  }

  .a-card small {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .a-card strong {
    font-weight: 600;
    line-height: 1.3;
  }

  .a-card__big {
    font-size: 2rem;
    font-weight: 400 !important;
    letter-spacing: -0.04em;
    color: var(--brand-plum);
  }

  :global([data-theme='dark']) .a-card__big {
    color: #dcc4f2;
  }

  .a-card--a {
    top: 12%;
    inset-inline-start: -6%;
  }

  .a-card--b {
    bottom: 8%;
    inset-inline-end: -6%;
    animation-delay: -4s;
  }

  @media (max-width: 480px) {
    .a-card--a {
      inset-inline-start: -10px;
    }

    .a-card--b {
      inset-inline-end: -10px;
    }
  }

  /* ── Mission statement ───────────────────────────────────── */
  .mission {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 980px;
    margin-bottom: clamp(32px, 5vw, 60px);
  }

  .mission__title {
    font-size: clamp(2.3rem, 1.3rem + 4vw, 4.8rem);
    line-height: 1.02;
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) .mission__title {
    line-height: 1.35;
  }

  .mission__lede {
    max-width: 68ch;
  }

  /* ── Bento ───────────────────────────────────────────────── */
  .ab {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ab__deep,
  .ab__feat,
  .ab__cert {
    grid-column: 1 / -1;
  }

  @media (min-width: 1000px) {
    .ab {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-areas:
        'deep deep s1 s2'
        'deep deep s3 s4'
        'feat feat feat cert';
    }

    .ab__deep { grid-area: deep; }
    .ab__stat--1 { grid-area: s1; }
    .ab__stat--2 { grid-area: s2; }
    .ab__stat--3 { grid-area: s3; }
    .ab__stat--4 { grid-area: s4; }
    .ab__feat { grid-area: feat; }
    .ab__cert { grid-area: cert; }
  }

  .ab__deep {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    min-height: 320px;
    padding: clamp(24px, 3vw, 38px);
    border-radius: 32px;
  }

  .ab__deep-copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 46ch;
  }

  .ab__deep h2 {
    font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.6rem);
    line-height: 1.1;
    color: #fff;
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) .ab__deep h2 {
    line-height: 1.4;
  }

  .ab__deep p {
    color: var(--ink-2);
  }

  .ab__word {
    position: absolute;
    z-index: -1;
    inset-block-start: 8%;
    inset-inline-end: 4%;
    font-size: clamp(5rem, 12vw, 9rem);
    line-height: 1;
    color: rgb(255 255 255 / 0.1);
    pointer-events: none;
  }

  .ab__stat {
    min-width: 0;
  }

  .ab__stat :global(.ab__stat-icon) {
    width: 28px;
    height: 28px;
    color: var(--tone-dot);
  }

  .ab__stat .stat-tile__num {
    font-size: clamp(1.8rem, 1.2rem + 2.4vw, 3.2rem);
    overflow-wrap: anywhere;
  }

  .ab__feat {
    display: flex;
    flex-direction: column;
    gap: clamp(22px, 3vw, 34px);
    padding: clamp(22px, 3vw, 34px);
    border-radius: 32px;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.3s;
  }

  .ab__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ab__tag {
    padding: 0.42em 0.95em;
    border-radius: var(--r-pill);
    font-size: 0.84rem;
    font-weight: 540;
    line-height: 1.3;
    border: 1px solid color-mix(in srgb, var(--brand-ink) 40%, transparent);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ab__tag--on {
    color: #fff;
    background: var(--brand-ink);
    border-color: var(--brand-ink);
  }

  :global([data-theme='dark']) .ab__tag {
    border-color: rgb(255 255 255 / 0.3);
  }

  :global([data-theme='dark']) .ab__tag--on {
    color: var(--brand-ink);
    background: #efe7f8;
    border-color: #efe7f8;
  }

  .ab__feat-body {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }

  .ab__feat-copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .ab__feat h2 {
    font-size: clamp(1.8rem, 1.2rem + 2.2vw, 3rem);
    line-height: 1.05;
    padding-bottom: 16px;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) .ab__feat h2 {
    line-height: 1.4;
  }

  .ab__feat-text {
    max-width: 60ch;
    color: var(--ink-2);
  }

  .ab__feat-arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(56px, 7vw, 92px);
    height: clamp(56px, 7vw, 92px);
    color: var(--ink);
    transition: transform 0.4s var(--ease-out);
  }

  .ab__feat-arrow :global(svg) {
    width: 100%;
    height: 100%;
  }

  :global([dir='rtl']) .ab__feat-arrow :global(svg) {
    transform: scaleX(-1);
  }

  .ab__feat:hover .ab__feat-arrow {
    transform: translate(4px, -4px);
  }

  :global([dir='rtl']) .ab__feat:hover .ab__feat-arrow {
    transform: translate(-4px, -4px);
  }

  .ab__cert {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 26px;
    border-radius: 32px;
    background: var(--card);
    border: 1px solid var(--card-line);
    box-shadow: var(--shadow-soft);
  }

  .ab__cert h3 {
    font-size: 1.2rem;
  }

  .ab__cert p {
    color: var(--ink-2);
  }

  /* ── Values (pastel cards) ───────────────────────────────── */
  .vals {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .val {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    min-height: 320px;
    padding: clamp(22px, 3vw, 32px);
    border-radius: 30px;
  }

  .val__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-top: auto;
    border-radius: 16px;
    color: var(--tone-dot);
    background: var(--card);
  }

  .val__icon :global(svg) {
    width: 26px;
    height: 26px;
  }

  .val h3 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  :global([dir='rtl']) .val h3 {
    letter-spacing: 0;
  }

  .val p {
    color: var(--ink-2);
    max-width: 34ch;
  }

  .val__link {
    margin-top: 6px;
    font-size: 0.95rem;
  }

  .val__shape {
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--tone-dot) 50%, transparent), transparent 78%);
    opacity: 0.4;
    pointer-events: none;
  }

  .val__shape--a {
    width: 150px;
    height: 220px;
    inset-block-start: -50px;
    inset-inline-end: -40px;
    rotate: 28deg;
  }

  .val__shape--b {
    width: 110px;
    height: 110px;
    inset-block-start: 110px;
    inset-inline-end: 30px;
  }

  /* ── Story: numbered cards on a dotted path ──────────────── */
  .path {
    position: relative;
    display: grid;
    gap: 14px;
    padding-inline-start: 34px;
  }

  /* phones and tablets: a vertical dotted line along the start edge */
  .path::before {
    content: '';
    position: absolute;
    inset-block: 24px;
    inset-inline-start: 9px;
    border-inline-start: 2px dotted color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .path__card {
    border: 0;
    background: var(--tone-bg);
    min-width: 0;
  }

  .path__dot {
    position: absolute;
    inset-block-start: 30px;
    inset-inline-start: -31px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--tone-dot);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--tone-dot) 18%, transparent);
  }

  .path__year {
    font-size: clamp(2.2rem, 1.8rem + 1.6vw, 3.2rem);
  }

  :global([dir='rtl']) .path__year {
    letter-spacing: 0;
  }

  .path__card .status {
    align-self: flex-start;
  }

  .path__card p {
    color: var(--ink-2);
    font-size: 0.97rem;
  }

  .path__card--now {
    background: var(--grad-dawn);
  }

  @media (min-width: 1100px) {
    .path {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      padding-inline-start: 0;
      padding-top: 34px;
    }

    .path::before {
      inset-block: 9px auto;
      inset-inline: 30px;
      border-inline-start: 0;
      border-top: 2px dotted color-mix(in srgb, var(--accent) 50%, transparent);
    }

    .path__dot {
      inset-block-start: -31px;
      inset-inline-start: 26px;
    }

    .path__card:nth-child(even) {
      margin-top: 36px;
    }

    /* the dot stays on the dotted line when the card steps down */
    .path__card:nth-child(even) .path__dot {
      inset-block-start: -67px;
    }
  }

  /* ── Comparison table ────────────────────────────────────── */
  .diff {
    padding: 8px;
    border-radius: 30px;
    background: var(--tint-mist);
  }

  .diff td {
    color: var(--ink-2);
  }

  .diff td.diff__us {
    color: var(--ink);
    font-weight: 520;
    background: var(--tint-lavender);
  }

  .diff thead .diff__us {
    color: var(--accent-ink);
  }

  .diff td :global(svg) {
    display: inline-block;
    width: 18px;
    height: 18px;
    vertical-align: -3px;
    margin-inline-end: 6px;
    color: var(--success);
  }

  /* ── Method: numbered cards, the first featured ──────────── */
  .mt {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }

  @media (min-width: 1000px) {
    .mt {
      grid-template-columns: 1.5fr repeat(3, minmax(0, 1fr));
    }

    .mt__card--feat {
      min-height: 340px;
    }
  }

  .mt__card {
    border: 0;
    min-width: 0;
  }

  .mt__card:not(.mt__card--feat) {
    background: var(--tone-bg);
  }

  .mt__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: auto;
    padding-bottom: 22px;
  }

  .mt__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--tone-dot);
    background: var(--card);
  }

  .mt__icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .mt__card h3 {
    font-size: 1.15rem;
  }

  .mt__card--feat h3 {
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
    font-weight: 500;
  }

  .mt__card p {
    color: var(--ink-2);
    font-size: 0.97rem;
  }
</style>
