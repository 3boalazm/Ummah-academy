---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import art from '@/assets/art/hero-arch.jpg';
import { ui, lp, type Lang } from '@/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';
const t = ui(lang);
const C = ar
  ? {
      meta: { title: 'من نحن | قصة أكاديمية الأمة ورسالتها', desc: 'تأسسنا على قناعة واحدة: كل مسلم يستحق تعليمًا قرآنيًا أصيلًا أينما كان. قصتنا ورؤيتنا ومنهج الإتقان وما يميزنا.' },
      eyebrow: 'من نحن',
      title: 'التعليم القرآني الأصيل <span class="accent">لا ينبغي أن يرتبط بمكان سكنك.</span>',
      lede: 'تأسست أكاديمية الأمة على قناعة واحدة: أن كل مسلم يستحق تعليمًا قرآنيًا أصيلًا أينما كان. نحمل تراث الأزهر الممتد لألف عام إلى الأسر التي تحتاج إلى المرونة.',
      cardA: ['أسرتنا التعليمية', 'أكثر من ١٠٠ معلم من الأزهر'],
      cardB: ['+١٠٠٠', 'عام من تراث الأزهر العلمي'],
      visionKicker: 'رؤيتنا',
      visionTitle: 'أن يعود كل مسلم إلى <span class="accent">كتاب الله.</span>',
      vision: 'ليس للتلاوة المظهرية، بل للإتقان الحقيقي، والتدبّر العميق، والصلة الصادقة بكلام الله. فالعلم الشرعي الأصيل لا يجوز أن يكون امتيازًا جغرافيًا — في لندن أو تورونتو أو سيدني أو دبي، تستحق جودة التعليم نفسها التي حفظها الأزهر أكثر من ألف عام.',
      values: [
        { icon: 'diamond', title: 'الإتقان', text: 'نعلّم للإحكام والرسوخ، لا لعرض المعرفة على السطح.' },
        { icon: 'lightbulb', title: 'التدبّر', text: 'كل حصة تصل الطالب بالمعنى العميق لما يتعلمه.' },
        { icon: 'globe-hemisphere-east', title: 'للأمة كلها', text: 'اسمنا وعدنا: نخدم الأمة بأكملها أينما كانت.' },
      ],
      journeyTitle: 'كيف بدأنا',
      journey: [
        ['٢٠٢٢', 'البذرة', 'لاحظ مؤسسنا أن الأسر المسلمة في الغرب تعاني للعثور على معلمين مؤهلين — بين متطوعين غير معتمدين ومدارس مكلفة بمواعيد جامدة.'],
        ['٢٠٢٣', 'الحل', 'بدأنا الاستقطاب مباشرة من جامعة الأزهر، مع التركيز على العلماء حاملي الإجازات بأسانيد موثّقة.'],
        ['٢٠٢٤', 'الانطلاق', 'انطلقنا بـ ٢٠ معلمًا و١٥٠ طالبًا في ١٢ دولة، ومُنحت أول إجازة لطالب في المملكة المتحدة خلال العام الأول.'],
        ['٢٠٢٥', 'النمو', 'توسعنا إلى أكثر من ١٠٠ معلم و١٠٠٠ طالب في أكثر من ٥٠ دولة، وأطلقنا برنامج أشبال الأمة.'],
        ['٢٠٢٦', 'اليوم', 'أكثر من ٤٠٠ ساعة تدريس مباشرة شهريًا، وأكثر من ١٢ إجازة، وبوابة للأسرة.'],
      ],
      meaningKicker: 'اسمنا رسالتنا',
      meaningTitle: 'ماذا تعني «الأمة»؟',
      meaning: 'الأمة في القرآن هي جماعة المؤمنين المتحدة بالإيمان. واسمنا عهد: أن تخدم هذه الأكاديمية كل فرد فيها.',
      stats: [['+٥٠', 'دولة'], ['+١٠٠٠', 'طالب'], ['+١٠٠', 'معلم'], ['+١٢', 'إجازة']],
      diffTitle: 'ما الذي يميزنا',
      diffCols: ['', 'أكاديمية الأمة', 'المنصات العامة'],
      diff: [
        ['المعلمون', 'خريجو الأزهر بإجازة وسند موثّق', 'متطوعون أو معلمون غير معتمدين'],
        ['شكل الحصة', 'مباشرة وفردية بالكامل مع تصحيح فوري', 'فيديوهات مسجلة أو مجموعات كبيرة'],
        ['منهج الحفظ', 'الإتقان: تجميع موضوعي وتدبّر', 'الكمّ قبل الإتقان'],
        ['تعليم العربية', 'عربية القرآن مرتبطة بالمتون', 'عربية عامة منفصلة عن النصوص الشرعية'],
        ['المتابعة', 'تقرير بعد كل حصة', 'بلا متابعة منهجية'],
        ['المواعيد', 'على مدار الساعة لكل المناطق الزمنية', 'مواعيد ثابتة لا تناسب الغرب'],
      ],
      methodTitle: 'منهج الإتقان — الإحكام قبل العرض',
      method: [
        { icon: 'squares-four', title: 'تجميع موضوعي للآيات', text: 'نجمع الآيات حسب الموضوع والمعنى ليفهم الطالب السياق.' },
        { icon: 'waveform', title: 'تصحيح فوري للمخارج', text: 'الحصص الفردية المباشرة تتيح تصحيح المخارج في لحظتها.' },
        { icon: 'steps', title: 'مستويات متدرجة', text: 'ثلاثة مستويات واضحة بمعالم قابلة للقياس في كل مسار.' },
        { icon: 'link-simple', title: 'السند', text: 'يحصل خريجو الإجازة على سند موثّق يتصل بالنبي ﷺ.' },
      ],
      azharTitle: 'ألف عام من تراث الأزهر',
      azhar: 'تأسس الأزهر سنة ٩٧٠م، ليكون من أقدم الجامعات في العالم ومرجعًا عالميًا في علوم القرآن. وكل معلم في أكاديمية الأمة يحمل هذا التراث الحي إلى بيتك.',
      azharList: ['إجازة بسند متصل إلى النبي ﷺ', 'التحقق من شهادة الأزهر عند الطلب', 'تدريس بالعربية والإنجليزية', 'معلمات للنساء والأطفال'],
      certTitle: 'شهادة لكل مستوى',
      cert: 'يحصل كل طالب على شهادة إتمام عند إنهاء كل مستوى، ويحصل طلاب الإجازة على سند موثّق.',
      ctaTitle: 'انضم إلى <span class="accent">أسرتنا.</span>',
      ctaLede: 'أول حصتين مجانًا بالكامل — جرّب الفرق بنفسك.',
    }
  : {
      meta: { title: 'About Ummah Academy | Our Mission & Story', desc: 'Founded on one conviction: every Muslim deserves authentic Qur’anic education wherever they live. Our story, vision, the Itqan method and what makes us different.' },
      eyebrow: 'About us',
      title: 'Authentic Qur’anic education <span class="accent">shouldn’t depend on where you live.</span>',
      lede: 'Ummah Academy was founded on one conviction: every Muslim deserves authentic Qur’anic teaching, wherever they are. We bring Al-Azhar’s thousand-year tradition to families who need flexibility.',
      cardA: ['Our teaching family', '100+ Al-Azhar teachers'],
      cardB: ['1,000+', 'years of Al-Azhar scholarship'],
      visionKicker: 'Our vision',
      visionTitle: 'Every Muslim, back to <span class="accent">Allah’s Book.</span>',
      vision: 'Not for display recitation, but for genuine mastery (Itqan), deep reflection (Tadabbur) and a heartfelt connection with Allah’s words. Authentic knowledge should never be a privilege of geography — in London, Toronto, Sydney or Dubai, you deserve the quality Al-Azhar has protected for over a millennium.',
      values: [
        { icon: 'diamond', title: 'Itqan', text: 'We teach for depth and retention, not surface-level display.' },
        { icon: 'lightbulb', title: 'Tadabbur', text: 'Every lesson connects the student with the meaning of what they learn.' },
        { icon: 'globe-hemisphere-east', title: 'For the whole Ummah', text: 'Our name is our promise: to serve every member of the community, anywhere.' },
      ],
      journeyTitle: 'How we began',
      journey: [
        ['2022', 'The seed', 'Our founder saw Muslim families in the West struggling to find qualified teachers — relying on uncertified volunteers or expensive, inflexible local schools.'],
        ['2023', 'The solution', 'We began recruiting directly from Al-Azhar University, focusing on scholars with Ijazahs and documented chains.'],
        ['2024', 'Launch', 'We launched with 20 teachers and 150 students in 12 countries; our first Ijazah went to a student in the UK within the year.'],
        ['2025', 'Growth', '100+ teachers, 1,000+ students in 50+ countries, and the launch of Ummah Cubs for children 5+.'],
        ['2026', 'Today', '400+ live teaching hours a month, 12+ Ijazahs granted and a Family Portal.'],
      ],
      meaningKicker: 'Our name, our mission',
      meaningTitle: 'What does “Ummah” mean?',
      meaning: 'In the Qur’an, “Ummah” (أمة) is the global community of believers, united by faith. Our name is a promise: this academy exists to serve every member of it.',
      stats: [['50+', 'countries'], ['1K+', 'students'], ['100+', 'teachers'], ['12+', 'Ijazahs']],
      diffTitle: 'What makes us different',
      diffCols: ['', 'Ummah Academy', 'Typical platforms'],
      diff: [
        ['Teachers', 'Al-Azhar graduates with a verified Ijazah and Sanad', 'Volunteers or uncertified tutors'],
        ['Format', '100% live 1-on-1 with instant correction', 'Pre-recorded videos or large groups'],
        ['Memorisation', 'Itqan: thematic grouping and Tadabbur', 'Quantity over quality'],
        ['Arabic', 'Qur’anic Arabic linked to classical texts', 'Generic Arabic, disconnected from scripture'],
        ['Progress', 'A report after every session', 'No systematic follow-up'],
        ['Scheduling', 'Around the clock, every time zone', 'Fixed slots that ignore Western schedules'],
      ],
      methodTitle: 'The Itqan method — mastery over display',
      method: [
        { icon: 'squares-four', title: 'Thematic verse grouping', text: 'Verses grouped by theme and meaning, so students understand context.' },
        { icon: 'waveform', title: 'Real-time Makhraj correction', text: 'Live 1-on-1 lessons let teachers correct articulation instantly.' },
        { icon: 'steps', title: 'Progressive levels', text: 'Three defined levels with measurable milestones in every track.' },
        { icon: 'link-simple', title: 'The Sanad', text: 'Ijazah graduates receive a documented chain back to the Prophet ﷺ.' },
      ],
      azharTitle: 'A thousand years of Al-Azhar',
      azhar: 'Founded in 970 CE, Al-Azhar is one of the world’s oldest universities and a global reference in Qur’anic sciences. Every Ummah Academy teacher carries this living tradition into your home.',
      azharList: ['Ijazah with Sanad back to the Prophet ﷺ', 'Al-Azhar degree verification on request', 'Teaching in Arabic and English', 'Female teachers for women and children'],
      certTitle: 'A certificate for every level',
      cert: 'Every student receives a completion certificate at the end of each level; Ijazah students receive a documented Sanad.',
      ctaTitle: 'Join our <span class="accent">family.</span>',
      ctaLede: 'Your first two sessions are completely free — feel the difference for yourself.',
    };
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang}>
  <PageHero eyebrow={C.eyebrow} title={C.title} lede={C.lede} lang={lang}>
    <Fragment slot="actions">
      <a class="btn btn--primary" href={lp(lang, '/contact/') + '#book'}>{t.book2} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
      <a class="btn btn--glass" href={lp(lang, '/teachers/')}>{t.nav.teachers}</a>
    </Fragment>
    <Fragment slot="visual">
      <div class="a-visual">
        <div class="frame frame--arch a-visual__frame">
          <Image src={art} alt="" widths={[420, 640]} sizes="(min-width: 960px) 420px, 80vw" loading="eager" />
        </div>
        <div class="glass a-card a-card--a"><small>{C.cardA[0]}</small><strong>{C.cardA[1]}</strong></div>
        <div class="glass a-card a-card--b"><strong class="a-card__big">{C.cardB[0]}</strong><small>{C.cardB[1]}</small></div>
      </div>
    </Fragment>
  </PageHero>

  <section class="section" aria-labelledby="vision-title">
    <div class="container split">
      <div class="stack" style="--stack:18px" data-reveal>
        <span class="eyebrow" style="align-self:flex-start">{C.visionKicker}</span>
        <h2 id="vision-title" class="h2" set:html={C.visionTitle} />
        <p class="lead">{C.vision}</p>
      </div>
      <FeatureGrid items={C.values} cols={2} />
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="journey-title">
    <div class="container">
      <h2 id="journey-title" class="block-title" data-reveal>{C.journeyTitle}</h2>
    </div>
    <div class="rail" tabindex="0" aria-label={C.journeyTitle}>
      <ol role="list" class="rail__track">
        {
          C.journey.map(([y, tag, text]) => (
            <li class="glass jcard">
              <span class="jcard__year">{y}</span>
              <span class="chip chip--accent">{tag}</span>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="ummah-title">
    <div class="night-panel theme-night meaning">
      <div class="stars"></div>
      <div class="container meaning__inner">
        <div class="stack" style="--stack:16px" data-reveal>
          <span class="eyebrow" style="align-self:flex-start">{C.meaningKicker}</span>
          <h2 id="ummah-title" class="h2">{C.meaningTitle}</h2>
          <p class="lead">{C.meaning}</p>
        </div>
        <ul role="list" class="meaning__stats">
          {C.stats.map(([n, l]) => <li class="glass"><strong>{n}</strong><span>{l}</span></li>)}
        </ul>
        <span class="meaning__word quranic" aria-hidden="true">أُمَّة</span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="diff-title">
    <div class="container">
      <h2 id="diff-title" class="block-title" data-reveal>{C.diffTitle}</h2>
      <div class="glass table-wrap diff" data-reveal>
        <table class="table">
          <thead>
            <tr>{C.diffCols.map((c, i) => <th scope="col" class:list={{ diff__us: i === 1 }}>{c || <span class="sr-only">{ar ? 'الجانب' : 'Aspect'}</span>}</th>)}</tr>
          </thead>
          <tbody>
            {
              C.diff.map(([a, us, them]) => (
                <tr>
                  <th scope="row">{a}</th>
                  <td class="diff__us">
                    <Icon name="check-circle" weight="fill" class="diff__yes" /> {us}
                  </td>
                  <td>{them}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="method-title">
    <div class="container">
      <h2 id="method-title" class="block-title" data-reveal>{C.methodTitle}</h2>
      <FeatureGrid items={C.method} cols={4} />
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="azhar-title">
    <div class="container split">
      <div class="glass azhar" data-reveal>
        <h2 id="azhar-title">{C.azharTitle}</h2>
        <p>{C.azhar}</p>
        <ul class="checklist">{C.azharList.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="card glass cert" data-reveal style="--reveal-delay:.08s">
        <span class="icon-badge"><Icon name="certificate" /></span>
        <h3>{C.certTitle}</h3>
        <p>{C.cert}</p>
      </div>
    </div>
  </section>

  <CtaPanel lang={lang} title={C.ctaTitle} lede={C.ctaLede} />
</BaseLayout>

<style>
  .h2 {
    font-size: var(--fs-h2);
  }

  .block-title {
    font-size: clamp(1.7rem, 1.25rem + 1.6vw, 2.6rem);
    margin-bottom: clamp(20px, 3vw, 32px);
  }

  .a-visual {
    position: relative;
    width: min(100%, 420px);
    margin-inline: auto;
    padding: 20px 30px 40px;
  }

  .a-visual__frame {
    aspect-ratio: 4 / 5;
  }

  .a-card {
    --radius: 20px;
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 18px;
    max-width: 230px;
    animation: float-y 8s ease-in-out infinite;
  }

  .a-card small {
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .a-card strong {
    font-weight: 600;
    line-height: 1.3;
  }

  .a-card__big {
    font-size: 2rem;
    letter-spacing: -0.04em;
  }

  .a-card--a {
    top: 12%;
    inset-inline-start: -6%;
  }

  .a-card--b {
    bottom: 8%;
    inset-inline-end: -6%;
    animation-delay: -4s;
  }

  .rail {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 6px 0 24px;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  .rail__track {
    display: flex;
    gap: 14px;
    width: max-content;
    padding-inline: max(var(--gutter), calc((100vw - var(--maxw)) / 2));
  }

  .jcard {
    --radius: 24px;
    width: min(78vw, 300px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 24px;
  }

  .jcard__year {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 2.4rem;
    line-height: 1;
    background: var(--grad-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  :global([dir='rtl']) .jcard__year {
    font-family: var(--font-arabic);
    font-style: normal;
    font-weight: 700;
  }

  .jcard p {
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .meaning {
    position: relative;
    padding-block: clamp(56px, 8vw, 104px);
  }

  .meaning__inner {
    position: relative;
    display: grid;
    gap: 36px;
    align-items: center;
  }

  @media (min-width: 960px) {
    .meaning__inner {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .meaning__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .meaning__stats li {
    --radius: 22px;
    display: flex;
    flex-direction: column;
    padding: 22px;
  }

  .meaning__stats strong {
    font-size: 2.4rem;
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .meaning__stats span {
    color: var(--ink-2);
    margin-top: 6px;
  }

  .meaning__word {
    position: absolute;
    inset-inline-end: 2%;
    top: 50%;
    translate: 0 -50%;
    z-index: -1;
    font-size: clamp(8rem, 18vw, 16rem);
    line-height: 1;
    color: rgb(255 255 255 / 0.05);
    pointer-events: none;
  }

  .diff {
    --radius: 30px;
    padding: 8px;
  }

  .diff td {
    color: var(--ink-2);
  }

  .diff td.diff__us {
    color: var(--ink);
    font-weight: 520;
    background: rgb(255 255 255 / 0.5);
  }

  .diff thead .diff__us {
    color: var(--accent-ink);
  }

  .diff td :global(svg) {
    display: inline-block;
    width: 18px;
    height: 18px;
    vertical-align: -3px;
    margin-inline-end: 6px;
    color: var(--success);
  }

  .azhar {
    --radius: var(--r-xl);
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(26px, 3.5vw, 44px);
  }

  .azhar h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem);
  }

  .azhar > p {
    color: var(--ink-2);
  }
</style>
