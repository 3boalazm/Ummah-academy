---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PostCover from '@/components/PostCover.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import Icon from '@/components/Icon.astro';
import { trackById, type TrackId } from '@/data/tracks';
import { SITE, trialLink } from '@/data/site';
import { ogCardPath } from '@/data/og';
import type { Post } from '@/data/blog';
import { LANGS, LOCALE, lp, fmtDate, type Lang, type Alternates } from '@/i18n';
import { copy, ui } from '@/locales';

interface Link {
  href: string;
  title: string;
}
interface Props {
  lang: Lang;
  post: Post;
  prev: Link | null;
  next: Link | null;
  /** full translation cluster (undefined when the article exists in one language only) */
  alternates?: Alternates;
}
const { lang, post, prev, next, alternates } = Astro.props;
const entry = post.entry;
const path = post.url;
const d = entry.data;
const { Content } = await render(entry);
const COPY = copy(lang).article;
const L = COPY.L;
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(2, Math.round(words / COPY.wpm));
const track = d.track !== 'general' ? trackById(d.track as TrackId, lang) : null;
const readTime = COPY.readTime(minutes);
// German/French/Italian articles keep the English category key → localised label
const category = post.lang === 'ar' ? d.category : ((copy(lang).blog.C.categories as Record<string, string>)[d.category] ?? d.category);
const twins = alternates ? LANGS.filter((l) => l !== lang && alternates[l]).map((l) => ({ lang: l, href: alternates[l]!, label: LOCALE[l].name })) : [];
const exclude = [path, ...Object.values(alternates ?? {})];
const url = new URL(path, SITE.url).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  isPartOf: { '@id': `${url}#webpage` },
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  author: { '@type': 'Organization', name: d.author },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: url,
  // the page's own social card (scripts/og/build.mjs) doubles as the article image
  image: { '@type': 'ImageObject', url: new URL(ogCardPath(path), SITE.url).href, width: 1200, height: 630 },
  articleSection: category,
  wordCount: words,
  ...(alternates?.en && lang !== 'en' ? { translationOfWork: { '@id': new URL(alternates.en, SITE.url).href } } : {}),
};
---

<BaseLayout title={`${d.title} | ${ui(lang).siteName}`} description={d.description} type="article" jsonLd={ld} lang={lang} alternates={alternates} fallback="/blog/">
  <article class="post">
    <header class="container--narrow post__head" data-reveal>
      <Breadcrumbs items={[{ label: L.blog, href: lp(lang, '/blog/') }, { label: d.title }]} lang={lang} />
      <span class="cluster" style="--cluster:8px">
        <span class="chip chip--accent">{category}</span>
      </span>
      <h1>{d.title}</h1>
      <p class="post__meta">
        <span><Icon name="calendar-blank" weight="bold" /> <time datetime={d.date.toISOString()}>{fmtDate(lang, d.date)}</time></span>
        <span><Icon name="clock" weight="bold" /> {readTime}</span>
        <span><Icon name="pen-nib" weight="bold" /> {d.author}</span>
      </p>
      {
        twins.length > 0 && (
          <p class="post__twins">
            <Icon name="translate" weight="bold" />
            <span>{L.alsoIn}</span>
            {twins.map((x) => (
              <a class="chip post__twin" href={x.href} hreflang={x.lang} lang={x.lang} dir={LOCALE[x.lang].dir} data-lang-choice={x.lang}>
                {x.label}
              </a>
            ))}
          </p>
        )
      }
    </header>
    <div class="container post__cover" data-reveal>
      <PostCover title={d.title} track={d.track} />
    </div>
    <div class="container--narrow">
      <div class="glass glass--strong post__body prose">
        <Content />
      </div>

      <aside class="glass post__cta" aria-label={L.start}>
        <div>
          <p class="post__cta-kicker">{(track ? track.title : L.start)}</p>
          <p class="post__cta-title">{L.cta}</p>
        </div>
        <div class="cluster">
          <a class="btn btn--primary" href={trialLink(track ? { course: track.trial } : {}, lang)}>{L.book} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
          {track && <a class="btn btn--glass" href={lp(lang, track.href)}>{L.about}</a>}
        </div>
      </aside>

      {
        (prev || next) && (
          <nav class="post__pager" aria-label={L.more}>
            {prev ? <a class="glass" href={prev.href}><small>{L.prev}</small>{prev.title}</a> : <span />}
            {next ? <a class="glass post__pager-next" href={next.href}><small>{L.next}</small>{next.title}</a> : <span />}
          </nav>
        )
      }
    </div>
  </article>
  <RelatedPosts track={d.track} title={L.keep} lang={lang} exclude={exclude} />
</BaseLayout>

<style>
  .post {
    padding-block: clamp(28px, 4vw, 56px) 0;
  }

  .post__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .post__head h1 {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.4rem);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    color: var(--ink-3);
    font-size: 0.92rem;
  }

  .post__meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .post__meta :global(svg) {
    width: 15px;
    height: 15px;
  }

  .post__cover {
    margin-block: 28px;
    max-width: 1040px;
  }

  .post__cover :global(.cover) {
    border-radius: 32px;
    aspect-ratio: 21 / 9;
  }

  .post__body {
    --radius: var(--r-xl);
    padding: clamp(22px, 4vw, 56px);
  }

  .post__cta {
    --radius: 28px;
    display: grid;
    gap: 16px;
    margin-top: 20px;
    padding: 26px;
    align-items: center;
    background:
      radial-gradient(80% 120% at 100% 0%, rgb(175 204 234 / 0.55), transparent 60%),
      radial-gradient(70% 120% at 0% 100%, rgb(241 205 220 / 0.6), transparent 60%),
      var(--glass-fill);
  }

  @media (min-width: 760px) {
    .post__cta {
      grid-template-columns: 1fr auto;
    }
  }

  .post__cta-kicker {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .post__cta-title {
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.015em;
  }

  .post__pager {
    display: grid;
    gap: 12px;
    margin-top: 20px;
  }

  @media (min-width: 640px) {
    .post__pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  .post__pager a {
    --radius: 22px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 20px;
    text-decoration: none;
    font-weight: 560;
    line-height: 1.35;
  }

  .post__pager small {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .post__pager-next {
    text-align: end;
  }

  .post__twins {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--ink-3);
    font-size: 0.88rem;
  }

  .post__twins > :global(svg) {
    width: 15px;
    height: 15px;
  }

  .post__twin {
    text-decoration: none;
  }

  .post__twin:lang(ar) {
    font-family: var(--font-arabic);
  }

  :global([dir='rtl']) .post__head h1 {
    line-height: 1.35;
  }

  :global([dir='rtl']) .post__pager small {
    letter-spacing: 0;
  }
  /* ---------- Dark theme ---------- */
  :global([data-theme='dark']) .post__cta {
    background:
      radial-gradient(80% 120% at 100% 0%, rgb(109 158 214 / 0.24), transparent 60%),
      radial-gradient(70% 120% at 0% 100%, rgb(200 123 128 / 0.2), transparent 60%),
      var(--glass-fill);
  }
</style>
