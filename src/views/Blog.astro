---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import BlogCard from '@/components/BlogCard.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import { SITE } from '@/data/site';
import { lp, type Lang } from '@/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';
const byDate = <T extends { data: { date: Date } }>(a: T, b: T) => b.data.date.getTime() - a.data.date.getTime();
const posts = (await getCollection('blog')).sort(byDate);
const arPosts = (await getCollection('blogAr')).sort(byDate);

const C = ar
  ? {
      meta: { title: 'المدونة — معرفة إسلامية عملية للأسرة | أكاديمية الأمة', desc: 'مقالات عملية بالعربية عن تعليم القرآن والتجويد والحفظ والإجازة، كُتبت للأسر المسلمة في الغربة، إلى جانب مكتبتنا الإنجليزية كاملة.' },
      eyebrow: 'المدونة',
      title: 'معرفة <span class="accent">عملية</span> للأسرة المسلمة',
      lede: 'مقالات بالعربية كُتبت للأسر المسلمة خارج البلاد العربية، ثم مكتبتنا الإنجليزية كاملة لمن يقرأ بها هو أو أبناؤه.',
      arHead: { eyebrow: 'بالعربية', title: 'أحدث <span class="accent">المقالات</span>', lede: 'دليلك العملي لاختيار المعلم، وتحفيظ الأطفال، وفهم الإجازة والسند.' },
      enHead: { eyebrow: 'المكتبة الإنجليزية', title: 'مقالات <span class="accent">بالإنجليزية</span>', lede: 'أكثر من ١٩ مقالًا مفصّلًا. مناسبة لأبنائك الذين يقرؤون بالإنجليزية، أو لمشاركتها مع أصدقائك.' },
      filtersLabel: 'تصفية المقالات حسب الموضوع',
      filters: [
        { key: 'all', label: 'الكل' },
        { key: 'quran', label: 'القرآن' },
        { key: 'arabic', label: 'العربية' },
        { key: 'kids', label: 'الأطفال والأسرة' },
        { key: 'islamic', label: 'الدراسات الإسلامية' },
        { key: 'general', label: 'البداية' },
      ],
      empty: 'لا توجد مقالات في هذا الموضوع بعد.',
      cta: { eyebrow: 'الخطوة التالية', title: 'القراءة بداية — <span class="accent">والتلقّي تمام.</span>', lede: 'طبّق ما قرأته مع معلم مُجاز. أول حصتين مجانًا، بدون بطاقة دفع.', label: 'احجز حصتين مجانًا' },
    }
  : {
      meta: { title: 'Blog — Practical Islamic Knowledge | Ummah Academy', desc: 'Clear, practical guides on Quran, Tajweed, Hifz, Arabic and Islamic studies — for students and parents alike.' },
      eyebrow: 'From the Blog',
      title: 'Practical Islamic Knowledge for the <span class="accent">Modern Muslim</span>',
      lede: 'Qur’an, Arabic, and Islamic studies — explained clearly, for students and parents alike.',
      filtersLabel: 'Filter articles',
      filters: [
        { key: 'all', label: 'All' },
        { key: 'quran', label: 'Qur’an' },
        { key: 'arabic', label: 'Arabic' },
        { key: 'kids', label: 'Kids & Parents' },
        { key: 'islamic', label: 'Islamic Studies' },
        { key: 'general', label: 'Getting Started' },
      ],
      empty: 'No articles in this topic yet.',
    };

const listed = ar ? arPosts.map((p) => ({ url: `/ar/blog/${p.id}/`, title: p.data.title, date: p.data.date })) : posts.map((p) => ({ url: `/${p.id}/`, title: p.data.title, date: p.data.date }));
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: ar ? 'مدونة أكاديمية الأمة' : 'Ummah Academy Blog',
  url: new URL(lp(lang, '/blog/'), SITE.url).href,
  blogPost: listed.slice(0, 12).map((p) => ({ '@type': 'BlogPosting', headline: p.title, url: new URL(p.url, SITE.url).href, datePublished: p.date.toISOString() })),
};
---

<BaseLayout title={C.meta.title} description={C.meta.desc} jsonLd={ld} lang={lang}>
  <PageHero align="center" eyebrow={C.eyebrow} title={C.title} lede={C.lede} compact lang={lang} />

  {
    ar && C.arHead && (
      <section class="section section--tight" aria-labelledby="ar-posts">
        <div class="container">
          <SectionHead id="ar-posts" eyebrow={C.arHead.eyebrow} title={C.arHead.title} lede={C.arHead.lede} />
          <ul role="list" class="blog-grid">
            {arPosts.map((p, i) => (
              <BlogCard href={`/ar/blog/${p.id}/`} title={p.data.title} description={p.data.description} category={p.data.category} date={p.data.date} track={p.data.track} lang="ar" pageLang="ar" lead={i === 0 && (arPosts.length + 1) % 3 === 0} />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class:list={['section', { 'section--tight': !ar }]} aria-labelledby={ar ? 'en-posts' : undefined} aria-label={ar ? undefined : C.meta.title}>
    <div class="container">
      {ar && C.enHead && <SectionHead id="en-posts" eyebrow={C.enHead.eyebrow} title={C.enHead.title} lede={C.enHead.lede} />}
      <div class="blog-filters glass" role="toolbar" aria-label={C.filtersLabel}>
        {C.filters.map((f, i) => <button type="button" class:list={['blog-filter', { 'is-active': i === 0 }]} data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
      </div>
      <ul role="list" class="blog-grid" data-blog-grid>
        {posts.map((p, i) => <BlogCard href={`/${p.id}/`} title={p.data.title} description={p.data.description} category={p.data.category} date={p.data.date} track={p.data.track} lang="en" pageLang={lang} lead={!ar && i === 0} />)}
      </ul>
      <p class="blog-empty muted" hidden data-blog-empty>{C.empty}</p>
    </div>
  </section>

  {ar && C.cta && <CtaPanel lang={lang} eyebrow={C.cta.eyebrow} title={C.cta.title} lede={C.cta.lede} primary={{ label: C.cta.label, href: lp(lang, '/contact/') + '#book' }} />}
</BaseLayout>

<script>
  import { track } from '@/scripts/analytics';
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-blog-grid] > li');
  const empty = document.querySelector<HTMLElement>('[data-blog-empty]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const key = b.dataset.filter;
      buttons.forEach((x) => {
        x.classList.toggle('is-active', x === b);
        x.setAttribute('aria-pressed', String(x === b));
      });
      let shown = 0;
      cards.forEach((c) => {
        const on = key === 'all' || c.dataset.track === key;
        c.hidden = !on;
        if (on) shown++;
      });
      if (empty) empty.hidden = shown > 0;
      track('blog_filter', { topic: key });
    })
  );
</script>

<style>
  .blog-filters {
    --radius: var(--r-pill);
    display: flex;
    gap: 4px;
    padding: 6px;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 32px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .blog-filter {
    border: 0;
    background: transparent;
    padding: 10px 16px;
    border-radius: var(--r-pill);
    font-weight: 540;
    font-size: 0.93rem;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .blog-filter:hover {
    background: rgb(255 255 255 / 0.7);
  }

  .blog-filter.is-active {
    color: #fff;
    background: var(--aubergine-800);
  }

  .blog-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
</style>
