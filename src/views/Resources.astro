---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import NextSteps from '@/components/NextSteps.astro';
import Icon from '@/components/Icon.astro';
import { waLink } from '@/data/site';
import downloads from '@/data/downloads.json';
import { lp, num, type Lang } from '@/i18n';
import { copy } from '@/locales';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';

/* Worksheets are original Ummah Academy PDFs built by `npm run pdfs` into
   /public/downloads (manifest: src/data/downloads.json). A sheet only gets a
   direct link if its file really exists at build time; otherwise it falls back
   to a WhatsApp request, so no link can ever break. */
type Manifest = { files: Record<string, { file: string; pages: number; bytes: number }> };
const files = (downloads as Manifest).files;
const fileFor = (id: string) => {
  const f = files[id];
  if (!f) return null;
  const onDisk = path.join(process.cwd(), 'public', f.file);
  return fs.existsSync(onDisk) ? { ...f, bytes: fs.statSync(onDisk).size } : null;
};
const size = (b: number) => (b >= 1048576 ? `${(b / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`);

const COPY = copy(lang).resources;
const C = COPY.C;
const sheets = C.sheets.map((s) => ({ ...s, pdf: fileFor(s.id) }));
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang}>
  <PageHero align="center" eyebrow={C.eyebrow} title={C.title} lede={C.lede} crumbs={[{ label: C.crumb }]} compact lang={lang} />

  <section class="section section--tight" aria-labelledby="sheets">
    <div class="container">
      <SectionHead id="sheets" eyebrow={C.sheetsEyebrow} title={C.sheetsTitle} lede={C.sheetsLede} />
      <ul role="list" class="grid grid-3">
        {
          sheets.map((s, i) => (
            <li class="card glass res" data-reveal style={`--reveal-delay:${i * 0.05}s`}>
              <div class="res__top">
                <span class="icon-badge">
                  <Icon name={s.icon} />
                </span>
                <span class="cluster" style="--cluster:4px">
                  <span class="chip">PDF</span>
                  <span class="chip chip--accent">{C.free}</span>
                </span>
              </div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              {s.pdf ? (
                <>
                  <p class="res__lang">
                    <Icon name="file-pdf" weight="bold" />
                    <span>
                      {C.pages(s.pdf.pages)} · <span dir="ltr">{size(s.pdf.bytes)}</span> · {C.langs}
                    </span>
                  </p>
                  <a class="btn btn--sm btn--primary" href={s.pdf.file} download data-download={s.id}>
                    <Icon name="download-simple" weight="bold" /> {C.download}
                  </a>
                </>
              ) : (
                <a class="btn btn--sm btn--glass" href={waLink(C.waText(s.title))} target="_blank" rel="noopener">
                  <Icon name="whatsapp-logo" weight="fill" class="icon-wa" /> {C.requestShort}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="books">
    <div class="container">
      <SectionHead id="books" eyebrow={C.booksEyebrow} title={C.booksTitle} lede={C.booksLede} />
      <ul role="list" class="grid grid-4">
        {
          C.books.map((b, i) => (
            <li class="card glass res" data-reveal style={`--reveal-delay:${i * 0.05}s`}>
              <div class="res__top">
                <span class="icon-badge">
                  <Icon name={b.icon} />
                </span>
                <span class="chip chip--accent">{C.free}</span>
              </div>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
              <p class="res__lang">
                <Icon name="globe-simple" weight="bold" /> {b.lang}
              </p>
              <a class="btn btn--sm btn--glass" href={waLink(C.waText(b.title))} target="_blank" rel="noopener">
                <Icon name="whatsapp-logo" weight="fill" class="icon-wa" /> {C.request}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <NextSteps lang={lang} />
</BaseLayout>

<script>
  import { track } from '@/scripts/analytics';
  document.querySelectorAll<HTMLAnchorElement>('[data-download]').forEach((a) =>
    a.addEventListener('click', () => track('resource_download', { resource: a.dataset.download }))
  );
</script>

<style>
  .res {
    list-style: none;
  }

  .res__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .res__lang {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
  }

  .res__lang :global(svg) {
    width: 14px;
    height: 14px;
  }

  .res .btn {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
