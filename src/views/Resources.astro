---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import NextSteps from '@/components/NextSteps.astro';
import Icon from '@/components/Icon.astro';
import { waLink } from '@/data/site';
import downloads from '@/data/downloads.json';
import { lp, num, type Lang } from '@/i18n';
import { copy } from '@/locales';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';

/* Worksheets are original Ummah Academy PDFs built by `npm run pdfs` into
   /public/downloads (manifest: src/data/downloads.json). A sheet only gets a
   direct link if its file really exists at build time; otherwise it falls back
   to a WhatsApp request, so no link can ever break. */
type Manifest = { files: Record<string, { file: string; pages: number; bytes: number }> };
const files = (downloads as Manifest).files;
const fileFor = (id: string) => {
  const f = files[id];
  if (!f) return null;
  const onDisk = path.join(process.cwd(), 'public', f.file);
  return fs.existsSync(onDisk) ? { ...f, bytes: fs.statSync(onDisk).size } : null;
};
const size = (b: number) => (b >= 1048576 ? `${(b / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`);

const COPY = copy(lang).resources;
const C = COPY.C;
const SHEET_TAG: Record<string, keyof typeof C.filters> = {
  'tajweed-rules-summary': 'tajweed',
  'arabic-letter-tracing': 'arabic',
  'daily-wird-tracker': 'hifz',
  'hifz-schedule-template': 'hifz',
  'nahw-exercises': 'arabic',
  'ummah-cubs-activity-pack': 'kids',
};
const filterKeys = ['all', 'tajweed', 'arabic', 'hifz', 'kids'] as const;
// Pastel tone per worksheet group; the books get light numerals like the home page's numbered cards.
const TAG_TONE: Record<string, string> = { tajweed: 'lavender', arabic: 'sky', hifz: 'mauve', kids: 'rose' };
const pad = (n: number) => num(lang, String(n).padStart(2, '0'));
const sheets = C.sheets.map((s) => ({ ...s, pdf: fileFor(s.id), tag: SHEET_TAG[s.id] ?? 'all' }));
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang}>
  <PageHero align="center" eyebrow={C.eyebrow} title={C.title} lede={C.lede} crumbs={[{ label: C.crumb }]} compact lang={lang} />

  <section class="section section--tight" aria-labelledby="sheets">
    <div class="container">
      <SectionHead id="sheets" eyebrow={C.sheetsEyebrow} title={C.sheetsTitle} lede={C.sheetsLede} />
      <div class="res-filters" role="group" aria-label={C.filtersLabel}>
        {
          filterKeys.map((id) => (
            <button type="button" class="res-filter" data-filter={id} aria-pressed={id === 'all' ? 'true' : 'false'}>
              {C.filters[id]}
            </button>
          ))
        }
      </div>
      <p class="res-empty" data-filter-empty hidden>{C.filtersEmpty}</p>
      <!-- Bento: the first worksheet is the large deep card, the rest are pastel tone cards -->
      <ul role="list" class="res-bento" data-sheet-grid>
        {
          sheets.map((s, i) => (
            <li class:list={['res', 'tone', i === 0 ? ['res--feature', 'tone--deep', 'tone--grad-plum'] : `tone--${TAG_TONE[s.tag] ?? 'lavender'}`]} data-reveal data-tag={s.tag} style={`--reveal-delay:${i * 0.05}s`}>
              <div class="res__top">
                <span class="res__icon">
                  <Icon name={s.icon} />
                </span>
                <span class="res__pills">
                  <span class="status status--ghost">PDF</span>
                  <span class="status">{C.free}</span>
                </span>
              </div>
              <h3>{s.title}</h3>
              <p class="res__text">{s.text}</p>
              {s.pdf ? (
                <>
                  <ul role="list" class="res__file">
                    <li class="res__chip">
                      <Icon name="file-pdf" weight="bold" /> {C.pages(s.pdf.pages)}
                    </li>
                    <li class="res__chip">
                      <span dir="ltr">{size(s.pdf.bytes)}</span>
                    </li>
                    <li class="res__chip">{C.langs}</li>
                  </ul>
                  <a class="res__action res__action--download" href={s.pdf.file} download data-download={s.id}>
                    <span>{C.download}</span>
                    <span class="arrow-btn arrow-btn--dark" style="--arrow-size:40px" aria-hidden="true">
                      <Icon name="download-simple" weight="bold" />
                    </span>
                  </a>
                </>
              ) : (
                <a class="res__action" href={waLink(C.waText(s.title))} target="_blank" rel="noopener">
                  <span>
                    <Icon name="whatsapp-logo" weight="fill" /> {C.requestShort}
                  </span>
                  <span class="arrow-btn arrow-btn--dark" style="--arrow-size:40px" aria-hidden="true">
                    <Icon name="arrow-up-right" weight="bold" />
                  </span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Foundation texts: numbered cards on a soft gradient panel -->
  <section class="section section--tight" aria-labelledby="books">
    <div class="container">
      <div class="res-books">
        <SectionHead id="books" eyebrow={C.booksEyebrow} title={C.booksTitle} lede={C.booksLede} />
        <ul role="list" class="res-books__grid">
          {
            C.books.map((b, i) => (
              <li class="num-card res-book" data-reveal style={`--reveal-delay:${i * 0.05}s`}>
                <div class="res__top">
                  <span class="num-card__num">{pad(i + 1)}.</span>
                  <span class="res__icon">
                    <Icon name={b.icon} />
                  </span>
                </div>
                <h3>{b.title}</h3>
                <p class="res__text">{b.text}</p>
                <ul role="list" class="res__file">
                  <li class="res__chip">
                    <Icon name="globe-simple" weight="bold" /> {b.lang}
                  </li>
                  <li class="res__chip">{C.free}</li>
                </ul>
                <a class="res__action" href={waLink(C.waText(b.title))} target="_blank" rel="noopener">
                  <span>
                    <Icon name="whatsapp-logo" weight="fill" /> {C.request}
                  </span>
                  <span class="arrow-btn arrow-btn--dark" style="--arrow-size:40px" aria-hidden="true">
                    <Icon name="arrow-up-right" weight="bold" />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <NextSteps lang={lang} />
</BaseLayout>

<script>
  import { track } from '@/scripts/analytics';
  document.querySelectorAll<HTMLAnchorElement>('[data-download]').forEach((a) =>
    a.addEventListener('click', () => track('resource_download', { resource: a.dataset.download }))
  );
  const cards = [...document.querySelectorAll<HTMLElement>('[data-tag]')];
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.filter;
      document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
      let shown = 0;
      for (const card of cards) {
        const match = tag === 'all' || card.dataset.tag === tag;
        card.hidden = !match;
        if (match) shown++;
      }
      if (empty) empty.hidden = shown > 0;
      track('resource_filter', { filter: tag || 'all' });
    });
  });
</script>

<style>
  /* ── Filters: pills, the current one filled ──────────────── */
  .res-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0 0 clamp(20px, 3vw, 32px);
  }

  .res-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    min-height: 44px;
    padding-block: 0;
    padding-inline: 15px 18px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    background: var(--card);
    font: inherit;
    font-weight: 560;
    font-size: 0.93rem;
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }

  .res-filter::before {
    content: '';
    flex: none;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--brand-lavender);
  }

  .res-filter:hover {
    background: var(--tint-lavender);
  }

  .res-filter:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .res-filter[aria-pressed='true'] {
    color: #fff;
    background: var(--brand-ink);
    border-color: var(--brand-ink);
  }

  .res-filter[aria-pressed='true']::before {
    background: var(--brand-mauve);
  }

  :global([data-theme='dark']) .res-filter[aria-pressed='true'] {
    color: var(--brand-ink);
    background: #efe7f8;
    border-color: #efe7f8;
  }

  :global([data-theme='dark']) .res-filter[aria-pressed='true']::before {
    background: var(--brand-plum);
  }

  .res-empty {
    margin: 0 0 18px;
    text-align: center;
    color: var(--ink-2);
  }

  /* ── Worksheet bento ──────────────────────────────────────── */
  .res-bento {
    display: grid;
    gap: clamp(14px, 1.6vw, 20px);
    grid-auto-flow: dense;
  }

  @media (min-width: 680px) {
    .res-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .res--feature {
      grid-column: span 2;
    }
  }

  @media (min-width: 1040px) {
    .res-bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .res--feature {
      grid-row: span 2;
    }
  }

  .res {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: clamp(18px, 2.2vw, 26px);
    border-radius: 28px;
  }

  .res[hidden] {
    display: none;
  }

  .res__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .res__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .res__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 18px;
    color: var(--tone-dot, var(--brand-plum));
    background: #fff;
  }

  .res__icon :global(svg) {
    width: 26px;
    height: 26px;
  }

  .res h3,
  .res-book h3 {
    font-size: 1.3rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .res__text {
    color: var(--ink-2);
  }

  /* file facts as chips */
  .res__file {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .res__chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.4em 0.8em;
    border-radius: var(--r-pill);
    font-size: 0.84rem;
    font-weight: 540;
    color: var(--ink-2);
    background: rgb(255 255 255 / 0.7);
    box-shadow: inset 0 0 0 1px var(--card-line);
  }

  .res__chip :global(svg) {
    width: 14px;
    height: 14px;
  }

  /* the action: a white bar that ends on a round button (download or request) */
  .res__action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-block: 6px;
    padding-inline: 18px 6px;
    border-radius: var(--r-pill);
    font-weight: 620;
    font-size: 0.94rem;
    line-height: 1.3;
    color: var(--brand-ink);
    background: #fff;
    text-decoration: none;
    transition: box-shadow 0.3s var(--ease-out);
  }

  .res__action > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .res__action > span:first-child :global(svg) {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .res__action:hover {
    box-shadow: 0 12px 26px -18px rgb(44 28 68 / 0.6);
  }

  .res__action:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  /* a download arrow points down: it nudges rather than taking the ↗ turn */
  .res__action--download:hover .arrow-btn {
    transform: translateY(2px);
  }

  .res__action--download .arrow-btn :global(svg) {
    transform: none;
  }

  /* Featured worksheet: the deep anchor of the bento */
  .res--feature {
    gap: 18px;
    padding: clamp(22px, 3vw, 36px);
    border-radius: 32px;
  }

  .res--feature h3 {
    font-weight: 460;
    font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.6rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: #fff;
  }

  .res--feature .res__text {
    font-size: 1.05rem;
    max-width: 46ch;
  }

  .res--feature .res__icon {
    width: 64px;
    height: 64px;
    border-radius: 22px;
    color: #fff;
    background: rgb(255 255 255 / 0.12);
  }

  .res--feature .res__icon :global(svg) {
    width: 32px;
    height: 32px;
  }

  .res--feature .res__chip {
    color: #fff;
    background: rgb(255 255 255 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
  }

  @media (min-width: 1040px) {
    .res--feature .res__top {
      margin-bottom: auto;
    }

    .res--feature .res__action {
      margin-top: 4px;
    }
  }

  :global([dir='rtl']) :is(.res, .res-book) h3 {
    letter-spacing: 0;
    line-height: 1.5;
  }

  /* ── Foundation texts ─────────────────────────────────────── */
  .res-books {
    padding: clamp(24px, 4.5vw, 64px) clamp(16px, 4vw, 56px);
    border-radius: var(--sheet-radius);
    background: var(--grad-dawn);
  }

  .res-books__grid {
    display: grid;
    gap: clamp(12px, 1.4vw, 18px);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }

  .res-book {
    list-style: none;
    min-width: 0;
    border: 0;
  }

  .res-book:nth-child(4n + 1) { --tone-dot: var(--brand-plum); }
  .res-book:nth-child(4n + 2) { --tone-dot: var(--brand-navy); }
  .res-book:nth-child(4n + 3) { --tone-dot: var(--brand-magenta); }
  .res-book:nth-child(4n + 4) { --tone-dot: var(--brand-slate); }

  .res-book .res__icon {
    width: 46px;
    height: 46px;
    border-radius: 16px;
    background: var(--tint-lavender);
  }

  .res-book .res__chip {
    background: var(--tint-mist);
    box-shadow: none;
  }

  .res-book .res__action {
    background: var(--tint-mist);
  }

  /* ---------- Dark theme ---------- */
  :global([data-theme='dark']) .res:not(.tone--deep) .res__icon,
  :global([data-theme='dark']) .res-book .res__icon {
    background: rgb(255 255 255 / 0.08);
  }

  :global([data-theme='dark']) .res:not(.tone--deep) .res__chip,
  :global([data-theme='dark']) .res-book .res__chip {
    background: rgb(255 255 255 / 0.06);
  }

  :global([data-theme='dark']) .res:not(.tone--deep) .res__action,
  :global([data-theme='dark']) .res-book .res__action {
    color: var(--ink);
    background: var(--card);
  }

  :global([data-theme='dark']) .res-book:nth-child(4n + 1) { --tone-dot: #d4b9ef; }
  :global([data-theme='dark']) .res-book:nth-child(4n + 2) { --tone-dot: #b4ccec; }
  :global([data-theme='dark']) .res-book:nth-child(4n + 3) { --tone-dot: #e2c4d8; }
  :global([data-theme='dark']) .res-book:nth-child(4n + 4) { --tone-dot: #eeb1bd; }
</style>
