---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CourseCard from '@/components/CourseCard.astro';
import TeacherCard from '@/components/TeacherCard.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import SanadChain from '@/components/SanadChain.astro';
import Faq from '@/components/Faq.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import heroArt from '@/assets/art/hero-learning.webp';
import { getTrackPage, type TrackPageKey } from '@/content-i18n/tracks';
import { getTracks } from '@/data/tracks';
import { getTeachers, getTestimonials } from '@/data/people';
import { getPlans, perSession } from '@/data/pricing';
import { trialLink } from '@/data/site';
import Money from '@/components/Money.astro';
import { lp, num, type Lang } from '@/i18n';
import { copy, ui } from '@/locales';

interface Props {
  page: TrackPageKey;
  lang?: Lang;
}
const { page, lang = 'en' } = Astro.props;
const t = ui(lang);
const C = getTrackPage(page, lang);
const tracks = getTracks(lang);
const artMap = Object.fromEntries(tracks.map((tr) => [tr.id, tr.image])) as Record<string, ImageMetadata>;
const art = C.art === 'hero' ? heroArt : artMap[C.art];
const courses = C.courseTrack ? tracks.find((tr) => tr.id === C.courseTrack)!.courses : [];
const teacher = C.teacher ? getTeachers(lang).find((x) => x.id === C.teacher) : undefined;
const story = C.testimonial !== undefined ? getTestimonials(lang)[C.testimonial] : undefined;
const plans = getPlans(lang);
const recPlans = C.plans.map((id) => plans.find((p) => p.id === id)!).filter(Boolean);
const COPY = copy(lang).trackPage;
const L = COPY.L;

// Two of the at-a-glance facts ride on the hero photo as chips (decorative repeat of the spec card).
const heroChips = [C.glance[0], C.glance[2]].filter(Boolean).map(([, v]) => v);
// Levels: numbered cards with one featured, larger card (the second, as on the reference).
const levels = C.learn ?? [];
const featuredLevel = levels.length >= 3 ? 1 : 0;
const pad = (n: number) => num(lang, String(n).padStart(2, '0'));
// Course cards (programmes with a course list): the first is featured on the dusk gradient.
const COURSE_TONES = ['dusk', 'lavender', 'sky', 'mauve'];
// How lessons work: a bento of gradient / tint cards.
const METHOD_TONES = ['tone--dusk', 'tone--sky', 'tone--rose', 'tone--lavender'];
// Plans: the recommended plan is the deep anchor card, the others pastel tiles.
const PLAN_TONES = ['', 'tone--lavender', 'tone--sky', 'tone--mauve'];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: C.schemaName,
  description: C.meta.desc,
  provider: { '@type': 'EducationalOrganization', name: 'Ummah Academy', sameAs: 'https://ummahacademy.net' },
  offers: { '@type': 'Offer', price: C.from, priceCurrency: 'USD', category: 'subscription' },
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online' },
};
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang} jsonLd={ld}>
  <!-- Hero: copy on the white sheet; photo + at-a-glance card on a brand-gradient stage -->
  <section class="tp-hero">
    <div class="container tp-hero__grid">
      <div class="tp-hero__copy" data-reveal>
        <Breadcrumbs lang={lang} items={[{ label: t.nav.courses, href: lp(lang, '/courses/') }, { label: C.crumb }]} />
        <span class="eyebrow">{C.eyebrow}</span>
        <h1 set:html={C.title} />
        <p class="lead tp-hero__lede">{C.lede}</p>
        <div class="cluster tp-hero__actions">
          <a class="btn btn--lg btn--primary" href={trialLink({ course: C.trial }, lang)} data-track="track-hero">{t.book2} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
          <a class="btn btn--lg btn--glass" href={`${lp(lang, '/placement-test/')}?track=${C.testTrack}`} data-track="track-hero"><Icon name="compass" /> {t.findLevel}</a>
        </div>
      </div>
      <div class="tp-hero__visual" data-reveal style="--reveal-delay:.1s">
        <div class="tp-hero__stage">
          <div class="tp-hero__photo">
            <Image src={art} alt="" widths={[420, 640, 900]} sizes="(min-width: 960px) 520px, 92vw" loading="eager" />
            <ul role="list" class="tp-hero__chips" aria-hidden="true">
              {heroChips.map((v) => <li class="status">{v}</li>)}
            </ul>
          </div>
          <aside class="glance" aria-label={L.glance}>
            <p class="glance__kicker">{L.glance}</p>
            <dl class="glance__list">
              {
                C.glance.map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
            <div class="glance__price">
              <span>{L.from}</span>
              <strong><Money usd={C.from} lang={lang} /></strong>
              <span>{t.perMonth}</span>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- Levels / courses: numbered cards with a featured card -->
  <section class="section" aria-labelledby="learn-title">
    <div class="container">
      <div class="tp-head tp-head--split" data-reveal>
        <h2 id="learn-title">{C.learnTitle}</h2>
        <p class="lead">{C.learnLede}</p>
      </div>
      {
        courses.length > 0 ? (
          <div class:list={['tp-courses', `tp-courses--${courses.length}`]}>
            {courses.map((c, i) => (
              <CourseCard course={c} lang={lang} delay={i * 0.05} showLink={false} tone={COURSE_TONES[i % COURSE_TONES.length]} featured={i === 0} />
            ))}
          </div>
        ) : (
          <ol role="list" class:list={['levels', `levels--${levels.length}`]}>
            {levels.map((s, i) => (
              <li class:list={['num-card', 'level', i === featuredLevel ? 'level--featured' : 'tone tone--mist']} data-reveal style={`--reveal-delay:${i * 0.06}s`}>
                {i === featuredLevel ? (
                  <span class="level__visual">
                    <span class="level__shape level__shape--a" aria-hidden="true" />
                    <span class="level__shape level__shape--b" aria-hidden="true" />
                    <span class="num-card__num">{pad(i + 1)}.</span>
                  </span>
                ) : (
                  <span class="num-card__num">{pad(i + 1)}.</span>
                )}
                <div class="level__body">
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>

  <!-- How lessons work: bento of gradient / tint cards -->
  <section class="section section--tight" aria-labelledby="method-title">
    <div class="container">
      <h2 id="method-title" class="tp-h2" data-reveal>{C.methodTitle}</h2>
      <div class="mb">
        {
          C.method.map((m, i) => (
            <article class:list={['mb__card', 'tone', METHOD_TONES[i % METHOD_TONES.length], { 'mb__card--lead': i === 0 }]} data-reveal style={`--reveal-delay:${i * 0.05}s`}>
              <span class="mb__icon">
                <Icon name={m.icon} weight="duotone" />
              </span>
              <div class="mb__copy">
                <h3>{m.title}</h3>
                <p>{m.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    (teacher || story) && (
      <section class="section section--tight" aria-label={L.teacherTitle}>
        <div class="container tp-people">
          {teacher && (
            <div class="tp-people__teacher">
              <h2 class="tp-h2" data-reveal>
                {L.teacherTitle}
              </h2>
              <TeacherCard teacher={teacher} variant="compact" lang={lang} />
            </div>
          )}
          <div class="tp-people__side">
            {C.sanad && (
              <div class="tone tone--lavender sanad-box" data-reveal>
                <p class="sanad-box__note">
                  <Icon name="seal-check" weight="fill" /> {L.sanadNote}
                </p>
                <SanadChain lang={lang} />
              </div>
            )}
            {story && (
              <div data-reveal>
                <TestimonialCard t={story} lang={lang} />
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- Recommended plans: a deep featured tile and pastel tiles with stat-style prices -->
  <section class="section section--tight" aria-labelledby="plans-title">
    <div class="container">
      <div class="tp-head tp-head--row" data-reveal>
        <div>
          <h2 id="plans-title">{L.plansTitle}</h2>
          <p class="lead">{C.plansNote}</p>
        </div>
        <a class="link-arrow" href={lp(lang, '/pricing/')}>{L.allPlans} <Icon name="arrow-right" weight="bold" /></a>
      </div>
      <div class="rplans">
        {
          recPlans.map((p, i) => (
            <a
              class:list={['rplan', 'tone', i === 0 ? 'tone--deep tone--grad-plum' : PLAN_TONES[i % PLAN_TONES.length] || 'tone--lavender', { 'rplan--top': i === 0 }]}
              href={trialLink({ course: C.trial, plan: p.canonical }, lang)}
              data-reveal
              style={`--reveal-delay:${i * 0.05}s`}
            >
              <span class="rplan__name">
                {p.name} {p.badge && <span class="status rplan__badge">{p.badge}</span>}
              </span>
              <span class="rplan__price">
                <span class="rplan__num">
                  <Money usd={p.price} lang={lang} />
                </span>
                <small>{t.perMonth}</small>
              </span>
              <span class="rplan__meta">
                {p.sessionsLabel} · {num(lang, p.minutes)} {t.min}
              </span>
              <span class="rplan__unit">
                {t.approx}<Money usd={perSession(p)} lang={lang} /> {L.perSession}
              </span>
              <span class="rplan__go">
                <span class="rplan__choose">{L.choose}</span>
                <span class:list={['arrow-btn', { 'arrow-btn--dark': i !== 0 }]} aria-hidden="true">
                  <Icon name="arrow-up-right" weight="bold" />
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tfaq-title">
    <div class="container tp-faq">
      <h2 id="tfaq-title" class="tp-h2 tp-faq__title" data-reveal>{L.faq}</h2>
      <Faq items={C.faq} />
    </div>
  </section>

  <RelatedPosts slugs={C.related} title={L.related} lang={lang} />

  <CtaPanel lang={lang} title={C.cta.title} lede={C.cta.lede} primary={{ label: t.book2, href: trialLink({ course: C.trial }, lang) }} />
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .tp-hero {
    overflow-x: clip;
    padding-block: clamp(4px, 1vw, 12px) clamp(28px, 4vw, 56px);
  }

  .tp-hero__grid {
    display: grid;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(12px, 3vw, 40px);
  }

  @media (min-width: 960px) {
    .tp-hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .tp-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
    max-width: 780px;
  }

  .tp-hero__copy h1 {
    font-size: clamp(2.4rem, 1.4rem + 3.8vw, 4.6rem);
    line-height: 1.04;
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) .tp-hero__copy h1 {
    font-size: clamp(2.1rem, 1.3rem + 3vw, 3.8rem);
    line-height: 1.35;
  }

  .tp-hero__lede {
    max-width: 62ch;
  }

  .tp-hero__actions {
    margin-top: 6px;
  }

  .tp-hero__visual {
    min-width: 0;
  }

  .tp-hero__stage {
    position: relative;
    padding: clamp(14px, 2.2vw, 26px);
    border-radius: clamp(26px, 3vw, 38px);
    background: var(--grad-dusk);
  }

  .tp-hero__photo {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: clamp(22px, 2.4vw, 30px);
    overflow: hidden;
  }

  .tp-hero__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tp-hero__chips {
    position: absolute;
    inset: 14px 14px auto;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tp-hero__chips .status {
    max-width: 100%;
    white-space: normal;
    font-size: 0.78rem;
    color: var(--brand-ink);
    background: rgb(255 255 255 / 0.88);
    border-color: rgb(255 255 255 / 0.9);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  /* the at-a-glance spec card: white, lifted over the photo */
  .glance {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: clamp(-64px, -6vw, -36px) clamp(8px, 1.4vw, 16px) 0;
    padding: clamp(18px, 2.2vw, 24px);
    border-radius: 24px;
    color: var(--ink);
    background: var(--card);
    box-shadow: var(--shadow-lift);
  }

  .glance__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink);
  }

  .glance__kicker::before {
    content: '';
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--brand-magenta);
  }

  :global([data-theme='dark']) .glance__kicker::before {
    background: var(--brand-mauve);
  }

  .glance__list {
    display: grid;
    margin: 0;
  }

  .glance__list div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.93rem;
  }

  .glance__list dt {
    flex: none;
    color: var(--ink-3);
  }

  .glance__list dd {
    min-width: 0;
    margin: 0;
    font-weight: 560;
    text-align: end;
    overflow-wrap: anywhere;
  }

  .glance__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    color: var(--ink-3);
    font-size: 0.9rem;
  }

  .glance__price strong {
    font-size: clamp(2rem, 1.6rem + 1.2vw, 2.6rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink);
  }

  :global([dir='rtl']) .glance__price strong {
    letter-spacing: 0;
  }

  /* ── Section heads ────────────────────────────────────── */
  .tp-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: clamp(24px, 3vw, 40px);
    max-width: 760px;
  }

  .tp-head h2,
  .tp-h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    line-height: 1.06;
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) :is(.tp-head h2, .tp-h2) {
    line-height: 1.4;
  }

  .tp-h2 {
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  @media (min-width: 900px) {
    .tp-head--split {
      max-width: none;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      align-items: end;
      gap: clamp(24px, 4vw, 64px);
    }
  }

  .tp-head--row {
    max-width: none;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }

  .tp-head--row > div {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 680px;
    min-width: 0;
  }

  /* ── Levels: numbered cards 01.–04. with a featured card ── */
  .levels {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .levels {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    }

    .levels--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .levels--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .levels {
      align-items: end;
    }

    .levels--3 {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) minmax(0, 1fr);
    }

    .levels--4 {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .level {
    min-width: 0;
    min-height: 270px;
    justify-content: space-between;
  }

  .level.tone {
    border: 0;
    background: var(--tone-bg);
  }

  .level .num-card__num {
    color: var(--brand-plum);
  }

  :global([data-theme='dark']) .level .num-card__num {
    color: var(--accent);
  }

  .level__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .level h3 {
    font-size: 1.2rem;
    overflow-wrap: anywhere;
  }

  .level p {
    color: var(--ink-2);
    font-size: 0.97rem;
  }

  .level--featured {
    min-height: 360px;
    padding: 10px 10px clamp(20px, 2.6vw, 28px);
    background: var(--card);
    border: 1px solid var(--card-line);
    box-shadow: var(--shadow-lift);
  }

  .level--featured .level__body {
    padding-inline: clamp(10px, 1.6vw, 18px);
    gap: 12px;
  }

  .level--featured h3 {
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  :global([dir='rtl']) .level--featured h3 {
    letter-spacing: 0;
    line-height: 1.4;
  }

  .level__visual {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: 150px;
    padding: 20px;
    border-radius: 20px;
    background: var(--grad-dusk);
  }

  .level__visual .num-card__num {
    position: relative;
    color: var(--brand-ink);
  }

  :global([data-theme='dark']) .level__visual .num-card__num {
    color: var(--ink);
  }

  /* abstract shapes on the gradient, as on the reference cards */
  .level__shape {
    position: absolute;
    border-radius: 50%;
  }

  .level__shape--a {
    width: 150px;
    height: 150px;
    inset-block-start: -50px;
    inset-inline-end: -30px;
    background: rgb(255 255 255 / 0.28);
  }

  .level__shape--b {
    width: 80px;
    height: 80px;
    inset-block-end: 18px;
    inset-inline-end: 96px;
    border: 2px solid rgb(255 255 255 / 0.5);
  }

  /* ── Course cards (programmes with a course list) ─────── */
  .tp-courses {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  }

  .tp-courses > :global(*) {
    min-width: 0;
  }

  @media (min-width: 960px) {
    .tp-courses--3,
    .tp-courses--4 {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .tp-courses--3 > :global(*) {
      grid-column: span 3;
    }

    .tp-courses--3 > :global(:first-child) {
      grid-row: span 2;
    }

    .tp-courses--4 > :global(*) {
      grid-column: span 2;
    }

    .tp-courses--4 > :global(:first-child) {
      grid-column: span 4;
    }
  }

  /* ── How lessons work: bento ──────────────────────────── */
  .mb {
    display: grid;
    gap: 14px;
  }

  @media (min-width: 860px) {
    .mb {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }

    .mb__card--lead {
      grid-row: span 2;
    }
  }

  .mb__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    min-width: 0;
    padding: clamp(22px, 2.8vw, 32px);
    border-radius: 28px;
  }

  .mb__card.tone--dusk {
    --ink-2: var(--ink);
  }

  .mb__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    color: var(--tone-dot);
    background: #fff;
  }

  :global([data-theme='dark']) .mb__icon {
    background: rgb(255 255 255 / 0.08);
  }

  .mb__icon :global(svg) {
    width: 26px;
    height: 26px;
  }

  .mb__copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mb__card h3 {
    font-size: 1.25rem;
    overflow-wrap: anywhere;
  }

  .mb__card p {
    color: var(--ink-2);
  }

  .mb__card--lead {
    min-height: 300px;
  }

  .mb__card--lead .mb__icon {
    width: 64px;
    height: 64px;
  }

  .mb__card--lead .mb__icon :global(svg) {
    width: 32px;
    height: 32px;
  }

  .mb__card--lead h3 {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  :global([dir='rtl']) .mb__card--lead h3 {
    letter-spacing: 0;
    line-height: 1.4;
  }

  .mb__card--lead p {
    max-width: 44ch;
    font-size: 1.05rem;
  }

  /* ── Teacher, Sanad and story ─────────────────────────── */
  .tp-people {
    display: grid;
    gap: 20px;
    align-items: start;
  }

  @media (min-width: 960px) {
    .tp-people {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }

  .tp-people > * {
    min-width: 0;
  }

  .tp-people__side {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 960px) {
