---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TrackCard from '@/components/TrackCard.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import ClassroomMockup from '@/components/ClassroomMockup.astro';
import SanadChain from '@/components/SanadChain.astro';
import Faq from '@/components/Faq.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import heroArt from '@/assets/art/hero-learning.webp';
import { getTracks } from '@/data/tracks';
import { getTestimonials } from '@/data/people';
import { getPlans, perSession } from '@/data/pricing';
import Money from '@/components/Money.astro';
import { lp, num, type Lang } from '@/i18n';
import { copy, ui } from '@/locales';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';
const t = ui(lang);
const tracks = getTracks(lang);
const stories = getTestimonials(lang);
const plans = getPlans(lang);

const COPY = copy(lang).home;
const C = COPY.C;

const plans30 = plans.filter((p) => p.minutes === 30);
const plans60 = plans.filter((p) => p.minutes === 60);
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang}>
  <!-- 1 · Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy" data-reveal>
        <span class="eyebrow">{C.eyebrow}</span>
        <h1 class="hero__title" set:html={C.title} />
        <p class="lead hero__lede">{C.lede}</p>
        <div class="cluster hero__actions">
          <a class="btn btn--lg btn--primary" href={lp(lang, '/contact/') + '#book'} data-track="hero">
            {t.book2} <Icon name="arrow-right" weight="bold" class="icon-arrow" />
          </a>
          <a class="btn btn--lg btn--glass" href={lp(lang, '/placement-test/')} data-track="hero">
            <Icon name="compass" weight="duotone" /> {t.findLevel}
            <span class="hero__btn-note">{C.test}</span>
          </a>
        </div>
        <ul role="list" class="hero__reassure">
          {C.reassure.map((r) => <li><Icon name="check-circle" weight="fill" /> {r}</li>)}
        </ul>
      </div>

      <div class="hero__visual" data-reveal data-tilt style="--reveal-delay:.15s">
        <span class="hero__iqra quranic" aria-hidden="true">اقْرَأْ</span>
        <div class="frame frame--arch hero__frame">
          <Image src={heroArt} alt="" widths={[420, 640, 900]} sizes="(min-width: 960px) 460px, 86vw" loading="eager" fetchpriority="high" />
          <span class="hero__verified"><Icon name="seal-check" weight="fill" /> {C.verified}</span>
        </div>
        <div class="hero__card hero__card--progress glass" aria-hidden="true">
          <span class="icon-badge"><Icon name="book-open-text" /></span>
          <div class="hero__card-body">
            <p class="hero__card-title">{C.card1[0]}</p>
            <p class="hero__card-meta">{C.card1[1]}</p>
            <div class="progress"><span style="width:68%"></span></div>
            <p class="hero__card-meta"><span>{C.card1[2]}</span><strong>{num(lang, 68)}%</strong></p>
          </div>
        </div>
        <div class="hero__card hero__card--live glass" aria-hidden="true">
          <p class="hero__live"><span class="pulse"></span> {C.card2[0]}</p>
          <p class="hero__card-title">{C.card2[1]}</p>
          <p class="hero__card-meta">{C.card2[2]}</p>
          <p class="hero__countdown"><Icon name="clock" weight="bold" /> {C.card2[3]}</p>
        </div>
      </div>
    </div>

    <!-- 2 · Proof strip -->
    <div class="container">
      <ul role="list" class="proof glass" data-reveal>
        {C.stats.map(([n, l]) => <li><strong>{n}</strong><span>{l}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- 3 · Audience router -->
  <section class="section router" aria-labelledby="router-title">
    <div class="container">
      <div class="router__head" data-reveal>
        <h2 id="router-title">{C.router.title}</h2>
        <p class="lead">{C.router.lede}</p>
      </div>
      <div class="router__grid">
        <a class="router__child glass glass--interactive" href={lp(lang, '/ummah-cubs-kids-islamic-studies/')} data-router="child" data-goal="kids" data-reveal>
          <div class="router__art" aria-hidden="true">
            <Image src={tracks[2].image} alt="" widths={[360, 560]} sizes="(min-width: 960px) 260px, 70vw" />
          </div>
          <div class="router__copy">
            <span class="chip chip--accent"><Icon name="baby" /> {C.router.childKicker}</span>
            <h3>{C.router.childTitle}</h3>
            <p>{C.router.childText}</p>
            <ul role="list" class="cluster router__chips">{C.router.childChips.map((c) => <li class="chip">{c}</li>)}</ul>
            <span class="btn btn--primary router__cta">{C.router.childCta} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></span>
          </div>
        </a>
        <div class="router__self glass" data-reveal style="--reveal-delay:.08s">
          <span class="chip chip--accent"><Icon name="user" /> {C.router.selfKicker}</span>
          <h3>{C.router.selfTitle}</h3>
          <ul role="list" class="router__goals">
            {
              C.router.goals.map(([label, href, goal]) => (
                <li>
                  <a href={lp(lang, href)} data-router="self" data-goal={goal}>
                    <span>{label}</span>
                    <Icon name="arrow-right" weight="bold" class="icon-arrow" />
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="router__unsure" href={lp(lang, '/placement-test/')} data-router="self" data-goal="unsure">
            <Icon name="compass" /> {C.router.unsure}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Programmes: choose a path before exploring the method -->
  <section class="section" aria-labelledby="tracks-title">
    <div class="container">
      <div class="head-row" data-reveal>
        <div class="stack" style="--stack:14px">
          <span class="eyebrow" style="align-self:flex-start">{C.tracks.eyebrow}</span>
          <h2 id="tracks-title" class="h2" set:html={C.tracks.title} />
          <p class="lead">{C.tracks.lede}</p>
        </div>
        <a class="btn btn--glass" href={lp(lang, '/courses/')}>{t.compareCourses} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
      </div>
      <div class="grid grid-4">
        {tracks.map((tr, i) => <TrackCard track={tr} lang={lang} delay={i * 0.06} compact />)}
      </div>
    </div>
  </section>

  <!-- 5 · Why (bento) -->
  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="head-split" data-reveal>
        <span class="eyebrow">{C.why.eyebrow}</span>
        <h2 id="why-title" set:html={C.why.title} />
      </div>
      <div class="bento">
        <article class="bento__sanad theme-night" data-reveal>
          <div class="stars"></div>
          <span class="chip"><Icon name="seal-check" weight="fill" /> {C.why.sanadKicker}</span>
          <h3>{C.why.sanadTitle}</h3>
          <p>{C.why.sanadText}</p>
          <SanadChain dark lang={lang} />
          <a class="btn btn--glass btn--sm" href={lp(lang, '/teachers/') + '#process'}>{C.why.sanadLink} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
        </article>
        <article class="bento__tile glass" data-reveal style="--reveal-delay:.05s">
          <span class="icon-badge"><Icon name="brain" /></span>
          <h3>{C.why.itqan[0]}</h3>
          <p>{C.why.itqan[1]}</p>
          <a class="btn btn--link" href="/the-itqan-method-explained-how-thematic-memorization-makes-hifz-easier/">{C.why.itqan[2]} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
        </article>
        <article class="bento__tile glass" data-reveal style="--reveal-delay:.1s">
          <span class="icon-badge"><Icon name="shield-check" /></span>
          <h3>{C.why.safe[0]}</h3>
          <p>{C.why.safe[1]}</p>
        </article>
        <article class="bento__tile glass" data-reveal style="--reveal-delay:.15s">
          <span class="icon-badge"><Icon name="globe-hemisphere-west" /></span>
          <h3>{C.why.time[0]}</h3>
          <p>{C.why.time[1]}</p>
        </article>
        <a class="bento__price glass glass--interactive" href={lp(lang, '/pricing/')} data-reveal style="--reveal-delay:.2s">
          <span class="bento__price-num">{C.why.price[0]}</span>
          <span>{C.why.price[1]}</span>
          <span class="btn btn--link">{C.why.price[2]} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 6 · What happens after you book -->
  <section class="section" aria-labelledby="how-title">
    <div class="container split how">
      <div class="how__visual" data-reveal>
        <ClassroomMockup lang={lang} />
      </div>
      <div class="how__copy">
        <div class="stack" style="--stack:16px" data-reveal>
          <span class="eyebrow" style="align-self:flex-start">{C.how.eyebrow}</span>
          <h2 id="how-title" class="h2" set:html={C.how.title} />
          <p class="lead">{C.how.lede}</p>
        </div>
        <ol role="list" class="timeline-v">
          {
            C.how.steps.map(([h, p], i) => (
              <li data-reveal style={`--reveal-delay:${i * 0.06}s`}>
                <span class="timeline-v__num">{num(lang, i + 1)}</span>
                <div>
                  <h3>{h}</h3>
                  <p>{p}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <a class="btn btn--primary" href={lp(lang, '/contact/') + '#book'} data-track="how">{t.book2} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
      </div>
    </div>
  </section>

  <!-- 7 · Stories -->
  <section class="section" aria-labelledby="stories-title">
    <div class="container">
      <div class="head-split" data-reveal>
        <span class="eyebrow">{C.stories.eyebrow}</span>
        <h2 id="stories-title" set:html={C.stories.title} />
      </div>
    </div>
    <div class="rail" data-reveal tabindex="0" aria-label={C.stories.eyebrow}>
      <ul role="list" class="rail__track">
        {stories.map((s) => <li><TestimonialCard t={s} lang={lang} /></li>)}
      </ul>
    </div>
    <p class="container rail__note">
      {C.stories.note && <span class="muted">{C.stories.note} </span>}
      <a href={lp(lang, '/reviews/')}>{C.stories.all}</a>
    </p>
  </section>

  <!-- 8 · Pricing teaser -->
  <section class="section" aria-labelledby="pricing-title">
    <div class="container">
      <div class="glass price-teaser" data-reveal>
        <div class="price-teaser__copy">
          <span class="eyebrow">{C.pricing.eyebrow}</span>
          <h2 id="pricing-title" set:html={C.pricing.title} />
          <p class="lead">{C.pricing.text}</p>
          <a class="btn btn--glass" href={lp(lang, '/pricing/')}>{C.pricing.all} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
        </div>
        <div class="price-teaser__plans" data-tabs>
          <div class="seg-tabs" role="tablist" aria-label={C.pricing.eyebrow}>
            <button role="tab" type="button" aria-selected="true" aria-controls="pt-30" id="tab-30" data-tab="30">{C.pricing.tabs[0]}</button>
            <button role="tab" type="button" aria-selected="false" aria-controls="pt-60" id="tab-60" data-tab="60" tabindex="-1">{C.pricing.tabs[1]}</button>
          </div>
          {
            [
              ['30', plans30],
              ['60', plans60],
            ].map(([id, list]) => (
              <div role="tabpanel" id={`pt-${id}`} aria-labelledby={`tab-${id}`} hidden={id === '60'}>
              <ul role="list" class="mini-plans">
                {(list as typeof plans).map((p) => (
                  <li class:list={['mini-plan', { 'mini-plan--badge': p.badge }]}>
                    <div>
                      <p class="mini-plan__name">
                        {p.name} {p.badge && <span class="mini-plan__badge">{p.badge}</span>}
                      </p>
                      <p class="mini-plan__meta">{p.sessionsLabel}</p>
                    </div>
                    <p class="mini-plan__price">
                      <Money usd={p.price} lang={lang} />
                      <small>{t.perMonth}</small>
                      <span>
                        {t.approx}<Money usd={perSession(p)} lang={lang} /> {C.pricing.perSession}
                      </span>
                    </p>
                  </li>
                ))}
              </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 9 · FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container faq-split">
      <div class="stack faq-split__head" style="--stack:16px" data-reveal>
        <span class="eyebrow" style="align-self:flex-start">{C.faq.eyebrow}</span>
        <h2 id="faq-title" class="h2" set:html={C.faq.title} />
        <a class="btn btn--link" href={lp(lang, '/faq/')}>{C.faq.more} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
      </div>
      <Faq items={C.faq.items} />
    </div>
  </section>

  <!-- 10 · CTA -->
  <CtaPanel lang={lang} eyebrow={C.cta.eyebrow} title={C.cta.title} lede={C.cta.lede} />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
    const tabs = Array.from(box.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const dir = document.dir === 'rtl' ? -1 : 1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          const delta = (e.key === 'ArrowRight' ? 1 : -1) * dir;
          const next = tabs[(i + delta + tabs.length) % tabs.length];
          next.focus();
          select(next);
        }
      });
    });
  });
</script>

<style>
  .h2 {
    font-size: var(--fs-h2);
  }

  /* Hero */
  .hero {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(32px, 5vw, 72px) clamp(24px, 4vw, 48px);
  }

  .hero__grid {
    display: grid;
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .hero__title {
    font-size: clamp(2.5rem, 1.3rem + 4.6vw, 5.2rem);
    line-height: 1;
    letter-spacing: -0.045em;
    font-weight: 600;
  }

  :global([dir='rtl']) .hero__title {
    font-size: clamp(2.2rem, 1.2rem + 3.8vw, 4.3rem);
    line-height: 1.3;
    letter-spacing: 0;
  }

  .hero__title :global(.accent) {
    display: inline;
  }

  .hero__lede {
    max-width: 46ch;
  }

  .hero__actions {
    margin-top: 2px;
  }

  .hero__btn-note {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--ink-3);
    padding-inline-start: 6px;
    border-inline-start: 1px solid var(--line-strong);
    margin-inline-start: 2px;
  }

  .hero__reassure {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .hero__reassure li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .hero__reassure :global(svg) {
    width: 17px;
    height: 17px;
    color: var(--success);
  }

  .hero__visual {
    --tx: 0px;
    --ty: 0px;
    position: relative;
    justify-self: center;
    width: min(100%, 470px);
    padding: 30px 24px 36px;
  }

  .hero__iqra {
    position: absolute;
    left: 50%;
    top: 47%;
    translate: -50% -50%;
    z-index: -1;
    white-space: nowrap;
    font-size: clamp(8rem, 5rem + 13vw, 17rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(91 58 142 / 0.16);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.7), rgb(255 255 255 / 0));
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
    pointer-events: none;
  }

  .hero__frame {
    aspect-ratio: 4 / 5;
    box-shadow:
      0 0 0 10px rgb(255 255 255 / 0.4),
      0 0 0 11px rgb(255 255 255 / 0.85),
      var(--shadow-lift);
  }

  .hero__verified {
    position: absolute;
    left: 50%;
    bottom: 16px;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border-radius: var(--r-pill);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--accent-ink);
    background: rgb(255 255 255 / 0.88);
    box-shadow: 0 8px 18px -10px rgb(46 29 70 / 0.5);
  }

  .hero__verified :global(svg) {
    width: 16px;
    height: 16px;
  }

  .hero__card {
    --radius: 22px;
    position: absolute;
    display: flex;
    gap: 14px;
    padding: 16px 18px;
    translate: var(--tx) var(--ty);
    transition: translate 0.6s var(--ease-out);
    animation: float-y 7s ease-in-out infinite;
  }

  .hero__card--progress {
    inset-inline-start: -7%;
    top: 14%;
    width: 248px;
  }

  .hero__card--live {
    inset-inline-end: -7%;
    bottom: 18%;
    width: 240px;
    flex-direction: column;
    gap: 4px;
    animation-delay: -3.5s;
    translate: calc(var(--tx) * -1) calc(var(--ty) * -1);
  }

  @media (max-width: 560px) {
    .hero__card--progress {
      inset-inline-start: -2%;
      top: 6%;
      width: 212px;
      padding: 12px 14px;
    }

    .hero__card--live {
      inset-inline-end: -2%;
      width: 208px;
      padding: 12px 14px;
    }

    .hero__card .icon-badge {
      width: 40px;
      height: 40px;
    }
  }

  .hero__card-body {
    flex: 1;
    display: grid;
    gap: 4px;
  }

  .hero__card-title {
    font-weight: 620;
    letter-spacing: -0.02em;
  }

  .hero__card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .hero__card-meta strong {
    color: var(--ink);
  }

  .progress {
    height: 7px;
    border-radius: 99px;
    background: rgb(46 29 70 / 0.08);
    overflow: hidden;
    margin-top: 6px;
  }

  .progress span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--grad-accent);
  }

  .hero__live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--success);
  }

  :global([dir='rtl']) .hero__live {
    letter-spacing: 0;
    font-size: 0.82rem;
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--wa-green);
    animation: pulse-dot 1.6s ease-out infinite;
  }

  .hero__countdown {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    padding: 6px 10px;
    width: fit-content;
    border-radius: var(--r-pill);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-ink);
    background: rgb(143 47 158 / 0.08);
  }

  .hero__countdown :global(svg) {
    width: 14px;
    height: 14px;
  }

  /* Proof strip */
  .proof {
    --radius: var(--r-xl);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(28px, 4vw, 48px);
    padding: 8px;
  }

  .proof li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 22px;
  }

  .proof li + li {
    border-inline-start: 1px solid var(--line);
  }

  .proof strong {
    font-size: clamp(1.7rem, 1.2rem + 1.6vw, 2.5rem);
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .proof span {
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  @media (max-width: 720px) {
    .proof {
      grid-template-columns: 1fr 1fr;
    }

    .proof li:nth-child(3) {
      border-inline-start: 0;
    }

    .proof li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  /* Router */
  .router__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
  }

  .router__head h2 {
    font-size: var(--fs-h2);
  }

  .router__grid {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 960px) {
    .router__grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .router__child {
    --radius: var(--r-xl);
    display: grid;
    gap: 18px;
    padding: 10px;
    text-decoration: none;
  }

  @media (min-width: 640px) {
    .router__child {
      grid-template-columns: 0.85fr 1fr;
      align-items: stretch;
    }
  }

  .router__art {
    border-radius: 30px;
    overflow: hidden;
    min-height: 220px;
  }

  .router__art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
