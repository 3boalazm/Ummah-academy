---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TrackCard from '@/components/TrackCard.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import ClassroomMockup from '@/components/ClassroomMockup.astro';
import SanadChain from '@/components/SanadChain.astro';
import Faq from '@/components/Faq.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import heroArt from '@/assets/art/hero-arch.jpg';
import { getTracks } from '@/data/tracks';
import { getTestimonials } from '@/data/people';
import { getPlans, perSession } from '@/data/pricing';
import { ui, lp, price, num, type Lang } from '@/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';
const t = ui(lang);
const tracks = getTracks(lang);
const stories = getTestimonials(lang);
const plans = getPlans(lang);

const C = ar
  ? {
      meta: { title: 'أكاديمية الأمة | تعلَّم القرآن والعربية أونلاين مع علماء الأزهر — حصتان مجانًا', desc: 'حصص مباشرة فردية في القرآن والتجويد والعربية والدراسات الإسلامية مع معلمين من الأزهر يحملون إجازة موثّقة. للأطفال والكبار — أول حصتين مجانًا.' },
      eyebrow: 'حصص فردية مباشرة · علماء من الأزهر',
      title: 'تعلَّم القرآن كما نُقِل إلينا — <span class="accent">بسندٍ متصل.</span>',
      lede: 'حصص مباشرة فردية في القرآن والتجويد والعربية والدراسات الإسلامية مع معلمين من الأزهر يحملون إجازة موثّقة — للأطفال والكبار، وفي مواعيد تناسب توقيتك.',
      test: 'اختبار ٣ دقائق',
      reassure: ['بدون بطاقة دفع', 'معلمات متاحات', 'إلغاء أو إيقاف في أي وقت'],
      card1: ['التجويد · المستوى ٢', 'الدرس ١٢ من ١٨', 'التقدّم'],
      card2: ['الحصة المباشرة القادمة', 'أحكام النون الساكنة', 'الأستاذة أمنية · ٧:٠٠ م (غرينتش)', 'تبدأ بعد ساعتين و١٤ دقيقة'],
      verified: 'إجازة موثّقة',
      stats: [['+٥٠', 'دولة'], ['+١٠٠٠', 'طالب'], ['+١٢', 'إجازة مُنحت'], ['٩٥٪', 'يستمرون بعد الشهر الأول']],
      router: {
        title: 'من سيتعلّم؟',
        lede: 'أخبرنا، ونوجّهك إلى المكان المناسب بنقرة واحدة.',
        childKicker: 'لطفلي',
        childTitle: 'أشبال الأمة · من ٥ إلى ١٤ عامًا',
        childText: 'حصص مرحة مدتها ٣٠ دقيقة مع معلمين صبورين مدرَّبين على تعليم الأطفال — معلمات متاحات، وتقدّم تراه كل شهر.',
        childChips: ['حصص ٣٠ دقيقة', 'ألعاب وقصص', 'أوسمة شهرية'],
        childCta: 'استكشف أشبال الأمة',
        selfKicker: 'لنفسي',
        selfTitle: 'ما هدفك؟',
        goals: [
          ['أقرأ القرآن من الصفر', '/online-arabic-classes/', 'read'],
          ['أتقن التجويد', '/quran-recitation-course/', 'tajweed'],
          ['أحفظ القرآن وأحصل على إجازة', '/quran-memorization-hifz/', 'hifz'],
          ['أفهم عربية القرآن', '/online-arabic-classes/', 'arabic'],
          ['أدرس العقيدة أو الفقه أو التفسير أو السيرة', '/online-islamic-studies-classes/', 'islamic'],
        ],
        unsure: 'لست متأكدًا؟ خذ اختبار تحديد المستوى (٣ دقائق)',
      },
      why: {
        eyebrow: 'لماذا أكاديمية الأمة',
        title: 'علمٌ <span class="accent">متصل السند</span>، وحصص تناسب حياتك.',
        sanadKicker: 'سند موثّق',
        sanadTitle: 'سلسلة من المعلمين تتصل بالنبي ﷺ',
        sanadText: 'كل معلم يحمل إجازة بسند موثّق، ويجتاز تحققًا من أربع مراحل: المؤهلات، والتحقق من السند، وحصة تدريسية مباشرة، ومتابعة مستمرة.',
        sanadLink: 'كيف نختار معلمينا',
        itqan: ['منهج الإتقان', 'آيات مجمّعة حسب الموضوع والمعنى مع تصحيح مباشر — حفظ يدوم، لا تلاوة للعرض فقط.', 'كيف يعمل (بالإنجليزية)'],
        safe: ['آمن لكل أسرة', 'حصص فردية خاصة، ومعلمات للنساء والفتيات، وتقرير بعد كل حصة.'],
        time: ['على مقاس وقتك', 'صباحًا في سيدني أو مساءً في تورونتو — احجز في أي وقت، مع تذكير عبر واتساب قبل الحصة بـ ١٥ دقيقة.'],
        price: ['تبدأ من ٤٠ $ شهريًا', 'خطط واضحة، وحصتان مجانيتان أولًا.', 'اطّلع على الأسعار'],
      },
      how: {
        eyebrow: 'كيف نبدأ',
        title: 'ماذا يحدث <span class="accent">بعد الحجز؟</span>',
        lede: 'بلا تسجيل معقّد — معلم حقيقي وحصتان حقيقيتان، ثم تقرّر.',
        steps: [
          ['أخبرنا عنك', 'ثلاثة أسئلة سريعة: من سيتعلّم، وماذا، ومتى. دقيقة تقريبًا.'],
          ['نختار معلمك', 'نؤكد المعلم والمواعيد عبر واتساب — غالبًا خلال دقائق، وخلال ساعتين على الأكثر.'],
          ['حصتان مجانيتان مباشرتان', 'يحدد معلمك مستواك ويضع خطة تناسب هدفك.'],
          ['تعلّم وشاهد تقدّمك', 'تقرير بعد كل حصة، وشهادة لكل مستوى.'],
        ],
      },
      tracks: { eyebrow: 'الدورات', title: 'أربعة مسارات. <span class="accent">ابدأ من حيث أنت.</span>', lede: 'من أول حرف عربي إلى الإجازة الكاملة.' },
      stories: { eyebrow: 'قصص', title: 'أسر في أكثر من ٥٠ دولة، <span class="accent">وفصل واحد في كل مرة.</span>', note: 'آراء مترجمة من الإنجليزية.' },
      pricing: { eyebrow: 'الأسعار', title: 'أسعار واضحة. <span class="accent">وحصتان مجانيتان أولًا.</span>', text: 'اختر حصص ٣٠ دقيقة للأطفال والتدريب المركّز، أو ٦٠ دقيقة للكبار والتجويد والحفظ.', tabs: ['٣٠ دقيقة', '٦٠ دقيقة'], perSession: 'للحصة تقريبًا', all: 'كل الخطط والتفاصيل' },
      faq: {
        eyebrow: 'أسئلة شائعة',
        title: 'قبل أن <span class="accent">تحجز</span>',
        more: 'كل الأسئلة',
        items: [
          { q: 'هل الحصتان التجريبيتان مجانيتان فعلًا؟', a: 'نعم. حصتان مباشرتان كاملتان مع معلمك — بدون بطاقة دفع وبدون أي التزام. إن رغبت في الاستمرار تختار خطة شهرية، وإن لم ترغب فلا شيء عليك.' },
          { q: 'كم التكلفة؟ وهل يمكنني الإلغاء؟', a: 'تتراوح الخطط بين ٤٠ و١٢٨ دولارًا شهريًا حسب مدة الحصة وعددها. يمكنك الإلغاء في أي وقت (يسري بنهاية الشهر المدفوع)، أو الإيقاف المؤقت، وتغيير موعد الحصة بإشعار قبلها بـ ٢٤ ساعة.' },
          { q: 'هل يمكنني اختيار معلمة؟', a: 'نعم، تتوفر معلمات للنساء والفتيات — اختر «معلمة» عند الحجز.' },
          { q: 'هل طفلي صغير على الدراسة؟', a: 'يرحّب برنامج أشبال الأمة بالأطفال من سن الخامسة، بحصص قصيرة مدتها ٣٠ دقيقة قائمة على اللعب وتناسب تركيز الصغار.' },
          { q: 'أطفالي لا يتقنون العربية، فهل سيستفيدون؟', a: 'بالتأكيد. المعلمون يتقنون العربية والإنجليزية ويشرحون بما يناسب الطفل، وكثير من طلابنا بدؤوا من الصفر.' },
          { q: 'هل الحصص مباشرة؟ وهل تُسجَّل؟', a: 'كل الحصص مباشرة وفردية عبر Zoom أو Google Meet. يرسل المعلم تقريرًا بعد كل حصة، والتسجيلات متاحة عند الطلب إلى أن تكتمل مكتبة التسجيلات في بوابة الأسرة.' },
        ],
      },
      cta: { eyebrow: 'ابدأ اليوم', title: 'ابدأ <span class="accent">بحصتين مجانيتين.</span>', lede: 'تعرّف على معلمك، واختبر الفرق في التعلّم الفردي المباشر، ثم قرّر. بدون بطاقة دفع، وبدون التزام.' },
    }
  : {
      meta: { title: 'Quran & Arabic Classes Online with Al-Azhar Teachers | 2 Free Sessions | Ummah Academy', desc: 'Live 1-on-1 Qur’an, Tajweed, Arabic and Islamic studies with Al-Azhar teachers who hold a verified Ijazah. Kids and adults, any time zone — your first 2 sessions are free.' },
      eyebrow: 'Live 1-on-1 · Al-Azhar scholars',
      title: 'The Qur’an, taught <span class="accent">the way it was transmitted.</span>',
      lede: 'Live 1-on-1 lessons in Qur’an, Tajweed, Arabic and Islamic studies with Al-Azhar teachers who hold a verified Ijazah — for children and adults, in your time zone.',
      test: '3-minute test',
      reassure: ['No card needed', 'Female teachers available', 'Cancel or pause anytime'],
      card1: ['Tajweed · Level 2', 'Lesson 12 of 18', 'Progress'],
      card2: ['Next live session', 'Noon Sakinah rules', 'Ustadha Omneya · 7:00 PM GMT', 'Starts in 2h 14m'],
      verified: 'Ijazah verified',
      stats: [['50+', 'countries'], ['1,000+', 'students'], ['12+', 'Ijazahs granted'], ['95%', 'continue after month one']],
      router: {
        title: 'Who’s learning?',
        lede: 'Tell us and we’ll point you to the right place in one click.',
        childKicker: 'For my child',
        childTitle: 'Ummah Cubs · ages 5–14',
        childText: 'Playful 30-minute lessons with patient, child-trained teachers — female teachers available, and progress you can see every month.',
        childChips: ['30-min sessions', 'Games & stories', 'Monthly badges'],
        childCta: 'Explore Ummah Cubs',
        selfKicker: 'For myself',
        selfTitle: 'What’s your goal?',
        goals: [
          ['Read the Qur’an from zero', '/online-arabic-classes/', 'read'],
          ['Perfect my Tajweed', '/quran-recitation-course/', 'tajweed'],
          ['Memorise & earn an Ijazah', '/quran-memorization-hifz/', 'hifz'],
          ['Understand Qur’anic Arabic', '/online-arabic-classes/', 'arabic'],
          ['Study Aqeedah, Fiqh, Tafseer or Seerah', '/online-islamic-studies-classes/', 'islamic'],
        ],
        unsure: 'Not sure? Take the 3-minute placement test',
      },
      why: {
        eyebrow: 'Why Ummah Academy',
        title: 'Scholarship you can <span class="accent">trace.</span> Lessons that fit your life.',
        sanadKicker: 'Verified Sanad',
        sanadTitle: 'A chain of teachers back to the Prophet ﷺ',
        sanadText: 'Every teacher holds an Ijazah — a documented chain of transmission — and passes a four-stage check: credentials, Sanad verification, a live teaching demo and ongoing review.',
        sanadLink: 'How we vet teachers',
        itqan: ['The Itqan method', 'Verses grouped by theme and meaning, corrected live — memorisation that lasts, not recitation for show.', 'How it works'],
        safe: ['Safe for every family', 'Private 1-on-1 lessons, female teachers for women and girls, and a report after every session.'],
        time: ['Built around your clock', 'Morning in Sydney or evening in Toronto — book any time, with a WhatsApp reminder 15 minutes before.'],
        price: ['From $40 a month', 'Transparent plans. Two free sessions first.', 'See pricing'],
      },
      how: {
        eyebrow: 'How it works',
        title: 'What happens <span class="accent">after you book</span>',
        lede: 'No sign-up maze — a real teacher and two real lessons, then you decide.',
        steps: [
          ['Tell us about you', 'Three quick questions: who’s learning, what and when. About a minute.'],
          ['We match your teacher', 'We confirm a teacher and times on WhatsApp — usually within minutes, always within 2 hours.'],
          ['Two free live lessons', 'Your teacher assesses your level and builds a plan around your goal.'],
          ['Learn and see progress', 'A report after every session and a certificate for every level.'],
        ],
      },
      tracks: { eyebrow: 'Courses', title: 'Four ways in. <span class="accent">Start where you are.</span>', lede: 'From your first Arabic letter to a full Ijazah.' },
      stories: { eyebrow: 'Stories', title: 'Families in 50+ countries, <span class="accent">one classroom at a time.</span>', note: '' },
      pricing: { eyebrow: 'Pricing', title: 'Simple pricing. <span class="accent">Two free sessions first.</span>', text: 'Choose 30-minute sessions for children and focused practice, or 60 minutes for adults, Tajweed and Hifz.', tabs: ['30 minutes', '60 minutes'], perSession: 'per session', all: 'All plans & details' },
      faq: {
        eyebrow: 'Questions',
        title: 'Before you <span class="accent">book</span>',
        more: 'All questions',
        items: [
          { q: 'Are the two trial sessions really free?', a: 'Yes. Two full live lessons with your matched teacher — no card, no obligation. If you continue, you choose a monthly plan; if not, that’s it.' },
          { q: 'How much does it cost, and can I cancel?', a: 'Plans run from $40 to $128 a month depending on session length and frequency. Cancel anytime (effective at the end of your billing month), pause with a subscription freeze, and reschedule with 24 hours’ notice.' },
          { q: 'Can I choose a female teacher?', a: 'Yes. Female teachers are available for women and girls — just choose “Female teacher” when you book.' },
          { q: 'Is my child too young?', a: 'Ummah Cubs welcomes children from age 5, with short, game-based 30-minute lessons designed for young attention spans.' },
          { q: 'I don’t speak Arabic. Will I understand?', a: 'Yes. Every teacher is fully bilingual in Arabic and English, and many of our students start from zero.' },
          { q: 'Are lessons live? Are they recorded?', a: 'Every lesson is live and 1-on-1 on Zoom or Google Meet. Teachers send a report after each session; recordings are available on request while the Family Portal library rolls out.' },
        ],
      },
      cta: { eyebrow: 'Begin today', title: 'Begin with <span class="accent">two free lessons.</span>', lede: 'Meet your teacher, feel the difference of live 1-on-1 learning, then decide. No card, no commitment.' },
    };

const plans30 = plans.filter((p) => p.minutes === 30);
const plans60 = plans.filter((p) => p.minutes === 60);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: ar ? 'أكاديمية الأمة' : 'Ummah Academy',
  url: ar ? 'https://ummahacademy.net/ar/' : 'https://ummahacademy.net/',
};
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang} jsonLd={ld}>
  <!-- 1 · Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy" data-reveal>
        <span class="eyebrow">{C.eyebrow}</span>
        <h1 class="hero__title" set:html={C.title} />
        <p class="lead hero__lede">{C.lede}</p>
        <div class="cluster hero__actions">
          <a class="btn btn--lg btn--primary" href={lp(lang, '/contact/') + '#book'} data-track="hero">
            {t.book2} <Icon name="arrow-right" weight="bold" class="icon-arrow" />
          </a>
          <a class="btn btn--lg btn--glass" href={lp(lang, '/placement-test/')} data-track="hero">
            <Icon name="compass" weight="duotone" /> {t.findLevel}
            <span class="hero__btn-note">{C.test}</span>
          </a>
        </div>
        <ul role="list" class="hero__reassure">
          {C.reassure.map((r) => <li><Icon name="check-circle" weight="fill" /> {r}</li>)}
        </ul>
      </div>

      <div class="hero__visual" data-reveal data-tilt style="--reveal-delay:.15s">
        <span class="hero__iqra quranic" aria-hidden="true">اقْرَأْ</span>
        <div class="frame frame--arch hero__frame">
          <Image src={heroArt} alt="" widths={[420, 640, 900]} sizes="(min-width: 960px) 460px, 86vw" loading="eager" fetchpriority="high" />
          <span class="hero__verified"><Icon name="seal-check" weight="fill" /> {C.verified}</span>
        </div>
        <div class="hero__card hero__card--progress glass" aria-hidden="true">
          <span class="icon-badge"><Icon name="book-open-text" /></span>
          <div class="hero__card-body">
            <p class="hero__card-title">{C.card1[0]}</p>
            <p class="hero__card-meta">{C.card1[1]}</p>
            <div class="progress"><span style="width:68%"></span></div>
            <p class="hero__card-meta"><span>{C.card1[2]}</span><strong>{num(lang, 68)}%</strong></p>
          </div>
        </div>
        <div class="hero__card hero__card--live glass" aria-hidden="true">
          <p class="hero__live"><span class="pulse"></span> {C.card2[0]}</p>
          <p class="hero__card-title">{C.card2[1]}</p>
          <p class="hero__card-meta">{C.card2[2]}</p>
          <p class="hero__countdown"><Icon name="clock" weight="bold" /> {C.card2[3]}</p>
        </div>
      </div>
    </div>

    <!-- 2 · Proof strip -->
    <div class="container">
      <ul role="list" class="proof glass" data-reveal>
        {C.stats.map(([n, l]) => <li><strong>{n}</strong><span>{l}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- 3 · Audience router -->
  <section class="section router" aria-labelledby="router-title">
    <div class="container">
      <div class="router__head" data-reveal>
        <h2 id="router-title">{C.router.title}</h2>
        <p class="lead">{C.router.lede}</p>
      </div>
      <div class="router__grid">
        <a class="router__child glass glass--interactive" href={lp(lang, '/ummah-cubs-kids-islamic-studies/')} data-router="child" data-goal="kids" data-reveal>
          <div class="router__art" aria-hidden="true">
            <Image src={tracks[2].image} alt="" widths={[360, 560]} sizes="(min-width: 960px) 260px, 70vw" />
          </div>
          <div class="router__copy">
            <span class="chip chip--accent"><Icon name="baby" /> {C.router.childKicker}</span>
            <h3>{C.router.childTitle}</h3>
            <p>{C.router.childText}</p>
            <ul role="list" class="cluster router__chips">{C.router.childChips.map((c) => <li class="chip">{c}</li>)}</ul>
            <span class="btn btn--primary router__cta">{C.router.childCta} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></span>
          </div>
        </a>
        <div class="router__self glass" data-reveal style="--reveal-delay:.08s">
          <span class="chip chip--accent"><Icon name="user" /> {C.router.selfKicker}</span>
          <h3>{C.router.selfTitle}</h3>
          <ul role="list" class="router__goals">
            {
              C.router.goals.map(([label, href, goal]) => (
                <li>
                  <a href={lp(lang, href)} data-router="self" data-goal={goal}>
                    <span>{label}</span>
                    <Icon name="arrow-right" weight="bold" class="icon-arrow" />
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="router__unsure" href={lp(lang, '/placement-test/')} data-router="self" data-goal="unsure">
            <Icon name="compass" /> {C.router.unsure}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Why (bento) -->
  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="head-split" data-reveal>
        <span class="eyebrow">{C.why.eyebrow}</span>
        <h2 id="why-title" set:html={C.why.title} />
      </div>
      <div class="bento">
        <article class="bento__sanad theme-night" data-reveal>
          <div class="stars"></div>
          <span class="chip"><Icon name="seal-check" weight="fill" /> {C.why.sanadKicker}</span>
          <h3>{C.why.sanadTitle}</h3>
          <p>{C.why.sanadText}</p>
          <SanadChain dark lang={lang} />
          <a class="btn btn--glass btn--sm" href={lp(lang, '/teachers/') + '#process'}>{C.why.sanadLink} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
        </article>
        <article class="bento__tile glass" data-reveal style="--reveal-delay:.05s">
          <span class="icon-badge"><Icon name="brain" /></span>
          <h3>{C.why.itqan[0]}</h3>
          <p>{C.why.itqan[1]}</p>
          <a class="btn btn--link" href="/the-itqan-method-explained-how-thematic-memorization-makes-hifz-easier/">{C.why.itqan[2]} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
        </article>
        <article class="bento__tile glass" data-reveal style="--reveal-delay:.1s">
          <span class="icon-badge"><Icon name="shield-check" /></span>
          <h3>{C.why.safe[0]}</h3>
          <p>{C.why.safe[1]}</p>
        </article>
        <article class="bento__tile glass" data-reveal style="--reveal-delay:.15s">
          <span class="icon-badge"><Icon name="globe-hemisphere-west" /></span>
          <h3>{C.why.time[0]}</h3>
          <p>{C.why.time[1]}</p>
        </article>
        <a class="bento__price glass glass--interactive" href={lp(lang, '/pricing/')} data-reveal style="--reveal-delay:.2s">
          <span class="bento__price-num">{C.why.price[0]}</span>
          <span>{C.why.price[1]}</span>
          <span class="btn btn--link">{C.why.price[2]} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></span>
        </a>
      </div>
    </div>
  </section>

