---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import TilawaTeaser from '@/components/TilawaTeaser.astro';
import SanadChain from '@/components/SanadChain.astro';
import Faq from '@/components/Faq.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import heroArt from '@/assets/art/hero-learning.webp';
import { getTracks } from '@/data/tracks';
import { getTeachers, getTestimonials } from '@/data/people';
import { getPlans, perSession } from '@/data/pricing';
import Money from '@/components/Money.astro';
import { lp, num, type Lang } from '@/i18n';
import { copy, ui } from '@/locales';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = ui(lang);
const tracks = getTracks(lang);
const stories = getTestimonials(lang);
const plans = getPlans(lang);
const teachers = getTeachers(lang);

const COPY = copy(lang).home;
const C = COPY.C;

const plans30 = plans.filter((p) => p.minutes === 30);
const plans60 = plans.filter((p) => p.minutes === 60);

// Hero headline: an inline pill (the teachers' initials + a verified seal) sits before the highlighted phrase.
const ACCENT = '<span class="accent">';
const cut = C.title.indexOf(ACCENT);
const titleLead = cut >= 0 ? C.title.slice(0, cut) : C.title;
const titleAccent = cut >= 0 ? C.title.slice(cut) : '';

// Tones per programme (the same order as the tracks data: quran, arabic, kids, islamic).
const TONE: Record<string, string> = { quran: 'lavender', arabic: 'sky', kids: 'rose', islamic: 'mauve' };
const STEP_TONES = ['lavender', 'sky', 'mauve', 'rose'];
const kids = tracks.find((tr) => tr.id === 'kids') ?? tracks[2];
// Ticker: the four programmes and the three promises, looping.
const tickerItems = [...tracks.map((tr) => tr.title), ...C.reassure];
// Rotating badge text, repeated to fill the circle.
const spinText = `${C.verified} · ${C.why.sanadKicker} · `.repeat(2);
const pad = (n: number) => num(lang, String(n).padStart(2, '0'));
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang}>
  <!-- 1 · Hero: headline with an inline pill, and a bento of photo + figures -->
  <section class="hero2">
    <div class="container hero2__grid">
      <div class="hero2__copy" data-reveal>
        <span class="eyebrow">{C.eyebrow}</span>
        <h1 class="hero2__title">
          <Fragment set:html={titleLead} />
          <span class="hero2__pill" aria-hidden="true">
            <span class="avatars">{teachers.map((tt) => <span>{tt.initials}</span>)}</span>
            <Icon name="seal-check" weight="fill" />
          </span>
          {' '}<Fragment set:html={titleAccent} />
        </h1>
        <p class="lead hero2__lede">{C.lede}</p>
        <div class="cluster hero2__actions">
          <a class="btn btn--lg btn--primary" href={lp(lang, '/contact/') + '#book'} data-track="hero">
            {t.book2} <Icon name="arrow-right" weight="bold" class="icon-arrow" />
          </a>
          <a class="btn btn--lg btn--glass" href={lp(lang, '/placement-test/')} data-track="hero">
            <Icon name="compass" weight="duotone" /> {t.findLevel}
            <span class="hero2__btn-note">{C.test}</span>
          </a>
        </div>
        <ul role="list" class="hero2__reassure">
          {C.reassure.map((r) => <li><Icon name="check-circle" weight="fill" /> {r}</li>)}
        </ul>
      </div>

      <div class="hero2__bento" data-reveal style="--reveal-delay:.12s">
        <div class="hb-photo">
          <Image src={heroArt} alt="" widths={[420, 640, 900]} sizes="(min-width: 1024px) 380px, 60vw" loading="eager" fetchpriority="high" />
          <ul role="list" class="hb-photo__chips" aria-hidden="true">
            {tracks.slice(0, 3).map((tr) => <li class="status">{tr.title}</li>)}
          </ul>
          <a class="hb-photo__bubble" href={lp(lang, '/contact/') + '#book'} data-track="hero-bubble">
            <span>
              <strong>{C.card2[0]}</strong>
              <small>{C.card2[1]}</small>
            </span>
            <span class="arrow-btn arrow-btn--dark" style="--arrow-size:42px"><Icon name="arrow-up-right" weight="bold" /></span>
          </a>
        </div>
        <div class="stat-tile tone tone--sky hb-stat">
          <span class="avatars" style="--av:34px" aria-hidden="true">{teachers.map((tt) => <span>{tt.initials}</span>)}<span>+</span></span>
          <span>
            <span class="stat-tile__num">{C.stats[1][0]}</span>
            <span class="stat-tile__label">{C.stats[1][1]}</span>
          </span>
        </div>
        <div class="stat-tile tone tone--mauve hb-stat">
          <span class="hb-stat__icon" aria-hidden="true"><Icon name="globe-hemisphere-west" weight="duotone" /></span>
          <span>
            <span class="stat-tile__num">{C.stats[0][0]}</span>
            <span class="stat-tile__label">{C.stats[0][1]}</span>
          </span>
        </div>
        <div class="hb-spin" aria-hidden="true">
          <svg class="spin-badge" viewBox="0 0 120 120" data-overflow-ok>
            <defs><path id="hb-spin-path" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs>
            <text><textPath href="#hb-spin-path">{spinText}</textPath></text>
          </svg>
          <span class="hb-spin__core"><Icon name="seal-check" weight="fill" /></span>
        </div>
      </div>
    </div>

    <!-- Ticker: programmes and promises -->
    <div class="ticker hero2__ticker" role="region" aria-label={C.tracks.eyebrow} data-overflow-ok>
      <div class="ticker__track">
        {tickerItems.map((item) => <span class="ticker__item">{item}</span>)}
        {tickerItems.map((item) => <span class="ticker__item" aria-hidden="true">{item}</span>)}
      </div>
    </div>
  </section>

  <!-- 2 · Tilawa — free on-device recitation companion -->
  <TilawaTeaser lang={lang} />

  <!-- 3 · Who's learning: two pastel cards, status pills, "I want to…" rows -->
  <section class="section rt" aria-labelledby="router-title">
    <div class="container">
      <div class="rt__head" data-reveal>
        <h2 id="router-title">{C.router.title}</h2>
        <p class="lead">{C.router.lede}</p>
      </div>
      <div class="rt__grid">
        <a class="rt-card rt-card--child tone tone--rose" href={lp(lang, kids.href)} data-router="child" data-goal="kids" data-reveal>
          <span class="rt-shape rt-shape--a" aria-hidden="true"></span>
          <span class="rt-shape rt-shape--b" aria-hidden="true"></span>
          <div class="rt-card__copy">
            <span class="status">{C.router.childKicker}</span>
            <h3>{C.router.childTitle}</h3>
            <p>{C.router.childText}</p>
            <ul role="list" class="rt-card__chips">{C.router.childChips.map((c) => <li class="status status--ghost">{c}</li>)}</ul>
            <span class="link-arrow">{C.router.childCta} <Icon name="arrow-right" weight="bold" /></span>
          </div>
          <div class="rt-card__art" aria-hidden="true">
            <Image src={kids.image} alt="" widths={[320, 520]} sizes="(min-width: 960px) 240px, 60vw" />
            <span class="arrow-btn arrow-btn--dark"><Icon name="arrow-up-right" weight="bold" /></span>
          </div>
        </a>
        <div class="rt-card rt-card--self tone tone--lavender" data-reveal style="--reveal-delay:.08s">
          <span class="status">{C.router.selfKicker}</span>
          <h3>{C.router.selfTitle}</h3>
          <ul role="list" class="rt-goals">
            {
              C.router.goals.map(([label, href, goal]) => (
                <li>
                  <a href={lp(lang, href)} data-router="self" data-goal={goal}>
                    <span>{label}</span>
                    <span class="arrow-btn" style="--arrow-size:34px">
                      <Icon name="arrow-up-right" weight="bold" />
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="link-arrow" href={lp(lang, '/placement-test/')} data-router="self" data-goal="unsure">
            <Icon name="compass" weight="duotone" /> {C.router.unsure}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Programmes: numbered panels that open on hover / focus -->
  <section class="section" aria-labelledby="tracks-title">
    <div class="container">
      <div class="head-row" data-reveal>
        <div class="stack" style="--stack:14px">
          <span class="eyebrow" style="align-self:flex-start">{C.tracks.eyebrow}</span>
          <h2 id="tracks-title" class="h2" set:html={C.tracks.title} />
          <p class="lead">{C.tracks.lede}</p>
        </div>
        <a class="btn btn--glass" href={lp(lang, '/courses/')}>{t.compareCourses} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
      </div>
      <div class="pg" data-panels data-reveal>
        {
          tracks.map((tr, i) => (
            <a class:list={['pg__panel', 'tone', `tone--${TONE[tr.id] ?? 'lavender'}`, { 'is-open': i === 0 }]} href={lp(lang, tr.href)}>
              <span class="pg__num">{pad(i + 1)}</span>
              <span class="pg__label" aria-hidden="true">{tr.title}</span>
              <span class="pg__body">
                <span class="pg__text">
                  <span class="pg__sub">{tr.subtitle}</span>
                  <span class="pg__title">{tr.title}</span>
                  <span class="pg__intro">{tr.intro}</span>
                  <span class="pg__foot">
                    <span class="pg__price">
                      {t.from} <Money usd={tr.from} lang={lang} />
                      <small>{t.perMonth}</small>
                    </span>
                    <span class="arrow-btn arrow-btn--dark"><Icon name="arrow-up-right" weight="bold" /></span>
                  </span>
                </span>
                <span class="pg__img">
                  <Image src={tr.image} alt="" widths={[360, 560, 760]} sizes="(min-width: 960px) 420px, 90vw" />
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5 · Why: bento of the Sanad card, figures, the method and the promises -->
  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="head-split" data-reveal>
        <span class="eyebrow">{C.why.eyebrow}</span>
        <h2 id="why-title" set:html={C.why.title} />
      </div>
      <div class="wb">
        <article class="wb__sanad theme-night" data-reveal>
          <div class="stars"></div>
          <div class="wb__sanad-head">
            <span class="status">{C.why.sanadKicker}</span>
            <svg class="spin-badge wb__spin" viewBox="0 0 120 120" aria-hidden="true" data-overflow-ok>
              <defs><path id="wb-spin-path" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs>
              <text><textPath href="#wb-spin-path">{spinText}</textPath></text>
            </svg>
          </div>
          <h3>{C.why.sanadTitle}</h3>
          <p>{C.why.sanadText}</p>
          <SanadChain dark lang={lang} />
          <a class="link-arrow" href={lp(lang, '/teachers/') + '#process'}>{C.why.sanadLink} <Icon name="arrow-right" weight="bold" /></a>
        </article>
        {
          [C.stats[2], C.stats[3]].map(([n, l], i) => (
            <div class:list={['stat-tile', 'tone', i ? 'tone--sky' : 'tone--mauve', 'wb__stat', i ? 'wb__stat--b' : 'wb__stat--a']} data-reveal style={`--reveal-delay:${0.05 + i * 0.05}s`}>
              <Icon name={i ? 'chart-line-up' : 'certificate'} weight="duotone" class="wb__stat-icon" />
              <span>
                <span class="stat-tile__num">{n}</span>
                <span class="stat-tile__label">{l}</span>
              </span>
            </div>
          ))
        }
        <a class="wb__itqan tone tone--deep tone--grad-plum" href="/the-itqan-method-explained-how-thematic-memorization-makes-hifz-easier/" data-reveal style="--reveal-delay:.12s">
          <span class="wb__itqan-copy">
            <span class="status">{C.why.itqan[0]}</span>
            <span class="wb__itqan-text">{C.why.itqan[1]}</span>
            <span class="link-arrow">{C.why.itqan[2]} <Icon name="arrow-right" weight="bold" /></span>
          </span>
          <span class="arrow-btn arrow-btn--dark wb__itqan-arrow"><Icon name="arrow-up-right" weight="bold" /></span>
        </a>
        <article class="wb__tile wb__tile--safe" data-reveal style="--reveal-delay:.05s">
          <span class="icon-badge"><Icon name="shield-check" /></span>
          <h3>{C.why.safe[0]}</h3>
          <p>{C.why.safe[1]}</p>
        </article>
        <article class="wb__tile wb__tile--time" data-reveal style="--reveal-delay:.1s">
          <span class="icon-badge"><Icon name="globe-hemisphere-west" /></span>
          <h3>{C.why.time[0]}</h3>
          <p>{C.why.time[1]}</p>
        </article>
        <a class="wb__price tone tone--dusk" href={lp(lang, '/pricing/')} data-reveal style="--reveal-delay:.15s">
          <span class="wb__price-num">{C.why.price[0]}</span>
          <span>{C.why.price[1]}</span>
          <span class="link-arrow">{C.why.price[2]} <Icon name="arrow-right" weight="bold" /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 6 · What happens after you book: numbered cards on a dotted path -->
  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <div class="head-row" data-reveal>
        <div class="stack" style="--stack:14px">
          <span class="eyebrow" style="align-self:flex-start">{C.how.eyebrow}</span>
          <h2 id="how-title" class="h2" set:html={C.how.title} />
          <p class="lead">{C.how.lede}</p>
        </div>
        <a class="btn btn--primary" href={lp(lang, '/contact/') + '#book'} data-track="how">{t.book2} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
      </div>
      <ol role="list" class="hw">
        {
          C.how.steps.map(([h, p], i) => (
            <li class:list={['num-card', 'tone', `tone--${STEP_TONES[i % STEP_TONES.length]}`]} data-reveal style={`--reveal-delay:${i * 0.06}s`}>
              <span class="hw__dot" aria-hidden="true"></span>
              <span class="num-card__num">{pad(i + 1)}.</span>
              <h3>{h}</h3>
              <p>{p}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 7 · Stories -->
  <section class="section" aria-labelledby="stories-title">
    <div class="container">
      <div class="head-split" data-reveal>
        <span class="eyebrow">{C.stories.eyebrow}</span>
        <h2 id="stories-title" set:html={C.stories.title} />
      </div>
    </div>
    <div class="rail" data-reveal tabindex="0" aria-label={C.stories.eyebrow}>
      <ul role="list" class="rail__track">
        {stories.map((s) => <li><TestimonialCard t={s} lang={lang} /></li>)}
      </ul>
    </div>
    <p class="container rail__note">
      {C.stories.note && <span class="muted">{C.stories.note} </span>}
      <a class="link-arrow" href={lp(lang, '/reviews/')}>{C.stories.all} <Icon name="arrow-right" weight="bold" /></a>
    </p>
  </section>

  <!-- 8 · Pricing teaser -->
  <section class="section" aria-labelledby="pricing-title">
    <div class="container">
      <div class="price-teaser" data-reveal>
        <div class="price-teaser__copy">
          <span class="eyebrow">{C.pricing.eyebrow}</span>
          <h2 id="pricing-title" set:html={C.pricing.title} />
          <p class="lead">{C.pricing.text}</p>
          <a class="link-arrow" href={lp(lang, '/pricing/')}>{C.pricing.all} <Icon name="arrow-right" weight="bold" /></a>
        </div>
        <div class="price-teaser__plans" data-tabs>
          <div class="seg-tabs" role="tablist" aria-label={C.pricing.eyebrow}>
            <button role="tab" type="button" aria-selected="true" aria-controls="pt-30" id="tab-30" data-tab="30">{C.pricing.tabs[0]}</button>
            <button role="tab" type="button" aria-selected="false" aria-controls="pt-60" id="tab-60" data-tab="60" tabindex="-1">{C.pricing.tabs[1]}</button>
          </div>
          {
            [
              ['30', plans30],
              ['60', plans60],
            ].map(([id, list]) => (
              <div role="tabpanel" id={`pt-${id}`} aria-labelledby={`tab-${id}`} hidden={id === '60'}>
                <ul role="list" class="mini-plans">
                  {(list as typeof plans).map((p, i) => (
                    <li class:list={['mini-plan', 'tone', ['tone--lavender', 'tone--sky', 'tone--mauve', 'tone--rose'][i % 4], { 'mini-plan--badge': p.badge }]}>
                      <div>
                        <p class="mini-plan__name">
                          {p.name} {p.badge && <span class="mini-plan__badge">{p.badge}</span>}
                        </p>
                        <p class="mini-plan__meta">{p.sessionsLabel}</p>
                      </div>
                      <p class="mini-plan__price">
                        <Money usd={p.price} lang={lang} />
                        <small>{t.perMonth}</small>
                        <span>
                          {t.approx}<Money usd={perSession(p)} lang={lang} /> {C.pricing.perSession}
                        </span>
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 9 · FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="container faq-split">
      <div class="stack faq-split__head" style="--stack:16px" data-reveal>
        <span class="eyebrow" style="align-self:flex-start">{C.faq.eyebrow}</span>
        <h2 id="faq-title" class="h2" set:html={C.faq.title} />
        <a class="link-arrow" href={lp(lang, '/faq/')}>{C.faq.more} <Icon name="arrow-right" weight="bold" /></a>
      </div>
      <Faq items={C.faq.items} />
    </div>
  </section>

  <!-- 10 · CTA -->
  <CtaPanel lang={lang} eyebrow={C.cta.eyebrow} title={C.cta.title} lede={C.cta.lede} />
</BaseLayout>

<script>
  // Programme panels: the hovered / focused panel opens (desktop); phones show every panel open.
  document.querySelectorAll<HTMLElement>('[data-panels]').forEach((box) => {
    const panels = Array.from(box.querySelectorAll<HTMLElement>('.pg__panel'));
    const open = (panel: HTMLElement) => panels.forEach((p) => p.classList.toggle('is-open', p === panel));
    panels.forEach((p) => {
      p.addEventListener('mouseenter', () => open(p));
      p.addEventListener('focus', () => open(p));
    });
  });

  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
    const tabs = Array.from(box.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const dir = document.dir === 'rtl' ? -1 : 1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          const delta = (e.key === 'ArrowRight' ? 1 : -1) * dir;
          const next = tabs[(i + delta + tabs.length) % tabs.length];
          next.focus();
          select(next);
        }
      });
    });
  });
</script>

<style>
  .h2 {
    font-size: var(--fs-h2);
  }

  /* ── 1 · Hero ─────────────────────────────────────────────── */
  .hero2 {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(24px, 3.5vw, 56px) 0;
  }

  .hero2__grid {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero2__grid {
      grid-template-columns: 1.02fr 1fr;
    }
  }

  .hero2__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .hero2__title {
    font-size: clamp(2.5rem, 1.3rem + 4.2vw, 4.7rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.048em;
  }

  :global([dir='rtl']) .hero2__title {
    font-size: clamp(2.2rem, 1.2rem + 3.6vw, 4rem);
    font-weight: 600;
    line-height: 1.38;
    letter-spacing: 0;
  }

  .hero2__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.12em;
    height: 0.84em;
    padding-inline: 0.1em 0.16em;
    border-radius: var(--r-pill);
    vertical-align: -0.08em;
    background: var(--card);
    border: 1px solid var(--card-line);
    box-shadow: var(--shadow-soft);
  }

  /* sized against the headline: font-size .2em x width 3em = .6em of the h1 */
  .hero2__pill .avatars > span {
    width: 3em;
    height: 3em;
    font-size: 0.2em;
    border-width: 0.28em;
  }

  .hero2__pill .avatars > span + span {
    margin-inline-start: -0.85em;
  }

  .hero2__pill :global(svg) {
    width: 0.52em;
    height: 0.52em;
    color: var(--accent);
  }

  .hero2__lede {
    max-width: 48ch;
  }

  .hero2__btn-note {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--ink-3);
    padding-inline-start: 6px;
    border-inline-start: 1px solid var(--line-strong);
    margin-inline-start: 2px;
  }

  .hero2__reassure {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .hero2__reassure li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .hero2__reassure :global(svg) {
    width: 17px;
    height: 17px;
    color: var(--success);
  }

  /* bento */
  .hero2__bento {
    position: relative;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 14px;
    min-height: 480px;
  }

  .hb-photo {
    position: relative;
    grid-row: span 2;
    overflow: hidden;
    border-radius: 32px;
    box-shadow: var(--shadow-soft);
  }

  .hb-photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

