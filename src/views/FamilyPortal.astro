---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import { portalLinks, waLink } from '@/data/site';
import { num, type Lang } from '@/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';

const C = ar
  ? {
      meta: { title: 'بوابة الأسرة — تابع تعلّم أبنائك من مكان واحد | أكاديمية الأمة', desc: 'حساب واحد للأسرة كلها: تنقّل بين ملفات أبنائك، واقرأ تقرير المعلم بعد كل حصة، واستقبل التنبيهات عبر واتساب. لوحات التقدّم ومكتبة التسجيلات والفوترة الموحّدة قريبًا.' },
      crumb: 'بوابة الأسرة',
      eyebrow: 'بوابة الأسرة',
      title: 'تعلّم أسرتك كلها <span class="accent">في مكان واحد</span>',
      lede: 'حساب عائلي واحد: تنقّل بين أبنائك، واقرأ تقريرًا بعد كل حصة، واستقبل التنبيهات عبر واتساب. أما لوحات التقدّم المباشرة ومكتبة التسجيلات والفوترة الموحّدة فهي في طريقها إليك.',
      create: 'أنشئ حساب الأسرة مجانًا',
      signIn: 'الدخول إلى البوابة',
      mock: {
        aria: 'معاينة للوحة بوابة الأسرة',
        brand: 'أكاديمية الأمة',
        parent: 'أحمد الراشد',
        initials: 'أر',
        kidsLabel: 'أبنائي',
        kids: [
          { i: 'ع', name: 'عمر', sub: 'التجويد ٢' },
          { i: 'س', name: 'سارة', sub: 'نور البيان' },
          { i: 'خ', name: 'خالد', sub: 'أشبال الأمة' },
        ],
        nextLabel: 'حصة عمر القادمة',
        nextWhen: 'اليوم · ١٠:٠٠ ص بتوقيت لندن',
        nextWho: 'المعلمة أمنية · التجويد المستوى ٢',
        join: 'ادخل غرفة الحصة',
        progress: 'تقدّم عمر',
        alerts: ['تقرير سارة جاهز', 'حصة خالد غدًا ١١ ص', 'يتجدد الاشتراك خلال ١٤ يومًا'],
      },
      featuresEyebrow: 'مزايا ذكية',
      featuresTitle: 'كل ما يحتاجه الوالدان <span class="accent">في مكان واحد</span>',
      featuresLede: 'صُممت للآباء والأمهات الذين يريدون وضوحًا ومتابعة وطمأنينة.',
      soon: 'قريبًا',
      features: [
        { icon: 'users-three', title: 'حساب عائلي موحّد', text: 'تسجيل دخول واحد، وتنقّل بين ملفات أبنائك بلمسة.', soon: false },
        { icon: 'chart-bar', title: 'لوحة تقدّم مباشرة', text: 'مؤشرات تقدّم ومحطات إنجاز ورسوم بيانية لكل طفل.', soon: true },
        { icon: 'clipboard-text', title: 'تقرير بعد كل حصة', text: 'تقرير مفصّل من المعلم بعد كل حصة، مع الواجب والخطوة التالية.', soon: false },
        { icon: 'film-strip', title: 'مكتبة التسجيلات', text: 'كل حصة مسجّلة تلقائيًا، فتراجعها متى شئت.', soon: true },
        { icon: 'bell-ringing', title: 'تنبيهات واتساب', text: 'تذكير بالحصص، وإشعار بالتقارير، وتنبيه قبل التجديد.', soon: false },
        { icon: 'credit-card', title: 'فوترة موحّدة', text: 'أدر اشتراكات جميع أبنائك من لوحة واحدة.', soon: true },
      ],
      ctaEyebrow: 'للأسر المسلمة حول العالم',
      ctaTitle: 'أنشئ <span class="accent">حساب أسرتك</span> مجانًا اليوم',
      ctaLede: 'ابدأ بحصتين تجريبيتين مجانيتين لكل طفل، دون أي دفع.',
      ask: 'اسأل عبر واتساب',
    }
  : {
      meta: { title: "Family Portal | Manage Your Family's Classes | Ummah Academy", desc: 'One account for the whole family: switch between children, read post-session reports, get WhatsApp alerts — with dashboards, recordings and unified billing coming soon.' },
      crumb: 'Family Portal',
      eyebrow: 'Family Portal',
      title: 'Manage Your Family’s <span class="accent">Deen</span> in One Place',
      lede: 'One family account — switch between your children, read a report after every lesson and get WhatsApp alerts. Live dashboards, a recording library and unified billing are rolling out next.',
      create: 'Create Family Account Free',
      signIn: 'Sign In to Portal',
      mock: {
        aria: 'Preview of the Family Portal dashboard',
        brand: 'Ummah Academy',
        parent: 'Ahmad Al-Rashid',
        initials: 'AR',
        kidsLabel: 'My Children',
        kids: [
          { i: 'O', name: 'Omar', sub: 'Tajweed L2' },
          { i: 'S', name: 'Sara', sub: 'Noor Al-Bayan' },
          { i: 'K', name: 'Khalid', sub: 'Ummah Cubs' },
        ],
        nextLabel: 'Omar’s Next Session',
        nextWhen: 'Today · 10:00 AM BST',
        nextWho: 'Teacher Omneya · Tajweed Level 2',
        join: 'Join Session Room',
        progress: 'Omar’s Progress',
        alerts: ['Sara’s report is ready', 'Khalid’s session tomorrow 11 AM', 'Subscription renews in 14 days'],
      },
      featuresEyebrow: 'Smart Features',
      featuresTitle: 'Everything a Parent Needs in <span class="accent">One Place</span>',
      featuresLede: 'Built for Muslim parents who want visibility, control, and peace of mind.',
      soon: 'Coming soon',
      features: [
        { icon: 'users-three', title: 'Unified Family Account', text: 'One login — switch between children’s profiles with a single tap.', soon: false },
        { icon: 'chart-bar', title: 'Live Progress Dashboard', text: 'Visual progress bars, milestones, and performance charts for every child.', soon: true },
        { icon: 'clipboard-text', title: 'Post-Session Reports', text: 'Detailed teacher report after every session with homework and next steps.', soon: false },
        { icon: 'film-strip', title: 'Recording Library', text: 'Every session auto-recorded. Review any class at any time.', soon: true },
        { icon: 'bell-ringing', title: 'WhatsApp Alerts', text: 'Session reminders, report notifications, and renewal alerts.', soon: false },
        { icon: 'credit-card', title: 'Unified Billing', text: 'Manage all children’s subscriptions from one dashboard.', soon: true },
      ],
      ctaEyebrow: 'For Muslim families worldwide',
      ctaTitle: 'Create Your Free <span class="accent">Family Account</span> Today',
      ctaLede: 'Start with 2 free trials for each child. No payment required.',
      ask: 'Ask on WhatsApp',
    };
const M = C.mock;
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang}>
  <PageHero eyebrow={C.eyebrow} title={C.title} lede={C.lede} crumbs={[{ label: C.crumb }]} lang={lang}>
    <Fragment slot="actions">
      <a class="btn btn--primary" href={portalLinks.register}>{C.create} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
      <a class="btn btn--glass" href={portalLinks.login}>{C.signIn}</a>
    </Fragment>
    <Fragment slot="visual">
      <div class="portal glass glass--strong" role="img" aria-label={M.aria}>
        <div class="portal__head">
          <span class="portal__avatar">{M.initials}</span>
          <span><small>{M.brand}</small><strong>{M.parent}</strong></span>
        </div>
        <p class="portal__label">{M.kidsLabel}</p>
        <div class="portal__kids">
          {M.kids.map((k, i) => <span class:list={['portal__kid', { 'is-active': i === 0 }]}><b>{k.i}</b>{k.name}<small>{k.sub}</small></span>)}
        </div>
        <div class="portal__next">
          <p class="portal__label">{M.nextLabel}</p>
          <strong>{M.nextWhen}</strong>
          <small>{M.nextWho}</small>
          <span class="btn btn--sm btn--primary portal__join"><Icon name="play" weight="fill" /> {M.join}</span>
        </div>
        <div class="portal__progress">
          <span>{M.progress}</span><strong>{ar ? '٦٥٪' : '65%'}</strong>
          <span class="portal__bar"><i style="width:65%"></i></span>
        </div>
        <ul role="list" class="portal__alerts">
          <li><Icon name="bell" weight="fill" /> {M.alerts[0]}</li>
          <li><Icon name="calendar" weight="fill" /> {M.alerts[1]}</li>
          <li><Icon name="credit-card" weight="fill" /> {M.alerts[2]}</li>
        </ul>
      </div>
    </Fragment>
  </PageHero>

  <section class="section" aria-labelledby="pf-title">
    <div class="container">
      <SectionHead id="pf-title" eyebrow={C.featuresEyebrow} title={C.featuresTitle} lede={C.featuresLede} />
      <ol role="list" class="grid grid-3 pf">
        {
          C.features.map((f, i) => (
            <li class="card glass" data-reveal style={`--reveal-delay:${i * 0.05}s`}>
              <div class="pf__top">
                <span class="icon-badge">
                  <Icon name={f.icon} />
                </span>
                <span class="pf__num" aria-hidden="true">{num(lang, `0${i + 1}`)}</span>
              </div>
              <h3>
                {f.title} {f.soon && <span class="chip chip--accent">{C.soon}</span>}
              </h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaPanel lang={lang} eyebrow={C.ctaEyebrow} title={C.ctaTitle} lede={C.ctaLede} primary={{ label: C.create, href: portalLinks.register }} secondary={{ label: C.ask, href: waLink() }} ticks={[]} />
</BaseLayout>

<style>
  .portal {
    --radius: 30px;
    display: grid;
    gap: 14px;
    padding: 22px;
    max-width: 440px;
    margin-inline: auto;
  }

  .portal__head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .portal__head small {
    display: block;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .portal__avatar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #fff;
    font-weight: 650;
    font-size: 0.85rem;
    background: var(--grad-accent);
  }

  .portal__label {
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .portal__kids {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .portal__kid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 10px 6px;
    border-radius: 16px;
    font-weight: 600;
    font-size: 0.9rem;
    background: rgb(255 255 255 / 0.6);
    box-shadow: inset 0 0 0 1px rgb(46 29 70 / 0.06);
  }

  .portal__kid.is-active {
    box-shadow: inset 0 0 0 2px var(--violet-600);
    background: #fff;
  }

  .portal__kid b {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 0.8rem;
    color: var(--accent-ink);
    background: var(--blush-100);
  }

  .portal__kid small {
    font-weight: 450;
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .portal__next {
    display: grid;
    gap: 2px;
    padding: 16px;
    border-radius: 18px;
    background:
      radial-gradient(120% 100% at 100% 0%, rgb(175 204 234 / 0.6), transparent 60%),
      rgb(255 255 255 / 0.7);
  }

  .portal__next small {
    color: var(--ink-3);
  }

  .portal__join {
    margin-top: 10px;
    width: fit-content;
    pointer-events: none;
  }

  .portal__progress {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px;
    font-size: 0.88rem;
  }

  .portal__bar {
    grid-column: 1 / -1;
    height: 7px;
    border-radius: 99px;
    background: rgb(46 29 70 / 0.08);
    overflow: hidden;
  }

  .portal__bar i {
    display: block;
    height: 100%;
    background: var(--grad-accent);
  }

  .portal__alerts {
    display: grid;
    gap: 8px;
    font-size: 0.86rem;
    color: var(--ink-2);
  }

  .portal__alerts li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .portal__alerts :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--accent-ink);
  }

  .pf {
    list-style: none;
    padding: 0;
  }

  .pf__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pf__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 2rem;
    color: rgb(91 58 142 / 0.3);
  }

  :global([dir='rtl']) .pf__num {
    font-family: var(--font-arabic);
    font-style: normal;
    font-weight: 600;
    font-size: 1.6rem;
  }

  :global([dir='rtl']) .portal__label {
    letter-spacing: 0;
  }

  .pf h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
</style>
