---
/**
 * Teacher profile (E-E-A-T). Only facts already published for each teacher are
 * shown: the Sanad block appears only when her bio states an Ijazah, and only
 * testimonials that name her are attributed to her.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SanadChain from '@/components/SanadChain.astro';
import CourseCard from '@/components/CourseCard.astro';
import TeacherCard from '@/components/TeacherCard.astro';
import Steps from '@/components/Steps.astro';
import Faq from '@/components/Faq.astro';
import CtaPanel from '@/components/CtaPanel.astro';
import Icon from '@/components/Icon.astro';
import { getTeachers, getTestimonials, teacherById } from '@/data/people';
import { trackById } from '@/data/tracks';
import { SITE, trialLink, waLink } from '@/data/site';
import { lp, num, type Lang } from '@/i18n';
import { copy, ui } from '@/locales';

interface Props {
  id: string;
  lang?: Lang;
}
const { id, lang = 'en' } = Astro.props;
const ar = lang === 'ar';
const t = teacherById(id, lang)!;
const en = teacherById(id, 'en')!;
const first = t.name.split(' ')[0];
const track = trackById(t.track, lang);
const stories = getTestimonials(lang).filter((s) => s.teacher === id);
const others = getTeachers(lang).filter((o) => o.id !== id);
const book = trialLink({ teacher: t.canonical }, lang);

const COPY = copy(lang).teacherProfile;
const L = COPY.L(t, first);

const url = new URL(lp(lang, `/teachers/${id}/`), SITE.url).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url,
  mainEntity: {
    '@type': 'Person',
    name: t.name,
    alternateName: ar ? en.name : undefined,
    jobTitle: t.role,
    description: t.bio,
    knowsAbout: [...new Set([t.specialty, ...track.courses.map((c) => c.title)])],
    knowsLanguage: ['ar', 'en'],
    worksFor: { '@id': `${SITE.url}/#organization` },
    ...(en.alumniOf ? { alumniOf: { '@type': 'CollegeOrUniversity', name: en.alumniOf } } : {}),
    ...(en.credentialNames ? { hasCredential: en.credentialNames.map((name) => ({ '@type': 'EducationalOccupationalCredential', name })) } : {}),
  },
};
const meta = COPY.meta(t);

const pad = (n: number) => num(lang, String(n).padStart(2, '0'));
const CRED_TONES = ['lavender', 'sky', 'mauve'];
const STORY_TONES = ['sky', 'lavender', 'rose', 'mauve'];
---

<BaseLayout title={meta.title} description={meta.desc} jsonLd={ld} lang={lang}>
  <!-- Hero: copy on the sheet, the initials monogram on a brand-gradient stage -->
  <section class={`page-hero tprof tprof--${t.hue}`}>
    <div class="container tprof__grid">
      <div class="tprof__copy" data-reveal>
        <Breadcrumbs items={[{ label: L.teachers, href: lp(lang, '/teachers/') }, { label: t.name }]} lang={lang} />
        <span class="eyebrow">{t.role}</span>
        <h1>{t.name}</h1>
        <ul role="list" class="tprof__pills">
          <li class="status tprof__spec">{t.specialty}</li>
          {t.credentials.map((c) => <li class="status status--ghost">{c}</li>)}
        </ul>
        <div class="cluster tprof__actions">
          <a class="btn btn--lg btn--primary" href={book}>{L.book} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
          <a class="btn btn--lg btn--glass" href={waLink(L.waText)} target="_blank" rel="noopener" data-track="teacher_profile">
            <Icon name="whatsapp-logo" weight="fill" class="icon-wa" /> {L.ask}
          </a>
        </div>
      </div>
      <div class="tprof__visual" data-reveal style="--reveal-delay:0.08s">
        <div class="tprof__stage">
          <div class="tprof__portrait" aria-hidden="true">
            <span class="tprof__shape tprof__shape--a"></span>
            <span class="tprof__shape tprof__shape--b"></span>
            <span class="tprof__monogram">{en.initials}</span>
            <span class="status tprof__track">{track.title}</span>
          </div>
          <span class="status tprof__verified"><Icon name="seal-check" weight="fill" /> {L.verified}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- About: the bio, and "best for" as choice rows -->
  <section class="section section--tight">
    <div class="container tprof-about">
      <div class="tprof-about__bio" data-reveal>
        <span class="avatars" style="--av:52px" aria-hidden="true"><span>{t.initials}</span></span>
        <p>{t.bio}</p>
      </div>
      <div class="tprof-best tone tone--lavender" data-reveal style="--reveal-delay:0.06s">
        <h2 class="tprof-best__title">{L.bestFor}</h2>
        <ul role="list" class="tprof-best__rows">
          {
            t.bestFor.map((b) => (
              <li>
                <a href={book}>
                  <span>{b}</span>
                  <span class="arrow-btn" style="--arrow-size:36px" aria-hidden="true">
                    <Icon name="arrow-up-right" weight="bold" />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Credentials: tone cards, the Sanad (deep card) and how she was vetted -->
  <section class="section section--tight" aria-label={L.creds}>
    <div class="container">
      <div class="tprof__head" data-reveal>
        <h2>{L.creds}</h2>
      </div>
      <ul role="list" class="tprof-creds">
        {
          t.credentials.map((c, i) => (
            <li class:list={['tprof-cred', 'tone', `tone--${CRED_TONES[i % CRED_TONES.length]}`]} data-reveal style={`--reveal-delay:${i * 0.05}s`}>
              <span class="icon-badge">
                <Icon name="seal-check" weight="fill" />
              </span>
              <span class="tprof-cred__text">{c}</span>
            </li>
          ))
        }
      </ul>
      <div class:list={['tprof-proof', { 'tprof-proof--solo': !t.ijazah }]}>
        {
          t.ijazah && (
            <article class="tprof-sanad theme-night" data-reveal>
              <span class="status">{L.verified}</span>
              <h3>{L.sanadTitle}</h3>
              <p>{L.sanadText}</p>
              <div class="tprof-sanad__chain">
                <SanadChain dark lang={lang} />
              </div>
              <p class="tprof__note">
                <Icon name="shield-check" weight="fill" /> {L.sanadNote}{' '}
                <a href={L.sanadHref}>{L.sanadMore}</a>
              </p>
            </article>
          )
        }
        <div class="tprof-vet tone tone--mist" data-reveal style="--reveal-delay:0.06s">
          <h2 class="tprof__h2">{L.vetTitle}</h2>
          <ol role="list" class="tprof-vet__list">
            {
              L.vet.map((v, i) => (
                <li>
                  <span class="tprof-vet__num">{pad(i + 1)}.</span>
                  <span class="icon-badge">
                    <Icon name={v.icon} />
                  </span>
                  <span class="tprof-vet__text">
                    <strong>{v.title}</strong>
                    <small>{v.text}</small>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="teaches">
    <div class="container">
      <div class="tprof__head" data-reveal>
        <h2 id="teaches">{L.teachesTitle}</h2>
        <p class="lead">{track.intro}</p>
      </div>
      <div class="grid grid-3">
        {track.courses.map((c, i) => <CourseCard course={c} lang={lang} delay={i * 0.05} />)}
      </div>
    </div>
  </section>

  {
    stories.length > 0 && (
      <section class="section section--tight" aria-labelledby="stories">
        <div class="container">
          <div class="tprof__head" data-reveal>
            <h2 id="stories">{L.storiesTitle}</h2>
          </div>
          <div class="tprof-stories">
            {stories.map((s, i) => (
              <figure class:list={['ev', 'tone', `tone--${STORY_TONES[i % STORY_TONES.length]}`]} data-reveal style={`--reveal-delay:${i * 0.05}s`}>
                <div class="ev__head">
                  <span class="ev__type">
                    <Icon name="quotes" weight="fill" /> {s.program}
                  </span>
                  <span class="ev__stars" role="img" aria-label={ui(lang).stars}>
                    {Array.from({ length: 5 }).map(() => <Icon name="star" weight="fill" />)}
                  </span>
                </div>
                <blockquote class="ev__body">
                  <p>“{s.quote}”</p>
                </blockquote>
                <p class="ev__result">
                  <Icon name="check-circle" weight="fill" />
                  <span>{s.result}</span>
                </p>
                <figcaption class="ev__by">
                  <span class="avatars" style="--av:40px" aria-hidden="true"><span>{s.initials}</span></span>
                  <span>
                    <strong>{s.name}</strong>
                    <small>{s.location}</small>
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--tight" aria-labelledby="booking">
    <div class="container">
      <div class="tprof__head" data-reveal>
        <h2 id="booking">{L.bookTitle}</h2>
      </div>
      <Steps items={L.steps} />
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="booking-faq">
    <div class="container--narrow">
      <div class="tprof__head" data-reveal>
        <h2 id="booking-faq">{L.faqTitle}</h2>
      </div>
      <Faq items={L.faq} schema={false} />
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="others">
    <div class="container">
      <div class="tprof__head" data-reveal>
        <h2 id="others">{L.othersTitle}</h2>
      </div>
      <div class="tprof-others">
        {others.map((o, i) => <TeacherCard teacher={o} variant="compact" lang={lang} delay={i * 0.05} />)}
      </div>
    </div>
  </section>

  <CtaPanel lang={lang} title={L.ctaTitle} lede={L.ctaLede} primary={{ label: L.book, href: book }} />
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .tprof {
    --stage: var(--grad-dusk);
    overflow-x: clip;
    padding-block: clamp(4px, 1vw, 12px) clamp(28px, 4vw, 56px);
  }

  .tprof--sky {
    --stage: var(--grad-dawn);
  }

  .tprof--rose {
    --stage: var(--grad-rose);
  }

  :global([data-theme='dark']) .tprof--rose {
    --stage: linear-gradient(135deg, var(--tint-mauve) 0%, var(--tint-rose) 100%);
  }

  .tprof__grid {
    display: grid;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(12px, 3vw, 40px);
  }

  @media (min-width: 960px) {
    .tprof__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .tprof__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
    max-width: 780px;
  }

  .tprof__copy h1 {
    font-size: clamp(2.6rem, 1.4rem + 4.4vw, 5rem);
    line-height: 1.02;
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) .tprof__copy h1 {
    font-size: clamp(2.2rem, 1.3rem + 3.4vw, 4rem);
    line-height: 1.35;
  }

  .tprof__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tprof__pills .status {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  /* the specialty leads, as a filled pill */
  .tprof__spec {
    color: #fff;
    background: var(--brand-ink);
    border-color: var(--brand-ink);
  }

  .tprof__spec::before {
    background: var(--brand-mauve);
  }

  :global([data-theme='dark']) .tprof__spec {
    color: var(--brand-ink);
    background: #fff;
    border-color: #fff;
  }

  :global([data-theme='dark']) .tprof__spec::before {
    background: var(--brand-plum);
  }

  .tprof__actions {
    margin-top: 6px;
  }

  .tprof__visual {
    min-width: 0;
  }

  .tprof__stage {
    position: relative;
    width: min(100%, 460px);
    margin-inline: auto;
    padding: clamp(14px, 2.2vw, 22px);
    border-radius: clamp(26px, 3vw, 38px);
    background: var(--stage);
  }

  .tprof__portrait {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 4.6;
    border-radius: 999px 999px 26px 26px / 62% 62% 26px 26px;
    background: rgb(255 255 255 / 0.28);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.45);
  }

  :global([data-theme='dark']) .tprof__portrait {
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }

  /* abstract shapes, as on the reference cards (soft, plain — no texture) */
  .tprof__shape {
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.34);
  }

  .tprof__shape--a {
    width: 70%;
    aspect-ratio: 1;
    inset-block-start: -18%;
    inset-inline-end: -22%;
  }

  .tprof__shape--b {
    width: 56%;
    height: 22%;
    inset-block-end: 14%;
    inset-inline-start: -18%;
    rotate: -28deg;
  }

  :global([data-theme='dark']) .tprof__shape {
    background: rgb(255 255 255 / 0.06);
  }

  .tprof__monogram {
    font-family: inherit;
    font-style: normal;
    font-size: clamp(6rem, 4rem + 9vw, 10rem);
    font-weight: 300;
    letter-spacing: -0.07em;
    line-height: 1;
    color: var(--brand-ink);
  }

  :global([data-theme='dark']) .tprof__monogram {
    color: var(--ink);
  }

  .tprof__track {
    position: absolute;
    inset-block-start: 11%;
    inset-inline: 16px;
    justify-self: center;
    width: fit-content;
    max-width: calc(100% - 32px);
    margin-inline: auto;
    white-space: normal;
    text-align: center;
  }

  .tprof__verified {
    position: absolute;
    inset-block-end: clamp(26px, 4vw, 40px);
    inset-inline: 24px;
    width: fit-content;
    max-width: calc(100% - 48px);
    margin-inline: auto;
    padding: 0.7em 1.15em;
    font-size: 0.9rem;
    white-space: normal;
    box-shadow: var(--shadow-soft);
  }

  .tprof__verified::before {
    display: none;
  }

  .tprof__verified :global(svg) {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--accent-ink);
  }

  /* ── About ────────────────────────────────────────────────── */
  .tprof-about {
    display: grid;
    gap: 16px;
    align-items: stretch;
  }

  @media (min-width: 960px) {
    .tprof-about {
      grid-template-columns: 1.3fr 1fr;
      gap: clamp(24px, 4vw, 56px);
    }
  }

  .tprof-about__bio {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }

  .tprof-about__bio p {
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
    font-weight: 420;
    letter-spacing: -0.015em;
    line-height: 1.45;
    color: var(--ink);
  }

  :global([dir='rtl']) .tprof-about__bio p {
    letter-spacing: 0;
    line-height: 1.8;
  }

  .tprof-best {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    padding: clamp(22px, 3vw, 32px);
    border-radius: 30px;
  }

  .tprof-best__title {
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
  }

  .tprof-best__rows {
    display: grid;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tprof-best__rows a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 10px;
    padding-inline: 18px 10px;
    border-radius: 20px;
    font-weight: 560;
    color: var(--ink);
    text-decoration: none;
    background: color-mix(in srgb, var(--card) 70%, transparent);
    border: 1px solid var(--card-line);
    transition: background-color 0.25s;
  }

  .tprof-best__rows a > span:first-child {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .tprof-best__rows a:hover {
    background: var(--card);
  }

  /* ── Credentials ──────────────────────────────────────────── */
  .tprof-creds {
    display: grid;
    gap: 14px;
    padding: 0;
    margin: 0 0 14px;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .tprof-cred {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 26px;
    min-width: 0;
    min-height: 150px;
    padding: clamp(20px, 2.6vw, 26px);
    border-radius: 26px;
  }

  .tprof-cred .icon-badge {
    background: #fff;
    color: var(--tone-dot);
  }

  :global([data-theme='dark']) .tprof-cred .icon-badge {
    background: rgb(255 255 255 / 0.08);
  }

  .tprof-cred__text {
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    font-weight: 540;
    letter-spacing: -0.015em;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) .tprof-cred__text {
    letter-spacing: 0;
    line-height: 1.6;
  }

  .tprof-proof {
    display: grid;
    gap: 14px;
    align-items: stretch;
  }

  @media (min-width: 960px) {
    .tprof-proof:not(.tprof-proof--solo) {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .tprof-sanad {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
    padding: clamp(24px, 3.4vw, 40px);
    border-radius: 32px;
  }

  .tprof-sanad h3 {
    font-size: clamp(1.5rem, 1.15rem + 1.2vw, 2.1rem);
    font-weight: 520;
    line-height: 1.15;
  }

  :global([dir='rtl']) .tprof-sanad h3 {
    line-height: 1.45;
  }

  .tprof-sanad > p {
    color: var(--ink-2);
  }

  .tprof-sanad__chain {
    width: 100%;
    margin-block: 6px;
    padding: clamp(22px, 3vw, 32px) clamp(12px, 2vw, 22px);
    border-radius: 24px;
    background: rgb(255 255 255 / 0.07);
    border: 1px solid rgb(255 255 255 / 0.12);
  }

  .tprof__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 0.92rem;
    color: var(--ink-2);
  }

  .tprof__note :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--brand-mauve);
  }

  .tprof__note a {
    color: #fff;
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .tprof-vet {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
    padding: clamp(22px, 3vw, 34px);
    border-radius: 30px;
  }

  .tprof__h2 {
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
  }

  .tprof-vet__list {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tprof-proof--solo .tprof-vet__list {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }

  .tprof-vet__list li {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: start;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 20px;
    background: var(--card);
    border: 1px solid var(--card-line);
  }

  .tprof-vet__num {
    min-width: 2.2ch;
    font-size: 1.6rem;
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 1.3;
    color: var(--brand-plum);
    font-variant-numeric: tabular-nums;
  }

  :global([dir='rtl']) .tprof-vet__num {
    letter-spacing: 0;
  }

  :global([data-theme='dark']) .tprof-vet__num {
    color: var(--accent-ink);
  }

  .tprof-vet__text strong {
    display: block;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .tprof-vet__text small {
    display: block;
    color: var(--ink-2);
    font-size: 0.92rem;
  }

  /* ── Section heads ────────────────────────────────────────── */
  .tprof__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 24px;
    max-width: 760px;
  }

  .tprof__head h2 {
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.8rem);
    line-height: 1.08;
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) .tprof__head h2 {
    line-height: 1.4;
  }

  /* ── Stories: coloured event-style cards ──────────────────── */
  .tprof-stories {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }

  .ev {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    min-width: 0;
    padding: 12px;
    border-radius: 28px;
  }

  .ev__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 14px;
    padding: 8px 10px 2px;
  }

  .ev__type {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-size: 0.9rem;
    font-weight: 620;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .ev__type :global(svg) {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--tone-dot);
  }

  .ev__stars {
