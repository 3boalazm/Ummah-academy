---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Faq from '@/components/Faq.astro';
import NextSteps from '@/components/NextSteps.astro';
import Icon from '@/components/Icon.astro';
import { waLink } from '@/data/site';
import { num, type Lang } from '@/i18n';
import { copy, ui } from '@/locales';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
type Group = { id: string; title: string; items: { q: string; a: string }[] };
const COPY = copy(lang).faq;
const groups: Group[] = COPY.groups;
const all = groups.flatMap((g) => g.items);
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: all.map((it) => ({ '@type': 'Question', name: it.q, acceptedAnswer: { '@type': 'Answer', text: it.a.replace(/<[^>]+>/g, '') } })) };
const C = COPY.C;
// Each topic takes a brand tint: its heading pill and its open rows.
const TONES = ['lavender', 'sky', 'mauve', 'rose'];
const pad = (n: number) => num(lang, String(n).padStart(2, '0'));
---

<BaseLayout title={C.meta.title} description={C.meta.desc} lang={lang} jsonLd={ld}>
  <PageHero align="center" eyebrow={C.eyebrow} title={C.title} lede={C.lede} compact lang={lang} />

  <section class="section section--tight">
    <div class="container faq-page">
      <div class="faq-page__side">
        <nav class="faq-page__nav" aria-label={C.topics}>
          {
            groups.map((g, i) => (
              <a href={`#${g.id}`} class={`tone--${TONES[i % TONES.length]}`}>
                <span class="faq-page__nav-num" aria-hidden="true">{pad(i + 1)}</span>
                <span>{g.title}</span>
              </a>
            ))
          }
        </nav>
        <aside class="faq-page__ask tone tone--deep tone--grad-plum" aria-label={ui(lang).whatsapp}>
          <p class="faq-page__ask-title" set:html={C.ctaTitle} />
          <p class="faq-page__ask-lede">{C.ctaLede}</p>
          <a class="btn btn--primary btn--sm" href={waLink()} target="_blank" rel="noopener">
            <Icon name="whatsapp-logo" weight="fill" /> {ui(lang).whatsapp}
          </a>
        </aside>
      </div>
      <div class="faq-page__groups">
        {
          groups.map((g, i) => (
            <section id={g.id} class={`faq-page__group tone--${TONES[i % TONES.length]}`} aria-labelledby={`${g.id}-h`} style={`--faq-row-open: var(--tint-${TONES[i % TONES.length]})`}>
              <h2 id={`${g.id}-h`} class="faq-page__pill">
                <span>{g.title}</span>
                <span class="faq-page__count" aria-hidden="true">{num(lang, g.items.length)}</span>
              </h2>
              <Faq items={g.items} schema={false} />
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <NextSteps lang={lang} />
</BaseLayout>

<style>
  .faq-page {
    display: grid;
    gap: clamp(24px, 3vw, 40px);
    align-items: start;
  }

  /* phones: the topic pills first, then the questions, then the WhatsApp card */
  .faq-page__side {
    display: contents;
  }

  .faq-page__nav {
    order: 0;
  }

  .faq-page__groups {
    order: 1;
  }

  .faq-page__ask {
    order: 2;
  }

  @media (min-width: 960px) {
    .faq-page {
      grid-template-columns: 290px minmax(0, 1fr);
    }

    .faq-page__side {
      position: sticky;
      top: calc(var(--header-h) + 16px);
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
  }

  /* ── Topic list ───────────────────────────────────────────── */
  .faq-page__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 8px;
    border-radius: 28px;
    background: var(--tint-mist);
    min-width: 0;
  }

  @media (min-width: 960px) {
    .faq-page__nav {
      flex-direction: column;
    }
  }

  .faq-page__nav a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 8px 16px 8px 10px;
    padding-inline: 10px 16px;
    border-radius: var(--r-pill);
    font-weight: 560;
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.25s;
  }

  .faq-page__nav a:hover {
    background: var(--card);
  }

  .faq-page__nav a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  .faq-page__nav-num {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 0.78rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    color: var(--tone-dot);
    background: var(--card);
  }

  .faq-page__nav a:hover .faq-page__nav-num {
    background: var(--tint-lavender);
  }

  /* ── WhatsApp card: the page's deep anchor ────────────────── */
  .faq-page__ask {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 24px;
    border-radius: 28px;
    min-width: 0;
  }

  .faq-page__ask-title {
    font-size: 1.3rem;
    font-weight: 460;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: #fff;
  }

  :global([dir='rtl']) .faq-page__ask-title {
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.6;
  }

  .faq-page__ask-lede {
    font-size: 0.94rem;
    color: var(--ink-2);
  }

  .faq-page__ask .btn {
    margin-top: 4px;
  }

  /* ── Topic groups ─────────────────────────────────────────── */
  .faq-page__groups {
    display: grid;
    gap: clamp(36px, 4vw, 52px);
    min-width: 0;
  }

  .faq-page__group {
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  /* the topic heading as a status pill: ● title (count) */
  .faq-page__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    max-width: 100%;
    margin-bottom: 16px;
    padding-block: 0.5em;
    padding-inline: 0.85em 0.5em;
    border-radius: var(--r-pill);
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
    font-weight: 560;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--ink);
    background: var(--tone-bg, var(--tint-lavender));
  }

  .faq-page__pill::before {
    content: '';
    flex: none;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--tone-dot, var(--brand-plum));
  }

  .faq-page__pill > span:first-child {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) .faq-page__pill {
    letter-spacing: 0;
    font-weight: 650;
  }

  .faq-page__count {
    display: grid;
    place-items: center;
    flex: none;
    min-width: 1.9em;
    height: 1.9em;
    padding-inline: 0.4em;
    border-radius: var(--r-pill);
    font-size: 0.8em;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    color: var(--tone-dot, var(--brand-plum));
    background: var(--card);
  }

  /* (the tone--* classes on groups and links carry no `.tone` base: they only feed --tone-bg / --tone-dot) */

  /* ---------- Dark theme ---------- */
  :global([data-theme='dark']) .faq-page__nav a:hover .faq-page__nav-num {
    background: rgb(255 255 255 / 0.1);
  }
</style>
