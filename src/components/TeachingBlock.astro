---
import Icon from './Icon.astro';
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  bullets: string[];
  stat: string;
  statLabel: string;
}
const { eyebrow, title, text, bullets, stat, statLabel } = Astro.props;
---

<section class="section" aria-label={title}>
  <div class="container">
    <div class="glass tblock" data-reveal>
      <div class="tblock__copy">
        <span class="eyebrow">{eyebrow}</span>
        <h2 set:html={title} />
        <p class="lead">{text}</p>
        <ul class="checklist">
          {bullets.map((b) => <li>{b}</li>)}
        </ul>
        <a class="btn btn--glass" href="/teachers/">Meet Our Teachers <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
      </div>
      <div class="tblock__stat theme-night">
        <div class="stars"></div>
        <p class="tblock__num">{stat}</p>
        <p class="tblock__label">{statLabel}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .tblock {
    --radius: var(--r-xl);
    display: grid;
    gap: 10px;
    padding: 10px;
  }

  @media (min-width: 900px) {
    .tblock {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .tblock__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: clamp(18px, 3vw, 36px);
  }

  .tblock__copy h2 {
    font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.7rem);
  }

  .tblock__stat {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
    min-height: 240px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: 30px;
    overflow: hidden;
    isolation: isolate;
  }

  .tblock__num {
    font-size: clamp(3.2rem, 2.4rem + 3vw, 5.2rem);
    font-weight: 620;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .tblock__label {
    color: var(--ink-2);
    font-size: 1.05rem;
    max-width: 24ch;
  }
</style>
