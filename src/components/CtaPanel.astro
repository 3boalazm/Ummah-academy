---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import posterArt from '@/assets/art/hero-arch.jpg';
import { waLink } from '@/data/site';
import { lp, type Lang } from '@/i18n';
import { ui } from '@/locales';
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string } | false;
  ticks?: string[];
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = ui(lang);
const {
  eyebrow = t.ctaEyebrow,
  title,
  lede,
  primary = { label: t.book2, href: lp(lang, '/contact/') + '#book' },
  secondary = { label: t.whatsapp, href: waLink() },
  ticks = t.ctaTicks,
} = Astro.props;
---

<section class="section section--tight">
  <div class="container">
    <div class="cta-poster">
      <Image class="cta-poster__img" src={posterArt} alt="" widths={[640, 1024, 1400]} sizes="(min-width: 1240px) 1200px, 100vw" />
      <div class="cta-poster__art" data-reveal>
        <p class="cta-poster__calligraphy calligraphy" lang="ar" dir="rtl">خيرُكم مَن تعلّم القرآنَ وعلّمه</p>
        <p class="cta-poster__source" lang="ar" dir="rtl">رواه البخاري</p>
      </div>
      <div class="cta-poster__panel" data-reveal style="--reveal-delay:.08s">
        <div class="cta-poster__copy">
          <span class="eyebrow">{eyebrow}</span>
          <h2 set:html={title} />
          {lede && <p class="lead">{lede}</p>}
        </div>
        <div class="cta-poster__side">
          <div class="cluster cta-poster__actions">
            <a class="btn btn--lg btn--primary" href={primary.href} data-track="cta-panel">
              {primary.label}
              <Icon name="arrow-right" weight="bold" class="icon-arrow" />
            </a>
            {
              secondary && (
                <a
                  class="btn btn--lg btn--glass"
                  href={secondary.href}
                  target={secondary.href.startsWith('http') ? '_blank' : undefined}
                  rel={secondary.href.startsWith('http') ? 'noopener' : undefined}
                  data-track="cta-panel"
                >
                  {secondary.href.includes('wa.me') && <Icon name="whatsapp-logo" weight="fill" class="icon-wa" />}
                  {secondary.label}
                </a>
              )
            }
          </div>
          {
            ticks.length > 0 && (
              <ul role="list" class="cta-poster__ticks">
                {ticks.map((tick) => (
                  <li class="status">{tick}</li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* A poster: soft 3D art, a line of Arabic calligraphy, and a frosted panel with the call to action. */
  .cta-poster {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    /* one column that may shrink below its content (long German button labels at 320px) */
    grid-template-columns: minmax(0, 1fr);
    align-content: space-between;
    gap: clamp(28px, 6vw, 96px);
    min-height: clamp(520px, 62vw, 640px);
    padding: clamp(20px, 3vw, 32px);
    border-radius: clamp(26px, 3vw, 40px);
  }

  .cta-poster :global(.cta-poster__img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 40%;
  }

  .cta-poster::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(255 255 255 / 0) 30%, rgb(255 255 255 / 0.25));
  }

  /* The calligraphy sits on the side away from the arch (the art is mirrored in RTL). */
  .cta-poster__art {
    justify-self: start;
    max-width: min(560px, 58%);
    padding: clamp(8px, 2vw, 24px) clamp(4px, 2vw, 24px);
  }

  .cta-poster__art p {
    text-align: left;
  }

  :global([dir='rtl']) .cta-poster__art p {
    text-align: right;
  }

  :global([dir='rtl']) .cta-poster :global(.cta-poster__img) {
    transform: scaleX(-1);
  }

  @media (max-width: 640px) {
    .cta-poster__art {
      justify-self: stretch;
      max-width: none;
      min-width: 0;
    }
  }

  .cta-poster__art p {
    overflow-wrap: anywhere;
  }

  .cta-poster__calligraphy {
    font-size: clamp(2.4rem, 1.2rem + 5vw, 5.4rem);
    line-height: 1.35;
    color: var(--brand-plum);
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.4);
  }

  .cta-poster__source {
    margin-top: 6px;
    font-family: var(--font-arabic);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--brand-plum);
    opacity: 0.85;
  }

  .cta-poster__panel {
    display: grid;
    gap: clamp(18px, 3vw, 40px);
    padding: clamp(22px, 3vw, 36px);
    border-radius: clamp(22px, 2.6vw, 32px);
    background: rgb(255 255 255 / 0.74);
    border: 1px solid rgb(255 255 255 / 0.85);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    backdrop-filter: blur(18px) saturate(1.2);
    box-shadow: 0 30px 60px -40px rgb(46 29 70 / 0.5);
    color: var(--aubergine-900);
    --ink: var(--aubergine-900);
    --ink-2: #4a4060;
  }

  @media (min-width: 960px) {
    .cta-poster__panel {
      grid-template-columns: 1.15fr 1fr;
      align-items: end;
    }
  }

  .cta-poster__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .cta-poster h2 {
    font-size: clamp(1.9rem, 1.3rem + 2vw, 3rem);
    color: var(--aubergine-900);
  }

  .cta-poster__copy .lead {
    color: #4a4060;
  }

  .cta-poster__panel > * {
    min-width: 0;
  }

  .cta-poster__actions .btn {
    max-width: 100%;
    white-space: normal;
  }

  .cta-poster__side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  @media (min-width: 960px) {
    .cta-poster__side {
      align-items: flex-end;
    }

    .cta-poster__actions,
    .cta-poster__ticks {
      justify-content: flex-end;
    }
  }

  .cta-poster__ticks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cta-poster__ticks .status {
    font-size: 0.8rem;
    color: var(--aubergine-900);
    background: rgb(255 255 255 / 0.7);
    border-color: rgb(46 29 70 / 0.1);
    white-space: normal;
  }

  /* The poster stays a light poster in dark mode, dimmed so it doesn't glare. */
  :global([data-theme='dark']) .cta-poster :global(.cta-poster__img) {
    filter: brightness(0.62) saturate(0.9);
  }

  :global([data-theme='dark']) .cta-poster__calligraphy,
  :global([data-theme='dark']) .cta-poster__source {
    color: #ffd9ea;
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.35);
  }

  :global([data-theme='dark']) .cta-poster__source {
    color: #fff3f8;
    opacity: 1;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.6);
  }

  :global([data-theme='dark']) .cta-poster::after {
    background: linear-gradient(180deg, rgb(10 6 18 / 0.1) 30%, rgb(10 6 18 / 0.45));
  }

  :global([data-theme='dark']) .cta-poster__panel {
    background: rgb(24 18 36 / 0.78);
    border-color: rgb(255 255 255 / 0.12);
    color: #f4effb;
    --ink: #f4effb;
    --ink-2: #d9d0ea;
  }

  :global([data-theme='dark']) .cta-poster h2 {
    color: #f4effb;
  }

  :global([data-theme='dark']) .cta-poster__copy .lead {
    color: #d9d0ea;
  }

  :global([data-theme='dark']) .cta-poster__ticks .status {
    color: #f4effb;
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.14);
  }
</style>
