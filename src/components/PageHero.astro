---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Lang } from '@/i18n';
interface Props {
  lang?: Lang;
  eyebrow?: string;
  eyebrowAr?: string;
  title: string;
  sub?: string;
  lede?: string;
  crumbs?: { label: string; href?: string }[];
  align?: 'start' | 'center';
  compact?: boolean;
}
const { eyebrow, eyebrowAr, title, sub, lede, crumbs, align = 'start', compact = false, lang = 'en' } = Astro.props;
const hasVisual = Astro.slots.has('visual');
---

<section class:list={['page-hero', { 'page-hero--center': align === 'center', 'page-hero--compact': compact }]}>
  <div class="container">
  <div class:list={['page-hero__panel', { 'page-hero__panel--soft': !hasVisual }]}>
  <div class:list={['page-hero__grid', { 'page-hero__grid--split': hasVisual }]}>
    <div class="page-hero__copy" data-reveal>
      {crumbs && <Breadcrumbs items={crumbs} lang={lang} />}
      {
        eyebrow && (
          <span class="eyebrow">
            {eyebrow}
            {eyebrowAr && (
              <span class="eyebrow__ar" lang="ar">
                — {eyebrowAr}
              </span>
            )}
          </span>
        )
      }
      <h1 set:html={title} />
      {sub && <p class="page-hero__sub" lang="ar" dir="rtl">{sub}</p>}
      {lede && <p class="lead page-hero__lede">{lede}</p>}
      {
        Astro.slots.has('actions') && (
          <div class="cluster page-hero__actions">
            <slot name="actions" />
          </div>
        )
      }
      <slot />
    </div>
    {
      hasVisual && (
        <div class="page-hero__visual" data-reveal style="--reveal-delay:.12s">
          <div class="page-hero__stage">
            <slot name="visual" />
          </div>
        </div>
      )
    }
  </div>
  </div>
  </div>
</section>

<style>
  .page-hero {
    overflow-x: clip;
    padding-block: clamp(4px, 1vw, 12px) clamp(28px, 4vw, 56px);
  }

  /* Reference-led hero: the copy on the white sheet, the visual on a brand-gradient stage.
     Heroes without a visual sit on a soft lavender → sky panel instead. */
  .page-hero__panel {
    border-radius: var(--sheet-radius);
    padding-block: clamp(12px, 3vw, 40px);
  }

  .page-hero__panel--soft {
    padding: clamp(28px, 5vw, 76px) clamp(20px, 4.5vw, 64px);
    background: var(--grad-dawn);
  }

  .page-hero__stage {
    position: relative;
    padding: clamp(14px, 2.2vw, 26px);
    border-radius: clamp(26px, 3vw, 38px);
    background: var(--grad-dusk);
  }

  /* cards placed on the stage (at-a-glance, badges) are white cards */
  .page-hero__stage :global(.glass) {
    background: #fff;
  }

  :global([data-theme='dark']) .page-hero__stage :global(.glass) {
    background: #201830;
  }

  .page-hero--compact {
    padding-bottom: clamp(16px, 3vw, 32px);
  }

  .page-hero__grid {
    display: grid;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  @media (min-width: 960px) {
    .page-hero__grid--split {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .page-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 780px;
  }

  .page-hero--center .page-hero__copy {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }

  .page-hero h1 {
    font-size: clamp(2.4rem, 1.4rem + 3.8vw, 4.6rem);
    line-height: 1.04;
  }

  :global([dir='rtl']) .page-hero h1 {
    font-size: clamp(2.1rem, 1.3rem + 3vw, 3.8rem);
    line-height: 1.35;
  }

  .page-hero__sub {
    font-family: var(--font-arabic);
    color: var(--ink-3);
    font-size: 1.1rem;
    margin-top: -8px;
  }

  .page-hero__lede {
    max-width: 62ch;
  }

  .page-hero__actions {
    margin-top: 6px;
  }

  .page-hero--center .page-hero__actions {
    justify-content: center;
  }
</style>
