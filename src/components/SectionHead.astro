---
interface Props {
  eyebrow?: string;
  eyebrowAr?: string;
  /** may contain <span class="accent"> */
  title: string;
  /** secondary line in Arabic (v1 parity with the bilingual live site) */
  sub?: string;
  lede?: string;
  align?: 'start' | 'center';
  as?: 'h1' | 'h2';
  id?: string;
}
const { eyebrow, eyebrowAr, title, sub, lede, align = 'center', as: Tag = 'h2', id } = Astro.props;
---

<header class:list={['section-head', { 'section-head--center': align === 'center' }]} data-reveal>
  {
    eyebrow && (
      <span class="eyebrow">
        {eyebrow}
        {eyebrowAr && <span class="eyebrow__ar" lang="ar">— {eyebrowAr}</span>}
      </span>
    )
  }
  <Tag id={id} set:html={title} />
  {sub && <p class="section-head__sub" lang="ar" dir="rtl">{sub}</p>}
  {lede && <p class="lead">{lede}</p>}
  <slot />
</header>
