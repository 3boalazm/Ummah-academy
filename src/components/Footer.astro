---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE, waLink } from '@/data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="night-panel theme-night site-footer__panel">
    <div class="stars"></div>
    <div class="container site-footer__inner">
      <div class="site-footer__brand">
        <Logo tone="light" showArabic />
        <p class="site-footer__mission">
          Bridging 1,000 years of Al-Azhar scholarship with modern, flexible 1-on-1 live learning for Muslims in 50+
          countries.
        </p>
        <div class="site-footer__contact">
          <a class="btn btn--sm btn--glass" href={waLink()} target="_blank" rel="noopener">
            <Icon name="whatsapp-logo" weight="fill" class="icon-wa" />
            {SITE.whatsapp.display}
          </a>
          <a class="btn btn--sm btn--glass" href={`mailto:${SITE.email}`}>
            <Icon name="envelope-simple" weight="regular" />
            {SITE.email}
          </a>
        </div>
      </div>

      <nav class="site-footer__cols" aria-label="Footer">
        {
          Object.entries(NAV.footer).map(([heading, links]) => (
            <div class="site-footer__col">
              <p class="site-footer__heading">{heading}</p>
              <ul role="list">
                {links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="container site-footer__base">
      <p>© {year} {SITE.name}. All rights reserved.</p>
      <ul role="list" class="site-footer__legal">
        {
          NAV.legal.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
      <p class="site-footer__note">Serving 50+ countries · Live sessions around the clock</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(32px, 6vw, 72px) clamp(8px, 1.6vw, 24px);
  }

  .site-footer__panel {
    position: relative;
    padding-block: clamp(48px, 7vw, 88px) 28px;
  }

  .site-footer__inner {
    display: grid;
    gap: 48px;
  }

  @media (min-width: 960px) {
    .site-footer__inner {
      grid-template-columns: 1.1fr 1.6fr;
    }
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }

  .site-footer__mission {
    max-width: 40ch;
    color: var(--ink-2);
  }

  .site-footer__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 32px;
  }

  .site-footer__heading {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 14px;
  }

  .site-footer__col ul {
    display: grid;
    gap: 10px;
  }

  .site-footer a:not(.btn) {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.97rem;
  }

  .site-footer a:not(.btn):hover {
    color: #fff;
    text-decoration: underline;
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    align-items: center;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
    color: var(--ink-3);
  }

  .site-footer__legal {
    display: flex;
    gap: 20px;
  }

  .site-footer__note {
    margin-inline-start: auto;
  }
</style>
