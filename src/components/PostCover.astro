---
/**
 * Generated, on-brand article cover (pure CSS/SVG — zero image weight).
 * Deterministic per title, tinted per learning track.
 */
interface Props {
  title: string;
  track: string;
  small?: boolean;
}
const { title, track, small = false } = Astro.props;

const palettes: Record<string, [string, string, string]> = {
  quran: ['#d9c9f2', '#f6d9e6', '#c4daf3'],
  arabic: ['#cfdcf6', '#e6d6f4', '#f3dfe6'],
  kids: ['#f7d6e3', '#e3d7f7', '#d4e6f6'],
  islamic: ['#d8d2ee', '#cfe0f2', '#efdbe5'],
  general: ['#e4daf3', '#f3dfe8', '#d6e3f4'],
};
const glyphs: Record<string, string> = { quran: 'ق', arabic: 'ع', kids: 'ب', islamic: '۞', general: 'ا' };
let h = 0;
for (const c of title) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const [a, b, c] = palettes[track] ?? palettes.general;
const x1 = 15 + (h % 50);
const y1 = 10 + ((h >> 3) % 40);
const x2 = 60 + ((h >> 5) % 35);
const rot = (h >> 7) % 45;
---

<span
  class:list={['cover', { 'cover--small': small }]}
  style={`--a:${a};--b:${b};--c:${c};--x1:${x1}%;--y1:${y1}%;--x2:${x2}%;--rot:${rot}deg`}
  aria-hidden="true"
>
  <svg class="cover__star" viewBox="0 0 100 100">
    <g fill="none" stroke="white" stroke-opacity="0.75" stroke-width="0.8">
      <rect x="22" y="22" width="56" height="56" rx="6"></rect>
      <rect x="22" y="22" width="56" height="56" rx="6" transform="rotate(45 50 50)"></rect>
      <circle cx="50" cy="50" r="17"></circle>
    </g>
  </svg>
  <span class="cover__orb"></span>
  <span class="cover__glyph quranic">{glyphs[track] ?? glyphs.general}</span>
</span>

<style>
  .cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 20px;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(60% 70% at var(--x1) var(--y1), var(--b), transparent 70%),
      radial-gradient(70% 80% at var(--x2) 90%, var(--c), transparent 70%),
      linear-gradient(150deg, var(--a), #efe9f6);
  }

  .cover__star {
    position: absolute;
    width: 90%;
    right: -18%;
    top: -22%;
    rotate: var(--rot);
    opacity: 0.9;
  }

  .cover__orb {
    position: absolute;
    left: 10%;
    bottom: 14%;
    width: 34%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgb(255 255 255 / 0.95), rgb(255 255 255 / 0.25) 60%, rgb(255 255 255 / 0.05));
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.7),
      0 20px 40px -20px rgb(46 29 70 / 0.35);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .cover__glyph {
    position: absolute;
    right: 12%;
    bottom: 4%;
    font-size: 5.5rem;
    line-height: 1.2;
    color: rgb(255 255 255 / 0.92);
    text-shadow: 0 10px 30px rgb(91 58 142 / 0.35);
  }

  .cover--small .cover__glyph {
    font-size: 4.2rem;
  }
</style>
