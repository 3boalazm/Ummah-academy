---
/** Shared editorial artwork; illustrative, never a photo of a real student. */
import { Image } from 'astro:assets';
import quran from '@/assets/art/recitation-lesson.webp';
import arabic from '@/assets/art/arabic-practice.webp';
import kids from '@/assets/art/kids-learning.webp';
import islamic from '@/assets/art/family-stories.webp';
import general from '@/assets/art/teacher-welcome.webp';
interface Props {
  title: string;
  track: string;
  small?: boolean;
}
const { track, small = false } = Astro.props;
const artwork: Record<string, ImageMetadata> = { quran, arabic, kids, islamic, general };
---

<span class:list={['cover', { 'cover--small': small }]} aria-hidden="true">
  <Image src={artwork[track] ?? general} alt="" widths={[320, 480, 720, 960]} sizes={small ? '(min-width: 960px) 360px, (min-width: 700px) 45vw, 90vw' : '(min-width: 960px) 800px, 92vw'} />
</span>

<style>
  /* A rounded photo frame, as on the reference cards: the artwork fills it, a hairline keeps the edge. */
  .cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 24px;
    overflow: hidden;
    background: var(--tint-lavender);
    isolation: isolate;
  }

  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    transition: transform 0.8s var(--ease-out);
  }

  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(44 28 68 / 0.08);
    pointer-events: none;
  }

  .cover--small {
    border-radius: 20px;
  }

  /* cards zoom the artwork a touch on hover */
  :global(a:hover) .cover :global(img) {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .cover :global(img) {
      transition: none;
    }

    :global(a:hover) .cover :global(img) {
      transform: none;
    }
  }

  /* ---------- Dark theme ---------- */
  :global([data-theme='dark']) .cover {
    background: var(--tint-mist);
  }

  :global([data-theme='dark']) .cover::after {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
</style>
