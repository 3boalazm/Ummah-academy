---
/** Shared editorial artwork; illustrative, never a photo of a real student. */
import { Image } from 'astro:assets';
import quran from '@/assets/art/recitation-lesson.webp';
import arabic from '@/assets/art/arabic-practice.webp';
import kids from '@/assets/art/kids-learning.webp';
import islamic from '@/assets/art/family-stories.webp';
import general from '@/assets/art/teacher-welcome.webp';
interface Props {
  title: string;
  track: string;
  small?: boolean;
}
const { track, small = false } = Astro.props;
const artwork: Record<string, ImageMetadata> = { quran, arabic, kids, islamic, general };
---

<span class:list={['cover', { 'cover--small': small }]} aria-hidden="true">
  <Image src={artwork[track] ?? general} alt="" widths={[320, 480, 720, 960]} sizes={small ? '(min-width: 960px) 360px, (min-width: 700px) 45vw, 90vw' : '(min-width: 960px) 800px, 92vw'} />
</span>

<style>
  .cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 20px;
    overflow: hidden;
    background: #eee5da;
    isolation: isolate;
  }
  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(91 58 142 / .08);
    pointer-events: none;
  }
  .cover--small { border-radius: 16px; }
  /* ---------- Dark theme ---------- */
  /* The artwork is image-based now; the old gradient (--a/--b/--c) no longer exists,
     so only the loading backdrop needs a dark tone. */
  :global([data-theme='dark']) .cover { background: #241a34; }
</style>
