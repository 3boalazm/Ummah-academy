---
import Icon from './Icon.astro';
import { teacherById, type Testimonial } from '@/data/people';
import { lp, type Lang } from '@/i18n';
import { ui } from '@/locales';
interface Props {
  t: Testimonial;
  lang?: Lang;
  /** link the named teacher's profile (off on that teacher's own page) */
  showTeacher?: boolean;
}
const { t, lang = 'en', showTeacher = true } = Astro.props;
const teacher = showTeacher && t.teacher ? teacherById(t.teacher, lang) : undefined;
---

<figure class="tcard glass">
  <div class="tcard__stars" role="img" aria-label={ui(lang).stars}>
    {Array.from({ length: 5 }).map(() => <Icon name="star" weight="fill" />)}
  </div>
  <blockquote>
    <p>“{t.quote}”</p>
  </blockquote>
  <p class="tcard__result">
    <Icon name="check-circle" weight="fill" />
    <span>{t.result}</span>
  </p>
  <figcaption>
    <span class="tcard__avatar" aria-hidden="true">{t.initials}</span>
    <span>
      <strong>{t.name}</strong>
      <small>{t.location} · {t.program}</small>
      {
        teacher && (
          <a class="tcard__teacher" href={lp(lang, `/teachers/${t.teacher}/`)}>
            {ui(lang).withTeacher(teacher.name)}
          </a>
        )
      }
    </span>
  </figcaption>
</figure>

<style>
  .tcard__teacher {
    display: block;
    width: fit-content;
    font-size: 0.84rem;
    font-weight: 560;
    color: var(--accent-ink);
  }

  .tcard {
    --radius: 26px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 26px;
    height: 100%;
  }

  .tcard__stars {
    display: flex;
    gap: 2px;
    color: var(--gold-400);
  }

  .tcard__stars :global(svg) {
    width: 17px;
    height: 17px;
  }

  .tcard blockquote {
    margin: 0;
    font-size: 1.06rem;
    line-height: 1.6;
    color: var(--ink);
    letter-spacing: -0.005em;
  }

  .tcard__result {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    padding: 10px 12px;
    border-radius: 14px;
    background: rgb(31 122 77 / 0.07);
    color: #1d5e3f;
    font-size: 0.88rem;
    font-weight: 540;
  }

  .tcard__result :global(svg) {
    width: 18px;
    height: 18px;
    flex: none;
    margin-top: 2px;
  }

  .tcard figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }

  .tcard figcaption strong {
    display: block;
    font-weight: 600;
    font-size: 0.97rem;
  }

  .tcard figcaption small {
    color: var(--ink-3);
    font-size: 0.84rem;
  }

  .tcard__avatar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    font-size: 0.85rem;
    font-weight: 650;
    color: #fff;
    background: var(--grad-accent);
    box-shadow: 0 6px 14px -6px rgb(91 58 142 / 0.7);
  }
  /* ---------- Dark theme ---------- */
  :global([data-theme='dark']) .tcard__result {
    background: rgb(127 220 174 / 0.12);
    color: #8fe6b8;
  }
</style>
