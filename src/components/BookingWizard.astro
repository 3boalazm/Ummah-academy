---
/**
 * 3-step trial booking: (1) who & what → (2) when & how → (3) contact.
 * Works without JS as a single long form (all steps visible, native submit to WhatsApp is not possible,
 * so a no-JS notice offers WhatsApp/email directly).
 */
import Icon from './Icon.astro';
import { TRIAL_COURSES, courseLabel } from '@/data/tracks';
import { COUNTRIES, countryName } from '@/data/countries';
import { SITE, waLink } from '@/data/site';
import { lp, type Lang } from '@/i18n';
import { copy } from '@/locales';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;

const COPY = copy(lang).booking;
const L = COPY.L;

const i18n = {
  lang,
  thankYou: lp(lang, '/thank-you/'),
  eFirst: L.eFirst,
  eWa: L.eWa,
  eCountry: L.eCountry,
  eLearner: L.eLearner,
  eCourse: L.eCourse,
  step: [L.step(1), L.step(2), L.step(3)],
  sending: L.sending,
  courseLabels: Object.fromEntries(TRIAL_COURSES.map((c) => [c.value, courseLabel(c, lang)])),
  countries: COUNTRIES.map((c) => ({ v: c.en, d: c.dial, tz: c.tz })),
  msg: L.msg,
};
---

<form class="booking glass glass--strong" id="book-form" novalidate data-booking data-endpoint={SITE.leadEndpoint} data-wa={SITE.whatsapp.number}>
  <div class="booking__progress" aria-live="polite">
    <span class="booking__steplabel" data-step-label>{L.step(1)}</span>
    <span class="booking__bar"><span data-step-bar style="width:33.3%"></span></span>
  </div>

  <noscript>
    <p class="booking__nojs">{L.nojs} <a href={waLink()}>WhatsApp</a> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
  </noscript>

  <!-- Step 1 -->
  <fieldset class="booking__step" data-bstep="1">
    <legend class="booking__legend" tabindex="-1">{L.s1}</legend>
    <div class="choices booking__learners" role="radiogroup" aria-label={L.s1}>
      {
        L.learners.map((o) => (
          <label class="choice">
            <input type="radio" name="learner" value={o.v} required />
            <span class="choice__box">
              <Icon name={o.i} />
              <span>
                {o.l}
                <small>{o.s}</small>
              </span>
            </span>
          </label>
        ))
      }
    </div>
    <p class="error booking__err" data-err="learner">{L.eLearner}</p>

    <div class="field booking__age" data-child-age hidden>
      <label for="bk-age">{L.childAge}</label>
      <div class="seg" role="radiogroup" aria-label={L.childAge}>
        {
          L.ages.map((a, i) => (
            <label class="seg__opt">
              <input type="radio" name="childAge" value={L.agesV[i]} />
              <span>{a}</span>
            </label>
          ))
        }
      </div>
    </div>

    <p class="booking__q" id="bk-course-label">{L.s1b}</p>
    <div class="choices booking__courses" role="radiogroup" aria-labelledby="bk-course-label">
      {
        TRIAL_COURSES.map((c) => (
          <label class="choice" data-course-track={c.track}>
            <input type="radio" name="course" value={c.value} />
            <span class="choice__box">
              <span>
                {courseLabel(c, lang)}
                <small>{L.tracks[c.track as keyof typeof L.tracks]}</small>
              </span>
            </span>
          </label>
        ))
      }
    </div>
    <p class="error booking__err" data-err="course">{L.eCourse}</p>

    <div class="booking__nav booking__nav--end">
      <button class="btn btn--primary" type="button" data-next>{L.next} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></button>
    </div>
  </fieldset>

  <!-- Step 2 -->
  <fieldset class="booking__step" data-bstep="2">
    <legend class="booking__legend" tabindex="-1">{L.s2}</legend>
    {
      [
        { key: 'days', label: L.days, opts: L.daysO },
        { key: 'time', label: L.time, opts: L.timeO },
        { key: 'teacherGender', label: L.teacher, opts: L.teacherO },
      ].map((g) => (
        <div class="field">
          <p class="booking__sublabel" id={`bk-${g.key}`}>{g.label}</p>
          <div class="seg" role="radiogroup" aria-labelledby={`bk-${g.key}`}>
            {g.opts.map(([v, l], i) => (
              <label class="seg__opt">
                <input type="radio" name={g.key} value={v} checked={i === 0} />
                <span>{l}</span>
              </label>
            ))}
          </div>
        </div>
      ))
    }
    <p class="hint booking__tz"><Icon name="globe-simple" weight="bold" /> {L.tz} <strong data-tz>—</strong></p>
    <div class="booking__nav">
      <button class="btn btn--glass" type="button" data-back><Icon name="arrow-left" weight="bold" class="icon-arrow-back" /> {L.back}</button>
      <button class="btn btn--primary" type="button" data-next>{L.next} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></button>
    </div>
  </fieldset>

  <!-- Step 3 -->
  <fieldset class="booking__step" data-bstep="3">
    <legend class="booking__legend" tabindex="-1">{L.s3}</legend>
    <div class="booking__grid">
      <div class="field">
        <label for="bk-first">{L.first} <span class="req" aria-hidden="true">*</span></label>
        <input class="input" id="bk-first" name="firstName" autocomplete="given-name" required />
        <p class="error">{L.eFirst}</p>
      </div>
      <div class="field">
        <label for="bk-country">{L.country} <span class="req" aria-hidden="true">*</span></label>
        <select class="select" id="bk-country" name="country" required>
          <option value="">—</option>
          {COUNTRIES.map((c) => <option value={c.en}>{countryName(c, lang, L.otherCountry)}</option>)}
        </select>
        <p class="error">{L.eCountry}</p>
      </div>
      <div class="field booking__wide">
        <label for="bk-wa">{L.wa} <span class="req" aria-hidden="true">*</span></label>
        <input class="input" id="bk-wa" name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" placeholder="+44 7700 900123" required aria-describedby="bk-wa-hint" />
        <p class="hint" id="bk-wa-hint">{L.waHint}</p>
        <p class="error">{L.eWa}</p>
      </div>
      <div class="field booking__wide">
        <label for="bk-email">{L.email}</label>
        <input class="input" id="bk-email" name="email" type="email" autocomplete="email" dir="ltr" />
      </div>
      <div class="field booking__wide">
        <label for="bk-notes">{L.notes}</label>
        <textarea class="textarea" id="bk-notes" name="notes" placeholder={L.notesPh}></textarea>
      </div>
    </div>
    <div class="booking__nav">
      <button class="btn btn--glass" type="button" data-back><Icon name="arrow-left" weight="bold" class="icon-arrow-back" /> {L.back}</button>
      <button class="btn btn--lg btn--primary" type="submit">{L.submit} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></button>
    </div>
    <p class="booking__note">{L.note}</p>
    <p class="booking__privacy"><Icon name="lock-simple" weight="fill" /> {L.privacy} <a href={lp(lang, '/privacy-policy/')}>{L.privacyLink}</a></p>
  </fieldset>

  <input type="hidden" name="teacher" />
  <input type="hidden" name="plan" />
  <input type="hidden" name="level" />
  <input type="hidden" name="timezone" />
</form>

<script type="application/json" id="booking-i18n" set:html={JSON.stringify(i18n)} />
<script>
  import { initBooking } from '@/scripts/booking';
  initBooking();
</script>

<style>
  .booking {
    --radius: 32px;
    display: grid;
    gap: 18px;
    padding: clamp(20px, 3.2vw, 36px);
  }

  .booking__progress {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-3);
  }

  .booking__steplabel {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .booking__bar {
    flex: 1;
    height: 6px;
    border-radius: 99px;
    background: rgb(46 29 70 / 0.08);
    overflow: hidden;
  }

  .booking__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--grad-accent);
    transition: width 0.5s var(--ease-out);
  }

  .booking__step {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    min-width: 0;
  }

  :global(html.js) .booking__step:not(.is-active) {
    display: none;
  }

  .booking__legend {
    padding: 0;
    margin-bottom: 6px;
    font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.75rem);
    font-weight: 620;
    letter-spacing: -0.025em;
    line-height: 1.25;
    outline: none;
  }

  [dir='rtl'] .booking__legend {
    letter-spacing: 0;
  }

  .booking__q,
  .booking__sublabel {
    font-weight: 600;
    font-size: 0.98rem;
    margin-top: 4px;
  }

  .booking__learners {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 520px) {
    .booking__learners {
      grid-template-columns: 1fr;
    }
  }

  .booking__courses {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
  }

  .booking__courses :global(.choice__box) {
    padding: 12px 14px;
    font-size: 0.95rem;
  }

  .booking__err {
    display: none;
    margin-top: -8px;
    font-size: var(--fs-xs);
    font-weight: 560;
    color: var(--danger);
  }

  .booking__step[data-invalid-learner] [data-err='learner'],
  .booking__step[data-invalid-course] [data-err='course'] {
    display: block;
  }

  .booking__tz {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .booking__tz :global(svg) {
    width: 14px;
    height: 14px;
  }

  .booking__grid {
    display: grid;
    gap: 14px;
  }

  @media (min-width: 560px) {
    .booking__grid {
      grid-template-columns: 1fr 1fr;
    }

    .booking__wide {
      grid-column: 1 / -1;
    }
  }

  .booking__nav {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .booking__nav--end {
    justify-content: flex-end;
  }

  [dir='rtl'] .booking :global(.icon-arrow-back) {
    transform: scaleX(-1);
  }

  .booking__note {
    text-align: center;
    font-size: 0.9rem;
    font-weight: 560;
    color: var(--ink-2);
  }

  .booking__privacy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--ink-3);
    margin-top: -8px;
  }

  .booking__privacy :global(svg) {
    width: 13px;
    height: 13px;
  }

  .booking__nojs {
    padding: 12px 14px;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.8);
  }

  .req {
    color: var(--magenta-600);
  }
  /* ---------- Dark theme ---------- */
  :global([data-theme='dark']) .booking__bar {
    background: rgb(255 255 255 / 0.1);
  }

  :global([data-theme='dark']) .booking__nojs {
    background: rgb(255 255 255 / 0.08);
  }
</style>
