---
/**
 * Home · section 2 — the Tilawa recitation companion. A static, CSS-animated preview of the
 * real tool (words light up as they are "recited", one gentle mistake note) and a link to /tilawa/.
 */
import Icon from './Icon.astro';
import { lp, type Lang } from '@/i18n';
import { copy } from '@/locales';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const H = copy(lang).tilawa.home;

// Al-Ikhlas 112:1–4 (Uthmani), one array per ayah. The marked word shows what a note looks like.
const AYAT = [
  ['قُلْ', 'هُوَ', 'ٱللَّهُ', 'أَحَدٌ'],
  ['ٱللَّهُ', 'ٱلصَّمَدُ'],
  ['لَمْ', 'يَلِدْ', 'وَلَمْ', 'يُولَدْ'],
  ['وَلَمْ', 'يَكُن', 'لَّهُۥ', 'كُفُوًا', 'أَحَدٌۢ'],
];
const MARKED = '2:1'; // ayah index : word index → يَلِدْ
const NUMS = ['١', '٢', '٣', '٤'];
let i = 0;
---

<section class="section tth" aria-labelledby="tilawa-title">
  <div class="container">
    <div class="tth__panel glass" data-reveal>
      <div class="tth__copy">
        <span class="chip chip--accent tth__kicker"><Icon name="sparkle" weight="fill" /> {H.eyebrow}</span>
        <h2 id="tilawa-title" set:html={H.title} />
        <p class="lead">{H.lede}</p>
        <ul role="list" class="tth__points">
          {H.points.map((p) => <li><Icon name="check-circle" weight="fill" /> {p}</li>)}
        </ul>
        <div class="tth__actions">
          <a class="btn btn--lg btn--primary" href={lp(lang, '/tilawa/')} data-track="home-tilawa">
            <Icon name="microphone" weight="fill" /> {H.cta}
          </a>
          <span class="tth__note">{H.note}</span>
        </div>
      </div>

      <div class="tth__demo" aria-hidden="true">
        <div class="tth__card">
          <div class="tth__bar">
            <span class="tth__place">{H.demoPlace}</span>
            <span class="tth__live"><span class="tth__dot"></span>{H.demoLive}</span>
          </div>
          <div class="tth__wave">
            {Array.from({ length: 28 }, (_, k) => <span style={`--k:${k}`}></span>)}
          </div>
          <p class="tth__verse quranic" dir="rtl" lang="ar">
            {
              AYAT.map((words, a) => (
                <>
                  {words.map((w, j) => (
                    <span class:list={['tth__w', { 'tth__w--mark': `${a}:${j}` === MARKED }]} style={`--i:${i++}`}>
                      {w}
                    </span>
                  ))}
                  <span class="tth__n">﴿{NUMS[a]}﴾</span>
                </>
              ))
            }
          </p>
          <div class="tth__noteCard">
            <span class="tth__noteHead"><Icon name="warning-circle" weight="fill" /> {H.demoNote} · {lang === 'ar' ? '١١٢:٣' : '112:3'}</span>
            <span class="tth__noteWord quranic" lang="ar">يَلِدْ</span>
          </div>
        </div>
        <span class="tth__orb tth__orb--1"></span>
        <span class="tth__orb tth__orb--2"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .tth {
    padding-block: clamp(36px, 5vw, 72px);
  }

  .tth__panel {
    --radius: var(--r-xl);
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    padding: clamp(22px, 4vw, 56px);
    overflow: hidden;
  }

  @media (min-width: 960px) {
    .tth__panel {
      grid-template-columns: 1fr 1.05fr;
    }
  }

  .tth__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .tth__kicker :global(svg) {
    color: var(--gold-400);
  }

  .tth__copy h2 {
    font-size: var(--fs-h2);
  }

  .tth__points {
    display: grid;
    gap: 8px;
  }

  .tth__points li {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--ink-2);
    font-weight: 500;
  }

  .tth__points :global(svg) {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--success);
  }

  .tth__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: 6px;
  }

  .tth__actions .btn :global(svg) {
    width: 20px;
    height: 20px;
  }

  .tth__note {
    font-size: 0.88rem;
    color: var(--ink-3);
  }

  /* Demo */
  .tth__demo {
    position: relative;
    isolation: isolate;
    padding: clamp(8px, 2vw, 24px);
  }

  .tth__orb {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.7;
  }

  .tth__orb--1 {
    width: 220px;
    height: 220px;
    inset-inline-end: -40px;
    top: -30px;
    background: rgb(175 204 234 / 0.9);
  }

  .tth__orb--2 {
    width: 200px;
    height: 200px;
    inset-inline-start: -30px;
    bottom: -40px;
    background: rgb(241 205 220 / 0.95);
  }

  .tth__card {
    display: grid;
    gap: 14px;
    padding: clamp(18px, 2.6vw, 28px);
    border-radius: 30px;
    background: rgb(255 255 255 / 0.82);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.9),
      var(--shadow-lift);
  }

  .tth__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 0.86rem;
  }

  .tth__place {
    font-weight: 640;
    color: var(--accent-ink);
  }

  .tth__live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 600;
    color: var(--success);
  }

  .tth__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d64545;
    animation: tth-blink 1.4s ease-in-out infinite;
  }

  .tth__wave {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    height: 34px;
  }

  .tth__wave span {
    width: 4px;
    height: 100%;
    border-radius: 4px;
    background: var(--grad-accent-on);
    opacity: 0.75;
    transform-origin: center;
    animation: tth-wave 1.1s ease-in-out infinite;
    animation-delay: calc(var(--k) * -0.09s);
  }

  .tth__verse {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.35rem);
    line-height: 2.05;
    text-align: center;
  }

  .tth {
    --tth-mark: #9b2948;
    --tth-mark-bg: #f8eaf0;
    --tth-current-bg: var(--aubergine-800);
    --tth-current-ink: #fff;
  }

  /* Same language as the live tool: words ahead in full ink, the current word in a solid block,
     recited words faded, a mistake in burgundy with a wavy underline. */
  .tth__w {
    display: inline-block;
    padding: 0 0.12em;
    border-radius: 0.22em;
    line-height: 1.5;
    color: var(--ink);
    animation: tth-say 10s linear infinite;
    animation-delay: calc(var(--i) * 0.48s);
  }

  .tth__w--mark {
    color: var(--tth-mark);
    text-decoration: underline wavy var(--tth-mark) 1px;
    text-decoration-skip-ink: none;
    text-underline-offset: 0.42em;
    animation: none;
  }

  .tth__n {
    color: var(--ink-3);
    font-size: 0.7em;
    margin-inline: 0.15em;
  }

  .tth__noteCard {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--tth-mark-bg);
    border-inline-start: 3px solid var(--tth-mark);
    font-size: 0.84rem;
    font-weight: 620;
    color: var(--tth-mark);
  }

  .tth__noteHead {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .tth__noteHead :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--tth-mark);
  }

  .tth__noteWord {
    font-size: 1.45rem;
    line-height: 1.5;
    font-weight: 400;
    color: var(--ink);
  }

  @keyframes tth-say {
    0%,
    4% {
      color: var(--tth-current-ink);
      background: var(--tth-current-bg);
    }
    5%,
    82% {
      color: var(--ink-3);
      background: transparent;
    }
    92%,
    100% {
      color: var(--ink);
      background: transparent;
    }
  }

  @keyframes tth-wave {
    0%,
    100% {
      scale: 1 0.25;
    }
    50% {
      scale: 1 1;
    }
  }

  @keyframes tth-blink {
    50% {
      opacity: 0.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tth__w,
    .tth__wave span,
    .tth__dot {
      animation: none;
    }

    .tth__w {
      color: var(--ink);
    }

    .tth__wave span {
      scale: 1 0.5;
    }
  }

  :global([data-theme='dark']) .tth__card {
    background: rgb(30 21 46 / 0.82);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      var(--shadow-lift);
  }

  :global([data-theme='dark']) .tth__orb {
    opacity: 0.25;
  }

  :global([data-theme='dark']) .tth {
    --tth-mark: #ff8fb0;
    --tth-mark-bg: rgb(255 143 176 / 0.1);
    --tth-current-bg: #efe7fb;
    --tth-current-ink: var(--aubergine-900);
  }
</style>
