---
/**
 * Light ⇄ dark switch. Two shapes, one behaviour:
 *   variant="bar"  — icon button in the header bar (both icons are in the DOM,
 *                    CSS shows the one that describes the action: moon in light
 *                    mode, sun in dark mode)
 *   variant="row"  — labelled row in the mobile menu sheet
 * The choice itself lives in src/scripts/theme.ts (persisted, no flash).
 */
import Icon from './Icon.astro';
import { ui } from '@/locales';
import type { Lang } from '@/i18n';

interface Props {
  lang?: Lang;
  variant?: 'bar' | 'row';
}
const { lang = 'en', variant = 'bar' } = Astro.props;
const t = ui(lang).theme;
const labels = { 'data-label-dark': t.toDark, 'data-label-light': t.toLight };
---

{
  variant === 'bar' ? (
    <button class="theme-toggle" type="button" data-theme-toggle {...labels} aria-label={t.toDark}>
      <Icon name="moon" weight="bold" class="theme-toggle__icon theme-toggle__icon--moon" />
      <Icon name="sun" weight="bold" class="theme-toggle__icon theme-toggle__icon--sun" />
    </button>
  ) : (
    <button class="theme-row" type="button" data-theme-toggle {...labels} aria-label={t.toDark}>
      <span class="theme-row__icons">
        <Icon name="moon" weight="bold" class="theme-toggle__icon theme-toggle__icon--moon" />
        <Icon name="sun" weight="bold" class="theme-toggle__icon theme-toggle__icon--sun" />
      </span>
      <span data-theme-toggle-label>{t.toDark}</span>
    </button>
  )
}

<style>
  /* Header bar variant — same round glass chip as the menu button beside it */
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border: 0;
    border-radius: 50%;
    color: var(--ink);
    background: rgb(255 255 255 / 0.7);
    box-shadow: inset 0 0 0 1px rgb(46 29 70 / 0.1);
    position: relative;
  }

  /* invisible hit-area extension (see .menu-btn): 40 px on phones still offers ≥ 44 px */
  .theme-toggle::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: inherit;
  }

  .theme-toggle :global(svg) {
    width: 19px;
    height: 19px;
    grid-area: 1 / 1;
  }

  /* the icon describes the action: moon = go dark, sun = go light
     (the icons are rendered by <Icon>, so the class is reached through :global) */
  :global(:root[data-theme='dark'] .theme-toggle__icon--moon),
  :global(:root:not([data-theme='dark']) .theme-toggle__icon--sun) {
    display: none;
  }

  /* Mobile sheet variant — a full-width row, no guessing from an icon alone */
  .theme-row {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 48px;
    padding: 10px 14px;
    border: 0;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.7);
    box-shadow: inset 0 0 0 1px rgb(46 29 70 / 0.06);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 540;
    text-align: start;
  }

  .theme-row__icons {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    flex: none;
  }

  .theme-row :global(svg) {
    width: 20px;
    height: 20px;
    grid-area: 1 / 1;
  }

  @media (max-width: 859px) {
    .theme-toggle {
      width: 40px;
      height: 40px;
    }
  }
  /* ---------- Dark theme ---------- */
  :global([data-theme='dark']) .theme-toggle {
    background: rgb(255 255 255 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.13);
  }

  :global([data-theme='dark']) .theme-row {
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }
</style>
