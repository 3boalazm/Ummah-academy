---
import PostCover from './PostCover.astro';
import Icon from './Icon.astro';
import { LOCALE, type Lang } from '@/i18n';
import { ui } from '@/locales';
interface Props {
  href: string;
  title: string;
  description: string;
  category: string;
  date: Date;
  track: string;
  /** language of the article itself */
  lang: Lang;
  /** language of the page the card sits on */
  pageLang?: Lang;
  lead?: boolean;
}
const { href, title, description, category, date, track, lang, pageLang = lang, lead = false } = Astro.props;
const foreign = lang !== pageLang;
const fmt = (d: Date) => d.toLocaleDateString(LOCALE[lang].intl, { day: 'numeric', month: 'short', year: 'numeric' });
// Pastel tone per topic (the same pairing as the home page programmes); the lead card is the deep anchor.
const TONE: Record<string, string> = { quran: 'lavender', arabic: 'sky', kids: 'rose', islamic: 'mauve', general: 'mist' };
const tone = lead ? ['tone--deep', 'tone--grad-plum'] : [`tone--${TONE[track] ?? 'lavender'}`];
---

<li data-track={track} class:list={['blog-card', { 'blog-card--lead': lead }]}>
  <a class:list={['blog-card__link', 'tone', ...tone]} href={href} hreflang={foreign ? lang : undefined}>
    <span class="blog-card__media">
      <PostCover title={title} track={track} small={!lead} />
      <span class="status blog-card__cat" lang={foreign ? lang : undefined} dir={foreign ? LOCALE[lang].dir : undefined}>{category}</span>
    </span>
    <span class="blog-card__body" lang={foreign ? lang : undefined} dir={foreign ? LOCALE[lang].dir : undefined}>
      <span class="blog-card__meta">
        <Icon name="calendar-blank" weight="bold" />
        <time datetime={date.toISOString()}>{fmt(date)}</time>
      </span>
      <span class="blog-card__title">{title}</span>
      <span class="blog-card__excerpt">{description}</span>
      <span class="blog-card__foot">
        <span class="blog-card__more">{ui(lang).readArticle}</span>
        <span class:list={['arrow-btn', { 'arrow-btn--dark': !lead }]} style={lead ? undefined : '--arrow-size:42px'} aria-hidden="true">
          <Icon name="arrow-up-right" weight="bold" />
        </span>
      </span>
    </span>
  </a>
</li>

<style>
  .blog-card {
    min-width: 0;
  }

  .blog-card[hidden] {
    display: none;
  }

  /* Reference card: a tinted surface, the rounded photo inset with a status pill on it, and a footer row
     that ends on a round arrow button. */
  .blog-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 10px;
    border-radius: 30px;
    text-decoration: none;
    overflow: hidden;
    box-shadow: none;
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .blog-card__link:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-soft);
  }

  .blog-card__link:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .blog-card__media {
    position: relative;
    display: block;
  }

  /* the topic sits on the photo as a white pill (white in every theme, so it always reads over the artwork) */
  .blog-card__cat {
    position: absolute;
    inset-block-start: 12px;
    inset-inline-start: 12px;
    max-width: calc(100% - 24px);
    white-space: normal;
    color: var(--brand-ink);
    background: #fff;
    border: 0;
    box-shadow: 0 6px 16px -10px rgb(44 28 68 / 0.5);
  }

  .blog-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 12px 8px;
    flex: 1;
    min-width: 0;
  }

  .blog-card__meta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.84rem;
    color: var(--ink-3);
  }

  .blog-card__meta :global(svg) {
    width: 14px;
    height: 14px;
  }

  .blog-card__title {
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--ink);
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  :global([dir='rtl']) .blog-card__title,
  .blog-card__body:lang(ar) .blog-card__title {
    letter-spacing: 0;
    line-height: 1.55;
    font-weight: 700;
  }

  .blog-card__excerpt {
    color: var(--ink-2);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 8px;
  }

  .blog-card__more {
    padding-bottom: 0.2em;
    border-bottom: 1.5px solid currentColor;
    font-weight: 620;
    font-size: 0.92rem;
    color: var(--ink);
  }

  /* an English card on the Arabic page keeps its arrow pointing the English way */
  .blog-card__body[dir='ltr'] .arrow-btn :global(svg) {
    transform: none;
  }

  /* Featured first article: a large bento card on the deep plum gradient. */
  .blog-card--lead .blog-card__link {
    padding: 12px;
  }

  .blog-card--lead .blog-card__body {
    gap: 14px;
    padding: 22px 16px 10px;
  }

  .blog-card--lead .blog-card__title {
    font-weight: 460;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.2rem);
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .blog-card--lead .blog-card__excerpt {
    font-size: 1.02rem;
    -webkit-line-clamp: 4;
  }

  @media (min-width: 1000px) {
    .blog-card--lead {
      grid-column: span 2;
    }

    .blog-card--lead .blog-card__link {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 8px;
      align-items: stretch;
      min-height: 420px;
    }

    .blog-card--lead .blog-card__body {
      padding: 26px 22px 14px;
    }

    /* the cover's 16:10 ratio must not drive the column width when stretched */
    .blog-card--lead .blog-card__media :global(.cover) {
      aspect-ratio: auto;
      height: 100%;
      min-height: 320px;
    }
  }

  :global([dir='rtl']) .blog-card--lead .blog-card__title {
    letter-spacing: 0;
    line-height: 1.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card__link,
    .blog-card__link:hover {
      transition: none;
      transform: none;
    }
  }
</style>
