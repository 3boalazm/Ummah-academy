---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Track } from '@/data/tracks';
import Money from './Money.astro';
import { lp, type Lang } from '@/i18n';
import { ui } from '@/locales';
interface Props {
  track: Track;
  lang?: Lang;
  delay?: number;
  compact?: boolean;
  /** brand tone surface; defaults to the programme's own tint */
  tone?: string;
}
const TRACK_TONE: Record<string, string> = { quran: 'lavender', arabic: 'sky', kids: 'rose', islamic: 'mauve' };
const { track, lang = 'en', delay = 0, compact = false, tone = TRACK_TONE[track.id] ?? 'lavender' } = Astro.props;
const t = ui(lang);
const href = lp(lang, track.href);
const DEEP = ['ink', 'plum', 'magenta', 'navy', 'slate', 'grad-plum', 'grad-night'];
const deep = DEEP.includes(tone);
---

<article class:list={['track-card', 'tone', `tone--${tone}`, { 'tone--deep': deep, 'track-card--compact': compact }]} data-reveal style={`--reveal-delay:${delay}s`}>
  <div class="track-card__media">
    <Image src={track.image} alt="" widths={[360, 560, 720]} sizes="(min-width: 1100px) 290px, (min-width: 700px) 45vw, 92vw" />
    <p class="status track-card__badge track-card__sub"><Icon name={track.icon} /> {track.subtitle}</p>
  </div>
  <div class="track-card__body">
    <h3><a href={href}>{track.title}</a></h3>
    <p class="track-card__intro">{track.intro}</p>
    {
      !compact && (
        <ul class="checklist">
          {track.points.slice(0, 3).map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      )
    }
    <div class="track-card__foot">
      <span class="track-card__price"><small>{t.from}</small> <Money usd={track.from} lang={lang} /><small>{t.perMonth}</small></span>
      <span class:list={['arrow-btn', 'track-card__go', { 'arrow-btn--dark': !deep }]} aria-hidden="true"><Icon name="arrow-up-right" weight="bold" /></span>
    </div>
  </div>
</article>

<style>
  .track-card.tone {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 0;
    border-radius: 30px;
    box-shadow: none;
    transition: transform 0.4s var(--ease-out);
  }

  .track-card.tone:hover {
    transform: translateY(-3px);
  }

  .track-card.tone--dusk {
    --ink-2: var(--ink);
    --ink-3: var(--ink);
  }

  .track-card__media.track-card__media {
    position: relative;
    aspect-ratio: 16 / 11;
    margin: 10px 10px 0;
    border-radius: 24px;
    overflow: hidden;
  }

  .track-card--compact .track-card__media {
    aspect-ratio: 16 / 10;
  }

  .track-card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .track-card:hover .track-card__media :global(img) {
    transform: scale(1.05);
  }

  /* status chip on the photo */
  .track-card__badge {
    position: absolute;
    inset-inline-start: 12px;
    inset-block-start: 12px;
    max-width: calc(100% - 24px);
    white-space: normal;
    font-size: 0.78rem;
    color: var(--brand-ink);
    background: rgb(255 255 255 / 0.88);
    border-color: rgb(255 255 255 / 0.9);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .track-card__badge::before {
    display: none;
  }

  .track-card__badge :global(svg) {
    flex: none;
    width: 15px;
    height: 15px;
    color: var(--brand-plum);
  }

  .track-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 22px;
    flex: 1;
  }

  .track-card h3 {
    font-size: 1.45rem;
    overflow-wrap: anywhere;
  }

  .track-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .track-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .track-card h3 a:focus-visible {
    outline: none;
  }

  .track-card:has(h3 a:focus-visible) {
    outline: 2.5px solid var(--focus);
    outline-offset: 3px;
  }

  .track-card__intro {
    color: var(--ink-2);
    font-size: 0.96rem;
  }

  .track-card .checklist {
    font-size: 0.92rem;
    gap: 8px;
  }

  .track-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line-strong);
  }

  .tone--deep .track-card__foot {
    border-top-color: rgb(255 255 255 / 0.2);
  }

  .track-card__price {
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  :global([dir='rtl']) .track-card__price {
    letter-spacing: 0;
  }

  .track-card__price small {
    font-size: 0.8rem;
    font-weight: 450;
    color: var(--ink-3);
    letter-spacing: 0;
  }

  /* the round arrow button (outranks the older square radius) */
  .track-card__go.arrow-btn {
    --arrow-size: 44px;
    border-radius: 50%;
  }
</style>
