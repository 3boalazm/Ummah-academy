---
/**
 * The Ummah Academy logo: the calligraphic "أمة" inside an arch. It is the whole identity —
 * no wordmark is typeset beside it, so the same component works in the header bar, the mobile
 * sheet and the footer.
 *
 * Two colourways ship as SVG (src/assets/brand): `logo-ink.svg` (#281547) for light surfaces and
 * `logo-white.svg` for dark ones. `tone="ink"` follows the theme (ink in light, white in dark);
 * `tone="light"` is always white, for surfaces that are always dark (the night footer).
 */
import inkLogo from '@/assets/brand/logo-ink.svg';
import whiteLogo from '@/assets/brand/logo-white.svg';

interface Props {
  tone?: 'ink' | 'light';
  size?: 'md' | 'lg';
  /** Accessible name. Omit when the logo sits inside a link that already has a label. */
  label?: string;
  class?: string;
}
const { tone = 'ink', size = 'md', label, class: className } = Astro.props;
// the two colourways share one artboard ratio, so one width/height pair serves both
const { width, height } = inkLogo;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<span class:list={['logo', `logo--${tone}`, `logo--${size}`, className]} {...a11y}>
  {tone === 'ink' && <img class="logo__img logo__img--ink" src={inkLogo.src} width={width} height={height} alt="" decoding="async" />}
  <img class="logo__img logo__img--white" src={whiteLogo.src} width={width} height={height} alt="" decoding="async" />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    --logo-h: 44px;
  }

  .logo--lg {
    --logo-h: 76px;
  }

  .logo__img {
    display: block;
    height: var(--logo-h);
    width: auto;
  }

  /* ink on light surfaces, white on dark ones */
  .logo--ink .logo__img--white {
    display: none;
  }

  :global([data-theme='dark']) .logo--ink .logo__img--ink {
    display: none;
  }

  :global([data-theme='dark']) .logo--ink .logo__img--white {
    display: block;
  }

  @media (max-width: 859px) {
    .logo {
      --logo-h: 40px;
    }

    .logo--lg {
      --logo-h: 68px;
    }
  }
</style>
