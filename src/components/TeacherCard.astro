---
import Icon from './Icon.astro';
import type { Teacher } from '@/data/people';
import { trialLink } from '@/data/site';
interface Props {
  teacher: Teacher;
  variant?: 'full' | 'compact';
  delay?: number;
}
const { teacher: t, variant = 'full', delay = 0 } = Astro.props;
---

<article class:list={['teacher', 'glass', `teacher--${variant}`]} data-reveal style={`--reveal-delay:${delay}s`}>
  <div class="teacher__portrait" aria-hidden="true">
    <span class="teacher__monogram">{t.initials}</span>
    <span class="teacher__verified"><Icon name="seal-check" weight="fill" /> Ijazah verified</span>
  </div>
  <div class="teacher__body">
    <p class="teacher__role">{t.role}</p>
    <h3>{t.name}</h3>
    <p class="teacher__spec">{t.specialty}</p>
    {variant === 'full' && <p class="teacher__bio">{t.bio}</p>}
    <div class="teacher__lists">
      <div>
        <p class="teacher__label">Best for</p>
        <ul role="list" class="cluster">
          {t.bestFor.map((b) => <li class="chip chip--accent">{b}</li>)}
        </ul>
      </div>
      <div>
        <p class="teacher__label">Credentials</p>
        <ul role="list" class="cluster">
          {t.credentials.map((c) => <li class="chip">{c}</li>)}
        </ul>
      </div>
    </div>
    <a class="btn btn--sm btn--primary" href={trialLink({ teacher: t.name })}>
      Book with {t.name.split(' ')[0]} <Icon name="arrow-right" weight="bold" class="icon-arrow" />
    </a>
  </div>
</article>

<style>
  .teacher {
    --radius: 30px;
    display: grid;
    gap: 22px;
    padding: 10px;
    align-items: stretch;
  }

  @media (min-width: 820px) {
    .teacher--full {
      grid-template-columns: 300px 1fr;
    }
  }

  .teacher__portrait {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 240px;
    border-radius: 24px 24px 22px 22px;
    overflow: hidden;
    background:
      radial-gradient(70% 60% at 30% 20%, rgb(255 255 255 / 0.9), transparent 60%),
      radial-gradient(80% 70% at 80% 90%, rgb(175 204 234 / 0.9), transparent 65%),
      radial-gradient(90% 80% at 10% 100%, rgb(241 205 220 / 0.95), transparent 70%),
      linear-gradient(160deg, #e9e2f4, #dcd4ee);
  }

  .teacher--full .teacher__portrait {
    border-radius: 150px 150px 22px 22px;
  }

  .teacher__monogram {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 5.2rem;
    line-height: 1;
    background: var(--grad-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .teacher__verified {
    position: absolute;
    bottom: 14px;
    left: 50%;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--accent-ink);
    background: rgb(255 255 255 / 0.85);
    box-shadow: 0 6px 14px -8px rgb(46 29 70 / 0.4);
  }

  .teacher__verified :global(svg) {
    width: 15px;
    height: 15px;
  }

  .teacher__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px 18px;
  }

  .teacher__role {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .teacher h3 {
    font-size: 1.7rem;
    letter-spacing: -0.03em;
  }

  .teacher__spec {
    color: var(--ink-2);
    font-weight: 520;
    margin-top: -4px;
  }

  .teacher__bio {
    color: var(--ink-2);
    max-width: 62ch;
  }

  .teacher__lists {
    display: grid;
    gap: 12px;
    margin-block: 4px 8px;
  }

  .teacher__lists ul {
    --cluster: 6px;
  }

  .teacher__label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-3);
    margin-bottom: 6px;
  }
</style>
