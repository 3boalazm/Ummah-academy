---
import Icon from './Icon.astro';
import type { Teacher } from '@/data/people';
import { trialLink } from '@/data/site';
import type { Lang } from '@/i18n';
interface Props {
  teacher: Teacher;
  variant?: 'full' | 'compact';
  lang?: Lang;
  delay?: number;
}
const { teacher: t, variant = 'full', lang = 'en', delay = 0 } = Astro.props;
const L = lang === 'ar'
  ? { verified: 'إجازة موثّقة', bestFor: 'الأنسب لـ', creds: 'المؤهلات', book: `احجز مع ${t.name.split(' ')[0]}` }
  : { verified: 'Ijazah verified', bestFor: 'Best for', creds: 'Credentials', book: `Book with ${t.name.split(' ')[0]}` };
---

<article class:list={['teacher', 'glass', `teacher--${variant}`, `teacher--${t.hue}`]} data-reveal style={`--reveal-delay:${delay}s`}>
  <div class="teacher__portrait" aria-hidden="true">
    <span class="teacher__monogram">{t.initials}</span>
    <span class="teacher__verified"><Icon name="seal-check" weight="fill" /> {L.verified}</span>
  </div>
  <div class="teacher__body">
    <p class="teacher__role">{t.role}</p>
    <h3>{t.name}</h3>
    <p class="teacher__spec">{t.specialty}</p>
    {variant === 'full' && <p class="teacher__bio">{t.bio}</p>}
    <div class="teacher__lists">
      <div>
        <p class="teacher__label">{L.bestFor}</p>
        <ul role="list" class="cluster">
          {t.bestFor.map((b) => <li class="chip chip--accent">{b}</li>)}
        </ul>
      </div>
      {
        variant === 'full' && (
          <div>
            <p class="teacher__label">{L.creds}</p>
            <ul role="list" class="cluster">
              {t.credentials.map((c) => (
                <li class="chip">{c}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
    <a class="btn btn--sm btn--primary" href={trialLink({ teacher: t.canonical }, lang)}>
      {L.book} <Icon name="arrow-right" weight="bold" class="icon-arrow" />
    </a>
  </div>
</article>

<style>
  .teacher {
    --radius: 30px;
    --tint-a: rgb(175 204 234 / 0.9);
    --tint-b: rgb(241 205 220 / 0.95);
    display: grid;
    gap: 22px;
    padding: 10px;
    align-items: stretch;
  }

  .teacher--sky {
    --tint-a: rgb(173 167 201 / 0.85);
    --tint-b: rgb(175 204 234 / 0.95);
  }

  .teacher--rose {
    --tint-a: rgb(241 205 220 / 0.95);
    --tint-b: rgb(206 179 193 / 0.9);
  }

  @media (min-width: 820px) {
    .teacher--full {
      grid-template-columns: 300px 1fr;
    }
  }

  .teacher__portrait {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 220px;
    border-radius: 24px;
    overflow: hidden;
    background:
      radial-gradient(70% 60% at 30% 20%, rgb(255 255 255 / 0.9), transparent 60%),
      radial-gradient(80% 70% at 80% 90%, var(--tint-a), transparent 65%),
      radial-gradient(90% 80% at 10% 100%, var(--tint-b), transparent 70%),
      linear-gradient(160deg, #ece6f6, #dfd8ef);
  }

  .teacher--full .teacher__portrait {
    border-radius: 150px 150px 22px 22px;
    min-height: 300px;
  }

  .teacher__monogram {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 5.2rem;
    line-height: 1;
    background: var(--grad-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .teacher__verified {
    position: absolute;
    bottom: 14px;
    left: 50%;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--accent-ink);
    background: rgb(255 255 255 / 0.85);
    box-shadow: 0 6px 14px -8px rgb(46 29 70 / 0.4);
  }

  .teacher__verified :global(svg) {
    width: 15px;
    height: 15px;
  }

  .teacher__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px 18px;
  }

  .teacher__role {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  [dir='rtl'] .teacher__role {
    letter-spacing: 0;
    font-size: 0.88rem;
  }

  .teacher h3 {
    font-size: 1.7rem;
    letter-spacing: -0.03em;
  }

  .teacher__spec {
    color: var(--ink-2);
    font-weight: 520;
    margin-top: -4px;
  }

  .teacher__bio {
    color: var(--ink-2);
    max-width: 62ch;
  }

  .teacher__lists {
    display: grid;
    gap: 12px;
    margin-block: 4px 8px;
  }

  .teacher__lists ul {
    --cluster: 6px;
  }

  .teacher__label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-3);
    margin-bottom: 6px;
  }

  .teacher .btn {
    margin-top: auto;
  }
</style>
