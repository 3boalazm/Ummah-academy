---
import Icon from './Icon.astro';
import type { Teacher } from '@/data/people';
import { trialLink } from '@/data/site';
import { lp, type Lang } from '@/i18n';
import { copy } from '@/locales';
interface Props {
  teacher: Teacher;
  variant?: 'full' | 'compact';
  lang?: Lang;
  delay?: number;
}
const { teacher: t, variant = 'full', lang = 'en', delay = 0 } = Astro.props;
const COPY = copy(lang).teacherCard;
const L = COPY.L(t);
const profile = lp(lang, `/teachers/${t.id}/`);
// Each teacher's hue picks a pastel tone for the card and a brand gradient for the monogram stage.
const TONE: Record<Teacher['hue'], string> = { violet: 'lavender', sky: 'sky', rose: 'rose' };
---

<article class:list={['teacher', 'tone', `tone--${TONE[t.hue] ?? 'lavender'}`, `teacher--${variant}`, `teacher--${t.hue}`]} data-reveal style={`--reveal-delay:${delay}s`}>
  <div class="teacher__inner">
    <div class="teacher__portrait" aria-hidden="true">
      <span class="teacher__shape teacher__shape--a"></span>
      <span class="teacher__shape teacher__shape--b"></span>
      <span class="teacher__monogram">{t.initials}</span>
      <span class="status teacher__verified"><Icon name="seal-check" weight="fill" /> {L.verified}</span>
    </div>
    <div class="teacher__body">
      <p class="teacher__role">{t.role}</p>
      <h3><a class="teacher__name" href={profile}>{t.name}</a></h3>
      <p class="teacher__spec">{t.specialty}</p>
      {variant === 'full' && <p class="teacher__bio">{t.bio}</p>}
      <div class="teacher__lists">
        <div>
          <p class="teacher__label">{L.bestFor}</p>
          <ul role="list" class="teacher__chips">
            {t.bestFor.map((b) => <li class="status">{b}</li>)}
          </ul>
        </div>
        {
          variant === 'full' && (
            <div>
              <p class="teacher__label">{L.creds}</p>
              <ul role="list" class="teacher__chips">
                {t.credentials.map((c) => (
                  <li class="status status--ghost">{c}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
      <div class="teacher__actions">
        <a class="btn btn--sm btn--primary" href={trialLink({ teacher: t.canonical }, lang)}>
          {L.book} <Icon name="arrow-right" weight="bold" class="icon-arrow" />
        </a>
        <a class="teacher__profile" href={profile} aria-label={`${L.profile}: ${t.name}`}>
          <span>{L.profile}</span>
          <span class="arrow-btn arrow-btn--dark" aria-hidden="true"><Icon name="arrow-up-right" weight="bold" /></span>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  /* Profile card (reference: course / profile cards): a pastel tone card holding a brand-gradient
     stage with the teacher's initials, then the copy with status-pill chips and a round arrow button. */
  .teacher {
    --stage: var(--grad-dusk);
    container-type: inline-size;
    border-radius: 30px;
    padding: 10px;
    height: 100%;
  }

  .teacher--sky {
    --stage: var(--grad-dawn);
  }

  .teacher--rose {
    --stage: var(--grad-rose);
  }

  :global([data-theme='dark']) .teacher--rose {
    --stage: linear-gradient(135deg, var(--tint-mauve) 0%, var(--tint-rose) 100%);
  }

  .teacher__inner {
    display: grid;
    gap: 18px;
    height: 100%;
    grid-template-rows: auto 1fr;
  }

  /* compact cards sit side by side with the stage once the card is wide enough */
  @container (min-width: 520px) {
    .teacher--compact .teacher__inner {
      grid-template-columns: 190px 1fr;
      grid-template-rows: none;
    }
  }

  .teacher__portrait {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    place-items: center;
    min-height: 230px;
    border-radius: 24px;
    background: var(--stage);
  }

  .teacher--full .teacher__portrait {
    min-height: 270px;
  }

  /* abstract shapes, as on the reference cards (soft, plain — no texture) */
  .teacher__shape {
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.32);
  }

  .teacher__shape--a {
    width: 62%;
    aspect-ratio: 1;
    inset-block-start: -24%;
    inset-inline-end: -16%;
  }

  .teacher__shape--b {
    width: 48%;
    height: 28%;
    inset-block-end: 8%;
    inset-inline-start: -14%;
    rotate: -28deg;
  }

  :global([data-theme='dark']) .teacher__shape {
    background: rgb(255 255 255 / 0.06);
  }

  .teacher__monogram {
    font-family: inherit;
    font-style: normal;
    font-size: clamp(4.6rem, 3.6rem + 4vw, 6.4rem);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--brand-ink);
  }

  :global([data-theme='dark']) .teacher__monogram {
    color: var(--ink);
  }

  .teacher--compact .teacher__monogram {
    font-size: clamp(3.8rem, 3rem + 3vw, 5rem);
  }

  .teacher__verified {
    position: absolute;
    inset-block-end: 14px;
    inset-inline-start: 14px;
    max-width: calc(100% - 28px);
    font-size: 0.78rem;
  }

  .teacher__verified::before {
    display: none;
  }

  .teacher__verified :global(svg) {
    flex: none;
    width: 15px;
    height: 15px;
    color: var(--tone-dot);
  }

  .teacher__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    min-width: 0;
    padding: 4px 12px 14px;
  }

  .teacher__role {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .teacher h3 {
    font-size: clamp(1.45rem, 1.2rem + 0.8vw, 1.8rem);
    font-weight: 520;
    letter-spacing: -0.03em;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  :global([dir='rtl']) .teacher h3 {
    letter-spacing: 0;
    line-height: 1.4;
  }

  .teacher__spec {
    margin-top: -4px;
    font-weight: 560;
    color: var(--tone-dot);
  }

  .teacher__bio {
    color: var(--ink-2);
    max-width: 62ch;
  }

  .teacher__lists {
    display: grid;
    gap: 12px;
    margin-block: 4px 8px;
  }

  .teacher__label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-3);
    margin-bottom: 6px;
  }

  .teacher__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .teacher__chips .status {
    font-size: 0.8rem;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .teacher__chips .status--ghost {
    border-color: color-mix(in srgb, var(--tone-dot) 32%, transparent);
  }

  .teacher__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 14px;
    width: 100%;
    margin-top: auto;
  }

  .teacher__profile {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 620;
    font-size: 0.92rem;
    color: var(--ink);
    text-decoration: none;
  }

  .teacher__profile .arrow-btn {
    --arrow-size: 40px;
  }

  .teacher__name {
    color: inherit;
    text-decoration: none;
  }

  .teacher__name:hover {
    color: var(--tone-dot);
  }

  .teacher__name:focus-visible {
    outline-offset: 4px;
  }
</style>
