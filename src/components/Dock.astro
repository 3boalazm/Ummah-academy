---
/**
 * The floating stack on the bottom inline-start edge (bottom-left in LTR, bottom-right in RTL):
 *
 *   [ language ]   ← always there
 *   [ currency ]   ← always there
 *   [ install  ]   ← always there too, until the app is installed (then it disappears)
 *
 * The stack is a plain column anchored to the bottom, so the moment the install button goes away
 * the other two simply drop to the corner. They never overlap: they are stacked, and the open
 * install card (and the language / currency popovers) rise above the whole stack.
 * While the visitor scrolls down to read it tucks off the edge, and comes back on scroll up.
 * Phones: it rides above the sticky action bar while that bar is showing.
 */
import LangMenu from './LangMenu.astro';
import CurrencyMenu from './CurrencyMenu.astro';
import InstallPrompt from './InstallPrompt.astro';
import type { Lang, LangTarget } from '@/i18n';

interface Props {
  lang: Lang;
  targets: LangTarget[];
}
const { lang, targets } = Astro.props;
---

<div class="dock" data-dock>
  <LangMenu lang={lang} targets={targets} variant="dock" />
  <CurrencyMenu lang={lang} variant="dock" />
  <InstallPrompt lang={lang} variant="pill" />
</div>

<style>
  .dock {
    position: fixed;
    inset-block-end: calc(14px + env(safe-area-inset-bottom));
    inset-inline-start: calc(14px + env(safe-area-inset-left));
    z-index: 30; /* under the sticky CTA (40), the language hint (45) and the header (50) */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    transition:
      inset-block-end 0.4s var(--ease-out),
      translate 0.35s var(--ease-out),
      opacity 0.25s;
  }

  /* Reading downwards: the stack sits where lines begin and covered the start of text on laptop
     widths, so it tucks off the edge and comes back on scroll up / at the top (see the script). */
  .dock.is-tucked {
    translate: calc(-100% - 24px) 0;
    opacity: 0;
    pointer-events: none;
  }

  :global([dir='rtl']) .dock.is-tucked {
    translate: calc(100% + 24px) 0;
  }

  /* Phones: the sticky action bar owns the bottom edge once it slides in — stack above it. */
  @media (max-width: 859px) {
    :global(body:has(.sticky-cta.is-visible)) .dock {
      inset-block-end: calc(84px + env(safe-area-inset-bottom));
    }
  }

  /* The consent banner (only with GTM configured) is full width at the bottom: clear it. */
  :global(.consent:not([hidden])) ~ .dock.dock {
    inset-block-end: calc(170px + env(safe-area-inset-bottom));
  }

  @media (prefers-reduced-motion: reduce) {
    .dock {
      transition: none;
    }
  }
</style>

<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) {
    const TOP = 160; // always shown near the top of the page
    const STEP = 6; // ignore scroll jitter smaller than this
    let lastY = window.scrollY;
    // Never tuck while one of its menus is open or it holds keyboard focus.
    const busy = () => dock.matches(':focus-within') || !!dock.querySelector('details[open], [aria-expanded="true"]');
    // Scroll fires at most once per frame and this only toggles a class, so no rAF throttle is needed.
    const update = () => {
      const y = window.scrollY;
      if (y < TOP || busy()) dock.classList.remove('is-tucked');
      else if (y > lastY + STEP) dock.classList.add('is-tucked');
      else if (y < lastY - STEP) dock.classList.remove('is-tucked');
      if (Math.abs(y - lastY) > STEP || y < TOP) lastY = y;
    };
    window.addEventListener('scroll', update, { passive: true });
    dock.addEventListener('focusin', () => dock.classList.remove('is-tucked'));
  }
</script>
