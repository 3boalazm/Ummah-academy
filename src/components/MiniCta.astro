---
import Icon from './Icon.astro';
interface Props {
  title: string;
  text: string;
  label?: string;
  href?: string;
}
const { title, text, label = 'Book your free trial', href = '/contact/#book' } = Astro.props;
---

<section class="section section--tight">
  <div class="container">
    <div class="glass mini-cta" data-reveal>
      <div>
        <h2 set:html={title} />
        <p>{text}</p>
        <slot />
      </div>
      <a class="btn btn--lg btn--primary" href={href}>{label} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
    </div>
  </div>
</section>

<style>
  .mini-cta {
    --radius: var(--r-xl);
    display: grid;
    gap: 20px;
    align-items: center;
    padding: clamp(24px, 4vw, 48px);
    background:
      radial-gradient(80% 120% at 100% 0%, rgb(175 204 234 / 0.55), transparent 60%),
      radial-gradient(70% 120% at 0% 100%, rgb(241 205 220 / 0.6), transparent 60%),
      var(--glass-fill);
  }

  @media (min-width: 860px) {
    .mini-cta {
      grid-template-columns: 1fr auto;
    }
  }

  .mini-cta h2 {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem);
    margin-bottom: 8px;
  }

  .mini-cta p {
    color: var(--ink-2);
  }

  .mini-cta :global(a:not(.btn)) {
    color: var(--accent-ink);
    font-weight: 560;
  }
</style>
