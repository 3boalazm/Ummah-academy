---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, portalLinks, waLink } from '@/data/site';
import { TRACKS } from '@/data/tracks';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const courseRoutes = ['/courses/', ...TRACKS.map((t) => t.href)];
const coursesActive = courseRoutes.some((r) => path.startsWith(r));
---

<header class="site-header" data-header>
  <div class="site-header__bar glass">
    <a class="site-header__brand" href="/" aria-label="Ummah Academy — home">
      <Logo />
    </a>

    <nav class="nav hide-mobile" aria-label="Primary">
      <ul role="list" class="nav__list">
        {
          NAV.primary.map((item) =>
            'mega' in item && item.mega ? (
              <li class="nav__item nav__item--mega" data-mega>
                <button
                  class:list={['nav__link', { 'is-active': coursesActive }]}
                  type="button"
                  aria-expanded="false"
                  aria-controls="mega-courses"
                  data-mega-toggle
                >
                  {item.label}
                  <Icon name="caret-down" weight="bold" class="nav__caret" />
                </button>
                <div class="mega" id="mega-courses">
                  <div class="mega__panel glass glass--strong">
                    <div class="mega__grid">
                      {TRACKS.map((t) => (
                        <a class="mega__track" href={t.href}>
                          <span class="mega__thumb">
                            <Image src={t.image} alt="" width={112} height={112} loading="lazy" />
                          </span>
                          <span class="mega__text">
                            <span class="mega__title">{t.title}</span>
                            <span class="mega__sub">{t.subtitle}</span>
                            <span class="mega__from">From ${t.from}/mo</span>
                          </span>
                        </a>
                      ))}
                    </div>
                    <div class="mega__aside">
                      <p class="mega__aside-kicker">Not sure where to start?</p>
                      <p class="mega__aside-title">Take the free 5-minute placement test</p>
                      <a class="btn btn--sm btn--primary" href="/placement-test/">
                        Find my level
                        <Icon name="arrow-right" weight="bold" class="icon-arrow" />
                      </a>
                      <a class="mega__all" href="/courses/">
                        Compare all courses <Icon name="arrow-right" weight="bold" />
                      </a>
                    </div>
                  </div>
                </div>
              </li>
            ) : (
              <li class="nav__item">
                <a
                  class:list={['nav__link', { 'is-active': isActive(item.href) }]}
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--sm btn--glass hide-mobile" href={portalLinks.login}>Sign in</a>
      <a class="btn btn--sm btn--primary" href="/contact/#book">
        <span class="hide-mobile">Book free trial</span><span class="hide-desktop">Free trial</span>
      </a>
      <button class="menu-btn hide-desktop" type="button" aria-label="Open menu" aria-haspopup="dialog" data-menu-open>
        <Icon name="list" weight="bold" />
      </button>
    </div>
  </div>

  <dialog class="mobile-menu" aria-label="Menu" data-menu>
    <div class="mobile-menu__sheet glass glass--strong">
      <div class="mobile-menu__top">
        <Logo />
        <button class="menu-btn" type="button" aria-label="Close menu" data-menu-close>
          <Icon name="x" weight="bold" />
        </button>
      </div>
      <p class="mobile-menu__label">Courses</p>
      <ul role="list" class="mobile-menu__tracks">
        {
          TRACKS.map((t) => (
            <li>
              <a href={t.href}>
                <Image src={t.image} alt="" width={88} height={88} loading="lazy" />
                <span>
                  <strong>{t.title}</strong>
                  <small>From ${t.from}/mo</small>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <ul role="list" class="mobile-menu__links">
        <li><a href="/courses/">All courses</a></li>
        <li><a href="/placement-test/">Placement test</a></li>
        {NAV.primary.filter((i) => !('mega' in i)).map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
      <div class="mobile-menu__cta">
        <a class="btn btn--primary btn--block" href="/contact/#book">Book 2 free sessions</a>
        <a class="btn btn--glass btn--block" href={waLink()} target="_blank" rel="noopener">
          <Icon name="whatsapp-logo" weight="fill" class="icon-wa" /> Chat on WhatsApp
        </a>
        <a class="mobile-menu__signin" href={portalLinks.login}>Family Portal sign in</a>
      </div>
    </div>
  </dialog>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 12px 0 auto;
    z-index: 50;
    pointer-events: none;
  }

  .site-header__bar {
    --radius: var(--r-pill);
    pointer-events: auto;
    width: min(100% - 2 * clamp(10px, 2.4vw, 32px), 1280px);
    margin-inline: auto;
    height: 64px;
    padding: 0 10px 0 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    transition:
      box-shadow 0.4s var(--ease-out),
      background 0.4s;
  }

  :global([data-scrolled]) .site-header__bar {
    background: linear-gradient(155deg, rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.74));
    box-shadow: var(--shadow-lift);
  }

  .site-header__brand {
    text-decoration: none;
    display: inline-flex;
    border-radius: 12px;
  }

  .nav {
    margin-inline: auto;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 42px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--ink-2);
    font-size: 0.95rem;
    font-weight: 520;
    text-decoration: none;
    transition:
      background 0.25s,
      color 0.25s;
  }

  .nav__link:hover,
  .nav__item--mega[data-open] .nav__link {
    color: var(--ink);
    background: rgb(46 29 70 / 0.06);
  }

  .nav__link.is-active {
    color: var(--ink);
    background: rgb(255 255 255 / 0.8);
    box-shadow: inset 0 0 0 1px rgb(46 29 70 / 0.08);
  }

  .nav__link :global(.nav__caret) {
    width: 12px;
    height: 12px;
    transition: transform 0.3s var(--ease-out);
  }

  .nav__item--mega[data-open] :global(.nav__caret) {
    transform: rotate(180deg);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-inline-start: auto;
  }

  @media (min-width: 860px) {
    .site-header__actions {
      margin-inline-start: 0;
    }
  }

  .menu-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    color: var(--ink);
    background: rgb(255 255 255 / 0.7);
    box-shadow: inset 0 0 0 1px rgb(46 29 70 / 0.1);
  }

  .menu-btn :global(svg) {
    width: 20px;
    height: 20px;
  }

  @media (min-width: 860px) {
    .site-header__actions .menu-btn {
      display: none;
    }
  }

  /* Mega menu */
  .mega {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    width: min(880px, 92vw);
    translate: -38% 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px) scale(0.985);
    transform-origin: top center;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.35s var(--ease-out),
      visibility 0.3s;
  }

  .mega::before {
    content: '';
    position: absolute;
    inset: -16px 0 auto;
    height: 16px;
  }

  .nav__item--mega[data-open] .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  @media (hover: hover) {
    .nav__item--mega:hover .mega {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }

  .mega__panel {
    --radius: 30px;
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 10px;
    padding: 10px;
  }

  .mega__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .mega__track {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px;
    border-radius: 20px;
    text-decoration: none;
    transition: background 0.25s;
  }

  .mega__track:hover {
    background: rgb(255 255 255 / 0.8);
  }

  .mega__thumb {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgb(46 29 70 / 0.06);
  }

  .mega__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mega__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .mega__title {
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .mega__sub {
    font-size: 0.8rem;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mega__from {
    font-size: 0.78rem;
    color: var(--accent-ink);
    font-weight: 560;
  }

  .mega__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 20px;
    border-radius: 22px;
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(175 204 234 / 0.6), transparent 60%),
      radial-gradient(100% 80% at 0% 100%, rgb(241 205 220 / 0.7), transparent 60%),
      rgb(255 255 255 / 0.6);
  }

  .mega__aside-kicker {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .mega__aside-title {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 6px;
  }

  .mega__all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    font-size: 0.88rem;
    font-weight: 560;
    color: var(--ink-2);
    text-decoration: none;
  }

  .mega__all :global(svg) {
    width: 14px;
    height: 14px;
  }

  .mega__all:hover {
    color: var(--ink);
  }

  /* Mobile menu */
  .mobile-menu {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 10px;
    border: 0;
    background: transparent;
    color: var(--ink);
  }

  .mobile-menu::backdrop {
    background: rgb(30 21 48 / 0.28);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .mobile-menu[open] .mobile-menu__sheet {
    animation: sheet-in 0.45s var(--ease-out);
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(-12px) scale(0.98);
    }
  }

  .mobile-menu__sheet {
    --radius: 30px;
    min-height: 100%;
    padding: 14px 16px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow-y: auto;
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 2px 6px 6px;
  }

  .mobile-menu__label {
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-inline: 6px;
  }

  .mobile-menu__tracks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .mobile-menu__tracks a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.7);
    box-shadow: inset 0 0 0 1px rgb(46 29 70 / 0.06);
    text-decoration: none;
  }

  .mobile-menu__tracks :global(img) {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    object-fit: cover;
  }

  .mobile-menu__tracks strong {
    display: block;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .mobile-menu__tracks small {
    font-size: 0.76rem;
    color: var(--ink-3);
  }

  .mobile-menu__links {
    display: grid;
    margin-top: 4px;
  }

  .mobile-menu__links a {
    display: block;
    padding: 13px 8px;
    font-size: 1.12rem;
    font-weight: 540;
    letter-spacing: -0.015em;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu__cta {
    display: grid;
    gap: 10px;
    margin-top: auto;
    padding-top: 10px;
  }

  .mobile-menu__signin {
    text-align: center;
    font-size: 0.92rem;
    color: var(--ink-2);
    padding: 6px;
  }

  @media (max-width: 859px) {
    .site-header__bar {
      height: 60px;
      padding: 0 8px 0 14px;
    }
  }
</style>
