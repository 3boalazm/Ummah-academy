---
import Icon from './Icon.astro';
import { LEARNING_PATH } from '@/data/learning-path';
import { lp, type Lang } from '@/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const C = LEARNING_PATH[lang];
const TONES = ['lavender', 'sky', 'mauve', 'rose'];
---
<section class="section section--tight learning-path" aria-labelledby="learning-path-title">
  <div class="container">
    <div class="learning-path__head" data-reveal>
      <span class="eyebrow">{C.eyebrow}</span>
      <h2 id="learning-path-title">{C.title}</h2>
      <p class="lead">{C.intro}</p>
    </div>
    <ol class="learning-path__steps">
      {C.steps.map(([number, title, description], i) => (
        <li class:list={['learning-path__step', 'num-card', 'tone', `tone--${TONES[i % TONES.length]}`]} data-reveal style={`--reveal-delay:${i * .07}s`}>
          <span class="learning-path__dot" aria-hidden="true"></span>
          <span class="learning-path__number num-card__num" aria-hidden="true">{number}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </li>
      ))}
    </ol>
    <div class="cluster learning-path__actions" data-reveal>
      <a class="btn btn--glass" href={lp(lang, '/placement-test/')}><Icon name="compass" /> {C.level}</a>
      <a class="btn btn--primary" href={lp(lang, '/contact/') + '#book'}>{C.book} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
    </div>
  </div>
</section>
<style>
  .learning-path__head { max-width: 760px; display: grid; gap: 14px; margin-block-end: clamp(28px, 4vw, 44px); }
  .learning-path__head .eyebrow { justify-self: start; }
  .learning-path__head h2 { font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem); line-height: 1.06; overflow-wrap: anywhere; }
  :global([dir='rtl']) .learning-path__head h2 { line-height: 1.4; }

  /* numbered cards on a dotted path (as on the home page) */
  .learning-path__steps { position: relative; list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .learning-path__steps > .learning-path__step { position: relative; min-width: 0; min-height: 230px; padding: clamp(22px, 3vw, 32px); border: 0; border-radius: 28px; background: var(--tone-bg); box-shadow: none; }
  .learning-path__number { margin-block-end: 18px; color: var(--brand-plum); }
  :global([data-theme='dark']) .learning-path__number { color: var(--accent); }
  .learning-path__step h3 { font-size: var(--fs-h3); overflow-wrap: anywhere; }
  .learning-path__step p { color: var(--ink-2); }
  .learning-path__dot { position: absolute; inset-block-start: 24px; inset-inline-end: 24px; width: 12px; height: 12px; border-radius: 50%; background: var(--tone-dot); box-shadow: 0 0 0 5px color-mix(in srgb, var(--tone-dot) 18%, transparent); }
  @media (min-width: 761px) {
    .learning-path__steps::before { content: ''; position: absolute; inset-block-start: 29px; inset-inline: 40px; border-top: 2px dotted color-mix(in srgb, var(--accent) 45%, transparent); pointer-events: none; }
    .learning-path__steps > .learning-path__step { z-index: 0; }
  }
  .learning-path__actions { margin-block-start: 28px; }
  @media (max-width: 760px) {
    .learning-path__steps { grid-template-columns: 1fr; gap: 12px; }
    .learning-path__steps > .learning-path__step { min-height: 0; padding: 22px; }
    .learning-path__number { margin-block-end: 12px; }
  }
</style>
