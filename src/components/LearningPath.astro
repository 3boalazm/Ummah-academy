---
import Icon from './Icon.astro';
import { LEARNING_PATH } from '@/data/learning-path';
import { lp, type Lang } from '@/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const C = LEARNING_PATH[lang];
---
<section class="section section--tight learning-path" aria-labelledby="learning-path-title">
  <div class="container">
    <div class="learning-path__head" data-reveal>
      <span class="eyebrow">{C.eyebrow}</span>
      <h2 id="learning-path-title">{C.title}</h2>
      <p class="lead">{C.intro}</p>
    </div>
    <ol class="learning-path__steps">
      {C.steps.map(([number, title, description], i) => (
        <li class="glass learning-path__step" data-reveal style={`--reveal-delay:${i * .07}s`}>
          <span class="learning-path__number" aria-hidden="true">{number}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </li>
      ))}
    </ol>
    <div class="cluster learning-path__actions" data-reveal>
      <a class="btn btn--glass" href={lp(lang, '/placement-test/')}><Icon name="compass" /> {C.level}</a>
      <a class="btn btn--primary" href={lp(lang, '/contact/') + '#book'}>{C.book} <Icon name="arrow-right" weight="bold" class="icon-arrow" /></a>
    </div>
  </div>
</section>
<style>
  .learning-path__head { max-width: 760px; display: grid; gap: 14px; margin-block-end: 32px; }
  .learning-path__head .eyebrow { justify-self: start; }
  .learning-path__steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; counter-reset: none; }
  .learning-path__step { position: relative; padding: clamp(22px, 3vw, 36px); min-width: 0; --radius: var(--r-lg); }
  .learning-path__number { display: inline-grid; place-items: center; min-width: 48px; height: 48px; padding-inline: 8px; border-radius: var(--r-sm); background: var(--grad-dawn); border: 1px solid var(--line-strong); color: var(--accent-ink); font-weight: 700; margin-block-end: 24px; }
  .learning-path__step h3 { font-size: var(--fs-h3); margin-block-end: 10px; }
  .learning-path__step p { color: var(--ink-2); }
  .learning-path__actions { margin-block-start: 28px; }
  @media (max-width: 760px) { .learning-path__steps { grid-template-columns: 1fr; gap: 12px; } .learning-path__step { padding: 20px; } .learning-path__number { margin-block-end: 12px; } }
</style>
